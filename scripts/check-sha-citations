#!/usr/bin/env python3
"""Report abbreviated SHA citations that do not resolve to a commit.

    scripts/check-sha-citations PATH...

Scans each file (a directory is walked for *.md files) for hex tokens of 7 to
40 characters that contain at least one digit and at least one letter a-f,
and resolves each against the local object database with
`git cat-file --batch-check`. Every token that is not a commit is printed:

    <path>:<line>: <token> <tree|blob|tag|missing|ambiguous>

This gathers facts and makes no judgment: it exits 0 whatever it reports,
and non-zero only on a usage or git error. It does not see an all-digit or
all-letter SHA, and "missing" can mean the object was never fetched here,
so fetch before reading a "missing" row as a bad citation.
"""

import os
import re
import subprocess
import sys

TOKEN = re.compile(r"(?<![0-9A-Za-z_])[0-9a-f]{7,40}(?![0-9A-Za-z_])")


def candidates(text):
    for lineno, line in enumerate(text.splitlines(), 1):
        for m in TOKEN.finditer(line):
            tok = m.group(0)
            if re.search(r"[0-9]", tok) and re.search(r"[a-f]", tok):
                yield lineno, tok


def files(paths):
    for p in paths:
        if os.path.isdir(p):
            for root, _, names in os.walk(p):
                for n in sorted(names):
                    if n.endswith(".md"):
                        yield os.path.join(root, n)
        else:
            yield p


def resolve(tokens):
    """Map each token to its object type, 'missing' or 'ambiguous'."""
    if not tokens:
        return {}
    out = subprocess.run(
        ["git", "cat-file", "--batch-check=%(objecttype)"],
        input="".join(t + "\n" for t in tokens),
        capture_output=True, text=True, check=True,
    ).stdout.splitlines()
    kinds = {}
    for tok, line in zip(tokens, out):
        if line.endswith(" missing"):
            kinds[tok] = "missing"
        elif line.endswith(" ambiguous"):
            kinds[tok] = "ambiguous"
        else:
            kinds[tok] = line.strip()
    return kinds


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    hits = []
    for path in files(argv):
        with open(path, encoding="utf-8", errors="replace") as fh:
            hits.extend((path, n, t) for n, t in candidates(fh.read()))
    kinds = resolve(sorted({t for _, _, t in hits}))
    for path, n, tok in hits:
        if kinds[tok] != "commit":
            print(f"{path}:{n}: {tok} {kinds[tok]}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, subprocess.CalledProcessError) as err:
        print(f"check-sha-citations: {err}", file=sys.stderr)
        sys.exit(2)
