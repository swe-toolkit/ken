#!/usr/bin/env bash
# build-runtime-support-archive: build ken-runtime-support's staticlib on
# purpose and print the archive path Cargo reports writing. The native
# packager reads that path from KEN_RUNTIME_SUPPORT_STATICLIB, so no
# native build depends on Cargo leaving a dependency's staticlib beside a
# test binary (RT-NATIVE-RUNTIME-STATICLIB-EXPLICIT-BUILD). Extra arguments,
# such as --profile test --locked, are passed to cargo build.
set -euo pipefail
cargo build -p ken-runtime-support --lib --message-format=json-render-diagnostics "$@" \
  | python3 -c '
import json, sys
paths = []
for line in sys.stdin:
    message = json.loads(line)
    if message.get("reason") != "compiler-artifact":
        continue
    if message["target"]["name"] != "ken_runtime_support":
        continue
    paths += [name for name in message["filenames"] if name.endswith(".a")]
if len(paths) != 1:
    sys.exit(f"build-runtime-support-archive: expected one ken_runtime_support .a, Cargo reported {paths}")
print(paths[0])
'
