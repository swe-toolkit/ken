program capabilities FS AFull
proc main (input : ProcessInput) (_caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  match input {
    MkProcessInput arguments _environment _cwd |-> match arguments {
      Nil |-> ITree.Ret (Coproduct (FSOp AFull) AmbientOp)
        (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
        ExitCode ExitCode.Success;
      Cons _argv0 _rest |-> ITree.Ret (Coproduct (FSOp AFull) AmbientOp)
        (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
        ExitCode (ExitCode.Failure 7)
    }
  }
