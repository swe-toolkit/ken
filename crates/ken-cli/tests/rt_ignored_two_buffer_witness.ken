program capabilities FS AFull
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Buffer (BufferHandle)
import Capability.System.Resource (ResourceBodyOk, ResourceBodyResult, ResourceBracketResult, withBuffer)
proc buffer_body (buffer : BufferHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS] =
  host_pure AFull (ResourceBodyResult Unit Unit)
    (ResourceBodyOk Unit Unit MkUnit)

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
        (withBuffer AFull Unit Unit (1 : Int) buffer_body)
        (\first. host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
          (withBuffer AFull Unit Unit (1 : Int) buffer_body)
          (\second. host_pure AFull ExitCode ExitCode.Success))
  }
