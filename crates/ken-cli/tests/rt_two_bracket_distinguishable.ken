program capabilities FS AFull
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Buffer (BufferHandle)
import Capability.System.Resource (ResourceBodyErr, ResourceBodyOk, ResourceBodyResult, ResourceBracketBodyAndReleaseError, ResourceBracketBodyError, ResourceBracketOk, ResourceBracketReleaseError, ResourceBracketResult, withBuffer)
proc err_body (buffer : BufferHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS] =
  host_pure AFull (ResourceBodyResult Unit Unit)
    (ResourceBodyErr Unit Unit MkUnit)

proc ok_body (buffer : BufferHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS] =
  host_pure AFull (ResourceBodyResult Unit Unit)
    (ResourceBodyOk Unit Unit MkUnit)

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
        (withBuffer AFull Unit Unit (1 : Int) err_body)
        (\first. host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
          (withBuffer AFull Unit Unit (2 : Int) ok_body)
          (\second. match first {
            Err first_allocation_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
            Ok first_bracket |-> match first_bracket {
              ResourceBracketOk first_value |-> match second {
                Err second_allocation_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
                Ok second_bracket |-> match second_bracket {
                  ResourceBracketOk second_value |-> host_pure AFull ExitCode (ExitCode.Failure 99);
                  ResourceBracketBodyError second_error |-> host_pure AFull ExitCode (ExitCode.Failure 12);
                  ResourceBracketReleaseError second_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
                  ResourceBracketBodyAndReleaseError second_body_error second_release_error |-> host_pure AFull ExitCode (ExitCode.Failure 99)
                }
              };
              ResourceBracketBodyError first_error |-> match second {
                Err second_allocation_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
                Ok second_bracket |-> match second_bracket {
                  ResourceBracketOk second_value |-> host_pure AFull ExitCode (ExitCode.Failure 21);
                  ResourceBracketBodyError second_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
                  ResourceBracketReleaseError second_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
                  ResourceBracketBodyAndReleaseError second_body_error second_release_error |-> host_pure AFull ExitCode (ExitCode.Failure 99)
                }
              };
              ResourceBracketReleaseError first_error |-> host_pure AFull ExitCode (ExitCode.Failure 99);
              ResourceBracketBodyAndReleaseError first_body_error first_release_error |-> host_pure AFull ExitCode (ExitCode.Failure 99)
            }
          }))
  }
