program capabilities FS AFull
fn done (_u : Unit) : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)
fn fin (outcome : Result ResourceError (ResourceBracketResult Unit Unit)) : HostIO AFull ExitCode =
  match outcome { Ok (ResourceBracketOk _) |-> host_pure AFull ExitCode ExitCode.Success; Ok _ |-> host_pure AFull ExitCode (ExitCode.Failure 92); Err _ |-> host_pure AFull ExitCode (ExitCode.Failure 91) }
proc main (_input : ProcessInput) (_caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS, Console] =
  host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
    (withBuffer AFull Unit Unit (2 : Int) (\_b.
      host_bind AFull Unit (ResourceBodyResult Unit Unit) (host_console AFull Unit (print_line "x"))
        (\_u. host_bind AFull Unit (ResourceBodyResult Unit Unit) (host_console AFull Unit (print_line "y"))
          (\_v. done MkUnit))))
    (\outcome. fin outcome)
