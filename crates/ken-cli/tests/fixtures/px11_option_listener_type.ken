program capabilities FS AFull, Net Unix, RootExecution Allow

import Capability.Net.Stream (SocketAddress, socket_unix_path, with_socket_listener)

import Capability.Net.Option (NoDelay, set_stream_option)

import Capability.Process.Exit (host_bind, host_pure)

import Capability.System.Resource
  (ResourceBodyResult, ResourceBodyOk, ResourceBodyErr, ResourceBracketResult, ResourceBracketOk)

-- Ill-typed on purpose: set_stream_option takes a SocketStream, and a
-- listener is a SocketListener. Elaboration must refuse this program.
proc listener_body
      (listener : Resource ResourceKind.SocketListener)
    : HostIO AFull (ResourceBodyResult Unit Unit)
    visits [Net] =
  host_bind
    AFull
    (Result ResourceError Unit)
    (ResourceBodyResult Unit Unit)
    (set_stream_option AFull listener NoDelay True)
    (λset.
      match set {
        Ok _ ↦ host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit);
        Err _ ↦ host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit)
      })

fn last_argument (arguments : List Bytes) : Option Bytes =
  match arguments {
    Nil ↦ None Bytes;
    Cons first rest ↦
      match last_argument rest {
        None ↦ Some Bytes first;
        Some last ↦ Some Bytes last
      }
  }

proc main
      (input : ProcessInput) (caps : ProgramCaps AFull)
    : HostIO AFull ExitCode
    visits [Net] =
  match input {
    MkProcessInput arguments _ _ ↦
      match last_argument arguments {
        None ↦ host_pure AFull ExitCode (ExitCode.Failure 74);
        Some path ↦
          match socket_unix_path path {
            Err _ ↦ host_pure AFull ExitCode (ExitCode.Failure 75);
            Ok address ↦
              match caps {
                ProgramCaps.MkProgramCaps cap ↦
                  host_bind
                    AFull
                    (Result ResourceError (ResourceBracketResult Unit Unit))
                    ExitCode
                    (with_socket_listener AFull Unit Unit cap address listener_body)
                    (λoutcome. match outcome {
                      Ok (ResourceBracketOk _) ↦ host_pure AFull ExitCode ExitCode.Success;
                      Ok _ ↦ host_pure AFull ExitCode (ExitCode.Failure 81);
                      Err _ ↦ host_pure AFull ExitCode (ExitCode.Failure 86)
                    })
              }
          }
      }
  }
