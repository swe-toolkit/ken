      (Result ResourceError Bytes) (ResourceBodyResult Unit Unit)
      (mapBytes AFull mapping (MkMappingWindow (6 : Int) (4 : Int)))
      (\read. expect_invalid_bounds read)
  }

proc read_then_out_of_range_body (mapping : MappingHandle)
