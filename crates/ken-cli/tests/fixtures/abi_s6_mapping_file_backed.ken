program capabilities FS AFull
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Mapping (FileBacked, MappingHandle, MkMappingWindow, mapBytes)
import Capability.System.Resource (ResourceBodyErr, ResourceBodyOk, ResourceBodyResult, ResourceBracketBodyAndReleaseError, ResourceBracketBodyError, ResourceBracketOk, ResourceBracketReleaseError, ResourceBracketResult, withMapping, withResource)

const body_ok_io : HostIO AFull (ResourceBodyResult UInt8 Unit) =
  host_pure AFull (ResourceBodyResult UInt8 Unit)
    (ResourceBodyOk UInt8 Unit MkUnit)

fn body_err_io (code : UInt8) : HostIO AFull (ResourceBodyResult UInt8 Unit) =
  host_pure AFull (ResourceBodyResult UInt8 Unit)
    (ResourceBodyErr UInt8 Unit code)

fn after_read (outcome : Result ResourceError Bytes)
  : HostIO AFull (ResourceBodyResult UInt8 Unit) =
  match outcome {
    Err _ |-> body_err_io 81;
    Ok _ |-> body_ok_io
  }

proc mapping_body (mapping : MappingHandle)
  : HostIO AFull (ResourceBodyResult UInt8 Unit) visits [FS] =
  host_bind AFull (Result ResourceError Bytes) (ResourceBodyResult UInt8 Unit)
    (mapBytes AFull mapping (MkMappingWindow (2 : Int) (4 : Int)))
    (\outcome. after_read outcome)

fn after_mapping
  (outcome : Result ResourceError (ResourceBracketResult UInt8 Unit))
  : HostIO AFull (ResourceBodyResult UInt8 Unit) =
  match outcome {
    Err _ |-> body_err_io 91;
    Ok bracket |-> match bracket {
      ResourceBracketOk _ |-> body_err_io 60;
      ResourceBracketBodyError code |-> body_err_io code;
      ResourceBracketReleaseError _ |-> body_err_io 93;
      ResourceBracketBodyAndReleaseError _ _ |-> body_err_io 94
    }
  }

proc file_body (file : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult UInt8 Unit) visits [FS] =
  host_bind AFull (Result ResourceError (ResourceBracketResult UInt8 Unit))
    (ResourceBodyResult UInt8 Unit)
    (withMapping AFull UInt8 Unit (FileBacked file (8 : Int)) MappingProt.ReadOnly mapping_body)
    (\outcome. after_mapping outcome)

fn finish (outcome : Result FileError (ResourceBracketResult UInt8 Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Err _ |-> host_pure AFull ExitCode (ExitCode.Failure 71);
    Ok bracket |-> match bracket {
      ResourceBracketOk _ |-> host_pure AFull ExitCode ExitCode.Success;
      ResourceBracketBodyError code |-> host_pure AFull ExitCode (ExitCode.Failure code);
      ResourceBracketReleaseError _ |-> host_pure AFull ExitCode (ExitCode.Failure 73);
      ResourceBracketBodyAndReleaseError _ _ |-> host_pure AFull ExitCode (ExitCode.Failure 74)
    }
  }

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result FileError (ResourceBracketResult UInt8 Unit)) ExitCode
        (withResource AFull UInt8 Unit cap (bytes_encode "mapped.bin")
          ResourceOpenMode.ResourceRead file_body)
        (\outcome. finish outcome)
  }
