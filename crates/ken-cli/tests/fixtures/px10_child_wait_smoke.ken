program capabilities FS AFull, Process
import Capability.Process.Child (spawn_plan, wait_child, withChild)
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Resource (ResourceBodyErr, ResourceBodyOk, ResourceBodyResult, ResourceBracketOk, ResourceBracketResult)

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [Process] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
        (withChild AFull Unit Unit cap
          (spawn_plan (bytes_encode "/bin/true")
            (Cons Bytes (bytes_encode "caller-zero") (Nil Bytes)))
          (\child. host_bind AFull (Result ResourceError ChildExit) (ResourceBodyResult Unit Unit)
            (wait_child AFull child)
            (\waited. match waited {
              Ok _ |-> host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit);
              Err _ |-> host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit)
            })))
        (\outcome. match outcome {
          Ok (ResourceBracketOk _) |-> host_pure AFull ExitCode ExitCode.Success;
          Ok _ |-> host_pure AFull ExitCode (ExitCode.Failure 71);
          Err _ |-> host_pure AFull ExitCode (ExitCode.Failure 72)
        })
  }
