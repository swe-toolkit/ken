program capabilities FS AFull, Process
import Capability.Process.Child (ChildPipe, read_pipe, spawn_plan, take_stdout, wait_child, withChild, with_environment, with_stdout)
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Buffer (BufferHandle, MkBufferWindow)
import Capability.System.IO (spanBytes)
import Capability.System.Resource (ResourceBodyErr, ResourceBodyOk, ResourceBodyResult, ResourceBracketOk, ResourceBracketResult, withBuffer)

proc drain_pipe
      (fuel : Nat) (pipe : Resource ResourceKind.PipeRead) (buffer : BufferHandle)
    : HostIO AFull (Result ResourceError Unit)
    visits [FS, Process] =
  match fuel {
    Zero ↦
      host_pure AFull (Result ResourceError Unit)
        (Err ResourceError Unit ResourceError.InvalidBounds);
    Suc rest ↦
      host_bind AFull (Result ResourceError ReadProgress)
        (Result ResourceError Unit)
        (read_pipe AFull pipe buffer (MkBufferWindow (0 : Int) (256 : Int)))
        (λread_result.
          match read_result {
            Err error ↦
              host_pure AFull (Result ResourceError Unit)
                (Err ResourceError Unit error);
            Ok ReadProgress.ReadEof ↦
              host_pure AFull (Result ResourceError Unit)
                (Ok ResourceError Unit MkUnit);
            Ok (ReadProgress.ReadSome span count) ↦
              host_bind AFull (Result ResourceError Bytes)
                (Result ResourceError Unit)
                (spanBytes AFull buffer span)
                (λfrozen.
                  match frozen {
                    Err error ↦
                      host_pure AFull (Result ResourceError Unit)
                        (Err ResourceError Unit error);
                    Ok _ ↦ drain_pipe rest pipe buffer
                  })
          })
  }

proc child_body
      (buffer : BufferHandle) (child : Resource ResourceKind.ChildProcess)
    : HostIO AFull (ResourceBodyResult Unit Unit)
    visits [FS, Process] =
  host_bind AFull (Result ResourceError (Resource ResourceKind.PipeRead))
    (ResourceBodyResult Unit Unit)
    (take_stdout AFull child)
    (λtaken.
      match taken {
        Err _ ↦
          host_pure AFull (ResourceBodyResult Unit Unit)
            (ResourceBodyErr Unit Unit MkUnit);
        Ok pipe ↦
          host_bind AFull (Result ResourceError Unit)
            (ResourceBodyResult Unit Unit)
            (drain_pipe (Suc (Suc (Suc (Suc Zero)))) pipe buffer)
            (λdrained.
              match drained {
                Err _ ↦
                  host_pure AFull (ResourceBodyResult Unit Unit)
                    (ResourceBodyErr Unit Unit MkUnit);
                Ok _ ↦
                  host_bind AFull (Result ResourceError ChildExit)
                    (ResourceBodyResult Unit Unit)
                    (wait_child AFull child)
                    (λwaited.
                      match waited {
                        Err _ ↦
                          host_pure AFull (ResourceBodyResult Unit Unit)
                            (ResourceBodyErr Unit Unit MkUnit);
                        Ok _ ↦
                          host_pure AFull (ResourceBodyResult Unit Unit)
                            (ResourceBodyOk Unit Unit MkUnit)
                      })
              })
      })

proc buffer_body
      (cap : Cap AFull) (buffer : BufferHandle)
    : HostIO AFull (ResourceBodyResult Unit Unit)
    visits [FS, Process] =
  host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit))
    (ResourceBodyResult Unit Unit)
    (withChild
      AFull
      Unit
      Unit
      cap
      (with_stdout
        (with_environment
          (with_environment
            (spawn_plan
              (bytes_encode "PX10_CHILD_PROBE_PATH")
              (Cons
                Bytes
                (bytes_encode "caller-zero")
                (Cons
                  Bytes
                  (bytes_encode "argv-env")
                  (Cons Bytes (bytes_encode "payload") (Nil Bytes)))))
            (Cons
              (Prod Bytes Bytes)
              (MkProd Bytes Bytes (bytes_encode "PX10_REPLACED") (bytes_encode "old"))
              (Nil (Prod Bytes Bytes))))
          (Cons
            (Prod Bytes Bytes)
            (MkProd Bytes Bytes (bytes_encode "PX10_SELECTED") (bytes_encode "chosen"))
            (Nil (Prod Bytes Bytes))))
        ChildPipe)
      (child_body buffer))
    (λoutcome.
      match outcome {
        Ok (ResourceBracketOk _) ↦
          host_pure AFull (ResourceBodyResult Unit Unit)
            (ResourceBodyOk Unit Unit MkUnit);
        Ok _ ↦
          host_pure AFull (ResourceBodyResult Unit Unit)
            (ResourceBodyErr Unit Unit MkUnit);
        Err _ ↦
          host_pure AFull (ResourceBodyResult Unit Unit)
            (ResourceBodyErr Unit Unit MkUnit)
      })

proc main
      (_input : ProcessInput) (caps : ProgramCaps AFull)
    : HostIO AFull ExitCode
    visits [FS, Process] =
  match caps {
    ProgramCaps.MkProgramCaps cap ↦
      host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit))
        ExitCode
        (withBuffer AFull Unit Unit (256 : Int) (buffer_body cap))
        (λoutcome.
          match outcome {
            Ok (ResourceBracketOk _) ↦ host_pure AFull ExitCode ExitCode.Success;
            Ok _ ↦ host_pure AFull ExitCode (ExitCode.Failure 73);
            Err _ ↦ host_pure AFull ExitCode (ExitCode.Failure 74)
          })
  }
