program capabilities FS APartial
import Capability.Console.Text (read)
import Capability.Process.Exit (host_bind, host_console, host_pure)
proc main (_input : ProcessInput) (_caps : ProgramCaps APartial)
  : HostIO APartial ExitCode visits [Console] =
  host_bind APartial (Result IOError ReadResult) ExitCode
    (host_console APartial (Result IOError ReadResult) (read ConsoleStream.Stdin 1))
    (\r. match r {
      Ok _ |-> host_pure APartial ExitCode (ExitCode.Failure 41) ;
      Err _ |-> host_pure APartial ExitCode (ExitCode.Failure 42)
    })
