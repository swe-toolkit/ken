program capabilities FS AFull
import Capability.Console.Text (write)
import Capability.Filesystem.Authority (file_metadata)
import Capability.Process.Exit (host_bind, host_console, host_fs, host_pure)
import Capability.System.Resource (ResourceBodyErr, ResourceBodyOk, ResourceBodyResult, ResourceBracketBodyAndReleaseError, ResourceBracketBodyError, ResourceBracketOk, ResourceBracketReleaseError, ResourceBracketResult, withResource)
const body_ok : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

const body_err : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit)

proc resource_body (cap : Cap AFull) (_file : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS, Console] =
  host_bind AFull (Result FileError FileMetadata) (ResourceBodyResult Unit Unit)
    (host_fs AFull (Result FileError FileMetadata)
      (file_metadata AFull cap (bytes_encode "switch.bin")))
    (\metadata. host_bind AFull (Result IOError Unit) (ResourceBodyResult Unit Unit)
      (match metadata {
        Err _ |-> host_console AFull (Result IOError Unit)
          (write ConsoleStream.Stdout (bytes_encode "label-left"));
        Ok _ |-> host_console AFull (Result IOError Unit)
          (write ConsoleStream.Stdout (bytes_encode "label-right"))
      })
      (\written. match written {
        Err _ |-> body_err;
        Ok _ |-> body_ok
      }))

fn finish (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Err _ |-> host_pure AFull ExitCode (ExitCode.Failure 41);
    Ok bracket |-> match bracket {
      ResourceBracketOk _ |-> host_pure AFull ExitCode ExitCode.Success;
      ResourceBracketBodyError _ |-> host_pure AFull ExitCode (ExitCode.Failure 42);
      ResourceBracketReleaseError _ |-> host_pure AFull ExitCode (ExitCode.Failure 43);
      ResourceBracketBodyAndReleaseError _ _ |-> host_pure AFull ExitCode (ExitCode.Failure 44)
    }
  }

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS, Console] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result FileError (ResourceBracketResult Unit Unit)) ExitCode
        (withResource AFull Unit Unit cap (bytes_encode "held.bin")
          ResourceOpenMode.ResourceMetadata (resource_body cap))
        (\outcome. finish outcome)
  }
