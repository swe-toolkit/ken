program capabilities FS AFull
const body_ok : HostIO AFull (ResourceBodyResult Unit Unit) =
  ITree.Ret (Coproduct (FSOp AFull) AmbientOp)
    (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
    (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

const body_err : HostIO AFull (ResourceBodyResult Unit Unit) =
  ITree.Ret (Coproduct (FSOp AFull) AmbientOp)
    (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
    (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit)

proc resource_body (cap : Cap AFull) (_file : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS, Console] =
  bind (Coproduct (FSOp AFull) AmbientOp)
    (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
    (Result FileError FileMetadata) (ResourceBodyResult Unit Unit)
    (host_fs AFull (Result FileError FileMetadata)
      (file_metadata AFull cap (bytes_encode "switch.bin")))
    (\metadata. bind (Coproduct (FSOp AFull) AmbientOp)
      (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
      (Result IOError Unit) (ResourceBodyResult Unit Unit)
      (match metadata {
        Err _ |-> host_console AFull (Result IOError Unit)
          (write ConsoleStream.Stdout (bytes_encode "label-left"));
        Ok _ |-> host_console AFull (Result IOError Unit)
          (write ConsoleStream.Stdout (bytes_encode "label-right"))
      })
      (\written. match written {
        Err _ |-> body_err;
        Ok _ |-> body_ok
      }))

fn finish (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Err _ |-> host_exit AFull (ExitCode.Failure 41);
    Ok bracket |-> match bracket {
      ResourceBracketOk _ |-> host_exit AFull ExitCode.Success;
      ResourceBracketBodyError _ |-> host_exit AFull (ExitCode.Failure 42);
      ResourceBracketReleaseError _ |-> host_exit AFull (ExitCode.Failure 43);
      ResourceBracketBodyAndReleaseError _ _ |-> host_exit AFull (ExitCode.Failure 44)
    }
  }

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS, Console] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      bind (Coproduct (FSOp AFull) AmbientOp)
        (resp_coproduct (FSOp AFull) AmbientOp (fs_resp AFull) ambient_resp)
        (Result FileError (ResourceBracketResult Unit Unit)) ExitCode
        (withResource AFull Unit Unit cap (bytes_encode "held.bin")
          ResourceMetadata (resource_body cap))
        (\outcome. finish outcome)
  }
