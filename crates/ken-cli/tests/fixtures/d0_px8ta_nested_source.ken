program capabilities FS AFull
fn leaf_body (_resource : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit)
    (ResourceBodyOk Unit Unit MkUnit)

fn body_result
  (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull (ResourceBodyResult Unit Unit) =
  match outcome {
    Ok (ResourceBracketOk unit) |->
      host_pure AFull (ResourceBodyResult Unit Unit)
        (ResourceBodyOk Unit Unit MkUnit);
    Ok bracket |->
      host_pure AFull (ResourceBodyResult Unit Unit)
        (ResourceBodyErr Unit Unit MkUnit);
    Err error |->
      host_pure AFull (ResourceBodyResult Unit Unit)
        (ResourceBodyErr Unit Unit MkUnit)
  }

proc level_one_body
  (cap : Cap AFull) (_resource : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS] =
  host_bind AFull (Result FileError (ResourceBracketResult Unit Unit))
    (ResourceBodyResult Unit Unit)
    (withResource AFull Unit Unit cap (bytes_encode "held-1.bin")
      ResourceOpenMode.ResourceMetadata leaf_body)
    (\outcome. body_result outcome)

proc level_two_body
  (cap : Cap AFull) (_resource : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS] =
  host_bind AFull (Result FileError (ResourceBracketResult Unit Unit))
    (ResourceBodyResult Unit Unit)
    (withResource AFull Unit Unit cap (bytes_encode "held-1.bin")
      ResourceOpenMode.ResourceMetadata (\resource. level_one_body cap resource))
    (\outcome. body_result outcome)

fn after_root
  (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Ok (ResourceBracketOk unit) |-> host_pure AFull ExitCode ExitCode.Success;
    Ok (ResourceBracketBodyError error) |-> host_pure AFull ExitCode (ExitCode.Failure 81);
    Ok (ResourceBracketReleaseError error) |-> host_pure AFull ExitCode (ExitCode.Failure 82);
    Ok (ResourceBracketBodyAndReleaseError body_error release_error) |->
      host_pure AFull ExitCode (ExitCode.Failure 83);
    Err error |-> host_pure AFull ExitCode (ExitCode.Failure 84)
  }

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result FileError (ResourceBracketResult Unit Unit)) ExitCode
        (withResource AFull Unit Unit cap (bytes_encode "held-0.bin")
          ResourceOpenMode.ResourceMetadata __ROOT_BODY__)
        (\outcome. after_root outcome)
  }
