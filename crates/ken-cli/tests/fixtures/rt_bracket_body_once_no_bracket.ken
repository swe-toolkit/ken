program capabilities FS AFull
proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [Console] =
  host_bind AFull Unit ExitCode (host_console AFull Unit (print_line "x"))
    (\_u. host_bind AFull Unit ExitCode (host_console AFull Unit (print_line "y"))
      (\_v. host_pure AFull ExitCode ExitCode.Success))
