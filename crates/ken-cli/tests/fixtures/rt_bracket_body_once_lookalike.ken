program capabilities FS AFull
import Capability.Console.Text (print_line)
import Capability.Process.Exit (host_bind, host_console, host_pure)
import Capability.System.Resource (ResourceBodyErr, ResourceBodyOk, ResourceBodyResult, ResourceBracketOk, ResourceBracketResult, withResource)
fn leaf_body (_resource : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

fn lk_leaf (_u : Unit) : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

fn lk_ret (br : ResourceBodyResult Unit Unit) : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) br

fn body_result
  (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull (ResourceBodyResult Unit Unit) =
  match outcome {
    Ok (ResourceBracketOk unit) |->
      host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit);
    Ok bracket |->
      host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit);
    Err error |->
      host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit)
  }

fn after_root
  (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Ok (ResourceBracketOk unit) |-> host_pure AFull ExitCode ExitCode.Success;
    Ok _ |-> host_pure AFull ExitCode (ExitCode.Failure 82);
    Err error |-> host_pure AFull ExitCode (ExitCode.Failure 84)
  }

proc lk_release (tag : String) (br : ResourceBodyResult Unit Unit)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [Console] =
  host_bind AFull Unit (ResourceBodyResult Unit Unit)
    (host_console AFull Unit (print_line tag))
    (\_u. lk_ret br)

proc lk_after_open (tag : String)
  (body : Unit -> HostIO AFull (ResourceBodyResult Unit Unit)) (u : Unit)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [Console] =
  host_bind AFull (ResourceBodyResult Unit Unit) (ResourceBodyResult Unit Unit)
    (body u) (\br. lk_release tag br)

proc lk_bracket (open_tag : String) (close_tag : String)
  (body : Unit -> HostIO AFull (ResourceBodyResult Unit Unit))
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [Console] =
  host_bind AFull Unit (ResourceBodyResult Unit Unit)
    (host_console AFull Unit (print_line open_tag))
    (\u. lk_after_open close_tag body u)

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS, Console] =
  match caps {
    ProgramCaps.MkProgramCaps cap |-> host_bind AFull (Result FileError (ResourceBracketResult Unit Unit)) ExitCode
        (withResource AFull Unit Unit cap (bytes_encode "held-0.bin") ResourceOpenMode.ResourceMetadata
          (\resource. host_bind AFull (ResourceBodyResult Unit Unit) (ResourceBodyResult Unit Unit) (lk_bracket "o1" "c1" lk_leaf) (\br. lk_ret br)))
        (\outcome. after_root outcome)
  }
