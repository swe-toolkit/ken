program capabilities FS AFull
import Capability.Console.Text (print_line)
import Capability.Process.Exit (host_bind, host_console, host_pure)
import Capability.System.Resource (ResourceBodyOk, ResourceBodyResult, ResourceBracketOk, ResourceBracketResult, withResource)
fn done (_u : Unit) : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

fn after_root (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Ok (ResourceBracketOk unit) |-> host_pure AFull ExitCode ExitCode.Success;
    Ok _ |-> host_pure AFull ExitCode (ExitCode.Failure 82);
    Err error |-> host_pure AFull ExitCode (ExitCode.Failure 84)
  }

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS, Console] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result FileError (ResourceBracketResult Unit Unit)) ExitCode
        (withResource AFull Unit Unit cap (bytes_encode "held-0.bin") ResourceOpenMode.ResourceMetadata
          (\resource.
            host_bind AFull Unit (ResourceBodyResult Unit Unit)
              (host_console AFull Unit (print_line "x"))
              (\_u. host_bind AFull Unit (ResourceBodyResult Unit Unit)
                (host_console AFull Unit (print_line "y"))
                (\_v. host_bind AFull Unit (ResourceBodyResult Unit Unit)
                  (host_console AFull Unit (print_line "z"))
                  (\_w. done MkUnit)))))
        (\outcome. after_root outcome)
  }
