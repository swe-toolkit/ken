program capabilities FS AFull
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Mapping (Anonymous, MappingHandle)
import Capability.System.Resource (ResourceBodyOk, ResourceBodyResult, ResourceBracketOk, ResourceBracketResult, withMapping)

fn body (_mapping : MappingHandle) : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

fn after_mapping (outcome : Result ResourceError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Ok (ResourceBracketOk _) |-> host_pure AFull ExitCode ExitCode.Success;
    Ok _ |-> host_pure AFull ExitCode (ExitCode.Failure 92);
    Err _ |-> host_pure AFull ExitCode (ExitCode.Failure 91)
  }

proc main (_input : ProcessInput) (_caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
    (withMapping AFull Unit Unit (Anonymous (8 : Int)) MappingProt.ReadOnly body)
    (\outcome. after_mapping outcome)
