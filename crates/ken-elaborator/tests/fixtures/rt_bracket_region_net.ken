program capabilities FS AFull, Net Unix, RootExecution Allow

import Capability.Net.Stream
  (socket_unix_path, with_socket_listener, with_socket_accept, with_socket_connection)
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Resource
  (ResourceBodyResult, ResourceBodyOk, ResourceBodyErr, ResourceBracketResult)

fn settled (_stream : Resource ResourceKind.SocketStream)
    : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit)

fn finish_accept (outcome : Result ResourceError (ResourceBracketResult Unit Unit))
    : HostIO AFull (ResourceBodyResult Unit Unit) =
  match outcome {
    Ok _ ↦ host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyOk Unit Unit MkUnit);
    Err _ ↦ host_pure AFull (ResourceBodyResult Unit Unit) (ResourceBodyErr Unit Unit MkUnit)
  }

proc accept_one (listener : Resource ResourceKind.SocketListener)
    : HostIO AFull (ResourceBodyResult Unit Unit)
    visits [Net] =
  host_bind
    AFull
    (Result ResourceError (ResourceBracketResult Unit Unit))
    (ResourceBodyResult Unit Unit)
    (with_socket_accept AFull Unit Unit listener settled)
    finish_accept

fn finish (_result : Result ResourceError (ResourceBracketResult Unit Unit))
    : HostIO AFull ExitCode = host_pure AFull ExitCode ExitCode.Success

proc main (input : ProcessInput) (caps : ProgramCaps AFull)
    : HostIO AFull ExitCode
    visits [Net] =
  match input {
    MkProcessInput args _ _ ↦
      match args {
        Nil ↦ host_pure AFull ExitCode (ExitCode.Failure 1);
        Cons path choice ↦
          match socket_unix_path path {
            Err _ ↦ host_pure AFull ExitCode (ExitCode.Failure 2);
            Ok address ↦
              match caps {
                ProgramCaps.MkProgramCaps cap ↦
                  match choice {
                    Nil ↦ host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
                      (with_socket_listener AFull Unit Unit cap address accept_one) finish;
                    Cons _ _ ↦ host_bind AFull (Result ResourceError (ResourceBracketResult Unit Unit)) ExitCode
                      (with_socket_connection AFull Unit Unit cap address settled) finish
                  }
              }
          }
      }
  }
