program capabilities FS AFull
import Capability.Process.Exit (host_bind, host_pure)
import Capability.System.Resource (ResourceBodyOk, ResourceBodyResult, ResourceBracketResult, release, withResource)

fn body_done (_second : Result ResourceError Unit)
  : HostIO AFull (ResourceBodyResult Unit Unit) =
  host_pure AFull (ResourceBodyResult Unit Unit)
    (ResourceBodyOk Unit Unit MkUnit)

proc release_twice (resource : Resource ResourceKind.FsHandle)
  : HostIO AFull (ResourceBodyResult Unit Unit) visits [FS] =
  host_bind AFull (Result ResourceError Unit) (ResourceBodyResult Unit Unit)
    (release AFull resource)
    (\first. host_bind AFull (Result ResourceError Unit) (ResourceBodyResult Unit Unit)
      (release AFull resource)
      (\second. body_done second))

fn done (outcome : Result FileError (ResourceBracketResult Unit Unit))
  : HostIO AFull ExitCode =
  match outcome {
    Ok _ |-> host_pure AFull ExitCode ExitCode.Success;
    Err _ |-> host_pure AFull ExitCode (ExitCode.Failure 75)
  }

proc main (_input : ProcessInput) (caps : ProgramCaps AFull)
  : HostIO AFull ExitCode visits [FS] =
  match caps {
    ProgramCaps.MkProgramCaps cap |->
      host_bind AFull (Result FileError (ResourceBracketResult Unit Unit)) ExitCode
        (withResource AFull Unit Unit cap (bytes_encode "held.bin")
          ResourceOpenMode.ResourceMetadata release_twice)
        (\outcome. done outcome)
  }
