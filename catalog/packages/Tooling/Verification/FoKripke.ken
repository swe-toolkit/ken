-- FO Kripke embedding slice: quoted syntax and embed (23 section 4.3, 4.5).
--
-- Ken-level mirror of `crates/ken-elaborator/src/fo_kripke.rs`'s D0 quoted
-- types and D1 `embed` (V3-FO-KEN-LEVEL-CHECKER-AUTHORING, increment 1). The
-- Rust module is reference for SHAPE only -- every definition here is
-- authored independently, never transcribed from Rust computation. Every
-- name carries a `Fok`/`fok_` prefix to keep this file's constructors and
-- functions out of the shared catalog namespace, following the `nc9_`
-- convention in `ProofErasureBoundaryChecker.ken`.
--
-- This file now includes the later `fok_check_cert` increment and its
-- fail-closed derived sort/scope validation. Still deliberately absent: any
-- FO `Proved` verdict, new kernel primitive or trusted axiom, or widening of
-- the five-constructor / three-rule slice below.

import Core.Logic.Or (Or, Inl, Inr)

-- === D0: quoted source data (23 section 4.3, slice subset) ===

-- A bound source object variable, de Bruijn (23 section 4.3 `IVar`).
data FokIVar = FokMkIVar Nat

-- Quoted intuitionistic source formula -- SLICE CONSTRUCTOR SUBSET (23
-- section 4.5: bottom, atom, or, imp, forall). Exactly five constructors,
-- mirroring `fo_kripke::IForm`. The general section 4.3 `IForm` also has
-- `top`, `and`, and `exists`; this slice's source grammar deliberately
-- carries none of the three -- not an oversight, the same omission the Rust
-- reference makes for the same reason (23 section 4.5's fragment).
data FokIForm =
    FokIBottom
  | FokIAtom FokIVar
  | FokIOr FokIForm FokIForm
  | FokIImp FokIForm FokIForm
  | FokIForall FokIForm

-- The slice's one-sort, one-predicate signature. Keeping the signature as an
-- index makes the source-side families state their common profile even though
-- this first vertical slice has exactly one profile.
data FokSignature : Type where {
  FokSliceSignature : FokSignature
}

-- The closed rigid carrier for the slice's object sort A. The carrier may be
-- empty; no inhabitant is stored or synthesized here.
data FokCarriers (sigma : FokSignature) : Type 1 where {
  FokMkCarriers : Type -> FokCarriers sigma
}

fn fok_sort_a (sigma : FokSignature) (c : FokCarriers sigma) : Type =
  match c {
    FokMkCarriers a ↦ a
  }

-- The slice's unary predicate P, proposition-valued over the selected carrier.
class FokAtomPred (a : Type) {
  pred_p : a -> Omega
}

-- An atom interpretation is indexed by the same signature and carrier value.
data FokAtomEnv (sigma : FokSignature) (c : FokCarriers sigma) : Type 1 where {
  FokMkAtomEnv : FokAtomPred (fok_sort_a sigma c) -> FokAtomEnv sigma c
}

fn fok_pred_p
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    : fok_sort_a sigma c -> Omega =
  match rho {
    FokMkAtomEnv d ↦ d.pred_p
  }

-- A bounded de Bruijn object-variable index. `FokFin Zero` has no
-- constructor, so a closed formula cannot contain a free object atom.
data FokFin : Nat -> Type where {
  FokFinZero : (n : Nat) -> FokFin (Suc n);
  FokFinSuc : (n : Nat) -> FokFin n -> FokFin (Suc n)
}

fn fok_fin_to_nat (n : Nat) (i : FokFin n) : Nat =
  match i {
    FokFinZero m ↦ Zero;
    FokFinSuc m j ↦ Suc (fok_fin_to_nat m j)
  }

-- A length-indexed environment of actual carrier values. Lookup by `FokFin`
-- is total: neither `Option` nor a default carrier value occurs in its type.
data FokObjectEnv
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    : Nat -> Type 1 where {
  FokObjectEnvNil : FokObjectEnv sigma c Zero;
  FokObjectEnvCons :
    (n : Nat)
    -> fok_sort_a sigma c
    -> FokObjectEnv sigma c n
    -> FokObjectEnv sigma c (Suc n)
}

fn fok_object_env_lookup
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (n : Nat)
    (xs : FokObjectEnv sigma c n)
    (i : FokFin n)
    : fok_sort_a sigma c =
  match i {
    FokFinZero m ↦
      match xs {
        FokObjectEnvCons k x rest ↦ x
      };
    FokFinSuc m j ↦
      match xs {
        FokObjectEnvCons k x rest ↦
          fok_object_env_lookup sigma c m rest j
      }
  }

-- The intrinsically-scoped source form `IForm Sigma n` from 23 section 4.4.
-- `n` counts enclosing object binders. Implication keeps that count unchanged;
-- forall checks its body at one additional object slot.
data FokScopedIForm (sigma : FokSignature) (n : Nat) : Type where {
  FokScopedBottom : FokScopedIForm sigma n;
  FokScopedAtom : FokFin n -> FokScopedIForm sigma n;
  FokScopedOr :
    FokScopedIForm sigma n
    -> FokScopedIForm sigma n
    -> FokScopedIForm sigma n;
  FokScopedImp :
    FokScopedIForm sigma n
    -> FokScopedIForm sigma n
    -> FokScopedIForm sigma n;
  FokScopedForall : FokScopedIForm sigma (Suc n) -> FokScopedIForm sigma n
}

-- === D0: quoted target data (23 section 4.3, slice subset) ===

-- A quoted-target variable, de Bruijn bound or a certificate-local free
-- eigenparameter (23 section 4.3 `QTerm`). The slice folds `QSort` (world
-- vs. object) into which `FokForm`/`FokRule` variant is used, never onto
-- `FokQTerm` itself -- mirroring `fo_kripke::QTerm`.
data FokQTerm = FokQBound Nat | FokQParameter Nat

-- Target classical formula -- SLICE CONSTRUCTOR SUBSET (23 section 4.5):
-- bottom, relation, and, or, imp, forall. Nine constructors, mirroring
-- `fo_kripke::Form`. `FokAnd` is needed even though the SOURCE slice above
-- has no `and`: `K(Sigma)`'s own axioms (23 section 4.2) use it in their
-- antecedents.
data FokForm =
    FokBottom
  | FokAccess FokQTerm FokQTerm
  | FokDomainA FokQTerm FokQTerm
  | FokForcingP FokQTerm FokQTerm
  | FokAnd FokForm FokForm
  | FokOr FokForm FokForm
  | FokImp FokForm FokForm
  | FokForallWorld FokForm
  | FokForallObj FokForm

-- A sequent Gamma => Delta (23 section 4.3). The general contract uses
-- canonical multisets (exchange is representation equality); the slice's
-- three rules below never weaken/contract/exchange, so an insertion-order
-- `List` loses nothing here, exactly as `fo_kripke::Sequent` uses `Vec`.
data FokSequent = FokMkSequent (List FokForm) (List FokForm)

-- Certificate rule tags -- SLICE SUBSET ONLY: init, imp-right, forall-right
-- (23 section 4.5: "the positive proof needs exactly [these] certificate
-- rules"). Three variants against the general section 4.3 `Rule`'s ~20: this
-- slice deliberately carries none of and-left/and-right, or-left, imp-left,
-- forall-left, exists-left/exists-right, top-right, bottom-left, cut,
-- weaken, contract, exchange, or any classical double-negation/excluded-
-- middle rule the general calculus offers. The route's own positive-proof
-- fragment closes every certificate this slice can produce with exactly
-- these three.
data FokRule =
    FokInit Nat Nat
  | FokImpRight Nat
  | FokForallRight Nat FokQTerm

-- A certificate proof-tree node (23 section 4.3 `Cert`).
data FokCert = FokMkCert FokSequent FokRule (List FokCert)

-- === D1: embed -- the exact classical Kripke theory (23 section 4.2) ===

-- Total lookup into a `Nat`-valued `List` at a `Nat` index, defaulting to
-- `Zero` out of range. `fok_w_forces` below only ever indexes `object_env`
-- at a position a well-scoped `FokIForm` guarantees present (one entry per
-- enclosing `FokIForall`, in binder order) -- the default arm is
-- unreachable on any input this increment's controls exercise, exactly as
-- `fo_kripke::w_forces`'s `object_env[*k]` relies on the same invariant
-- without asserting it.
fn fok_nth_nat_default (xs : List Nat) (i : Nat) : Nat =
  match xs {
    Nil ↦ Zero;
    Cons x rest ↦
      match i {
        Zero ↦ x;
        Suc j ↦ fok_nth_nat_default rest j
      }
  }

-- `object_env.iter().map(|i| i + 1)` -- `fo_kripke.rs`'s own shift-on-entry
-- discipline, shared by both the `Imp` and `Forall` cases below.
fn fok_map_suc (xs : List Nat) : List Nat =
  match xs {
    Nil ↦ Nil Nat;
    Cons x rest ↦ Cons Nat (Suc x) (fok_map_suc rest)
  }

-- `K(Sigma)`'s five axioms (23 section 4.2), each its own top-level
-- definition so `fok_k_sigma`'s composition below mirrors
-- `fo_kripke::k_sigma`'s local-`let` structure exactly.

-- `forall w. Le w w`.
const fok_preorder_reflexive : FokForm =
  FokForallWorld (FokAccess (FokQBound Zero) (FokQBound Zero))

-- `forall w v u. (Le w v and Le v u) => Le w u`.
const fok_preorder_transitive : FokForm =
  FokForallWorld (FokForallWorld (FokForallWorld
    (FokImp
      (FokAnd
        (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound (Suc Zero)))
        (FokAccess (FokQBound (Suc Zero)) (FokQBound Zero)))
      (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound Zero)))))

-- `forall w v x. (Le w v and Dom_A w x) => Dom_A v x`.
const fok_domain_growth_a : FokForm =
  FokForallWorld (FokForallWorld (FokForallObj
    (FokImp
      (FokAnd
        (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound (Suc Zero)))
        (FokDomainA (FokQBound (Suc (Suc Zero))) (FokQBound Zero)))
      (FokDomainA (FokQBound (Suc Zero)) (FokQBound Zero)))))

-- `forall w x. Force_P w x => Dom_A w x` (unary P: single conjunct, no
-- `and` needed).
const fok_atom_domain_p : FokForm =
  FokForallWorld (FokForallObj
    (FokImp
      (FokForcingP (FokQBound (Suc Zero)) (FokQBound Zero))
      (FokDomainA (FokQBound (Suc Zero)) (FokQBound Zero))))

-- `forall w v x. (Le w v and Force_P w x) => Force_P v x`.
const fok_atom_persistence_p : FokForm =
  FokForallWorld (FokForallWorld (FokForallObj
    (FokImp
      (FokAnd
        (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound (Suc Zero)))
        (FokForcingP (FokQBound (Suc (Suc Zero))) (FokQBound Zero)))
      (FokForcingP (FokQBound (Suc Zero)) (FokQBound Zero)))))

-- The five axioms conjoined, matching `fo_kripke::k_sigma`'s nesting
-- exactly: `And(And(And(reflexive, transitive), domain_growth), And(atom_
-- domain, atom_persistence))`.
const fok_k_sigma : FokForm =
  FokAnd
    (FokAnd
      (FokAnd fok_preorder_reflexive fok_preorder_transitive)
      fok_domain_growth_a)
    (FokAnd fok_atom_domain_p fok_atom_persistence_p)

-- `w |= f`, the forcing translation (23 section 4.2), given the current
-- world's index and the object-variable environment (source `FokIVar`
-- index -> its current target index), both counted in the SAME unified de
-- Bruijn space `FokForm` uses for world and object binders alike -- mirrors
-- `fo_kripke::w_forces` exactly, case by case.
fn fok_w_forces (world : Nat) (object_env : List Nat) (f : FokIForm) : FokForm =
  match f {
    FokIBottom ↦ FokBottom;
    FokIAtom v ↦
      match v {
        FokMkIVar k ↦
          FokForcingP (FokQBound world) (FokQBound (fok_nth_nat_default object_env k))
      };
    FokIOr p q ↦
      FokOr (fok_w_forces world object_env p) (fok_w_forces world object_env q);
    FokIImp p q ↦
      FokForallWorld
        (FokImp
          (FokAccess (FokQBound (Suc world)) (FokQBound Zero))
          (FokImp
            (fok_w_forces Zero (fok_map_suc object_env) p)
            (fok_w_forces Zero (fok_map_suc object_env) q)));
    FokIForall p ↦
      FokForallWorld
        (FokImp
          (FokAccess (FokQBound (Suc world)) (FokQBound Zero))
          (FokForallObj
            (FokImp
              (FokDomainA (FokQBound (Suc Zero)) (FokQBound Zero))
              (fok_w_forces
                (Suc Zero)
                (Cons Nat Zero (fok_map_suc (fok_map_suc object_env)))
                p))))
  }

-- `embed(Sigma, f) := K(Sigma) => forall w : World. w |= f` (23 section
-- 4.2). `K(Sigma)` is INSIDE the target: no frame or forcing premise is
-- emitted outside `fok_embed`'s own `FokForm` -- mirrors `fo_kripke::embed`.
fn fok_embed (f : FokIForm) : FokForm =
  FokImp fok_k_sigma (FokForallWorld (fok_w_forces Zero (Nil Nat) f))

-- Source denotation under an environment whose length is the source scope.
-- The environment is returned as a function argument so each recursive call
-- remains directly beneath the constructor match that exposes its subform.
fn fok_denote_at
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    (n : Nat)
    (f : FokScopedIForm sigma n)
    : FokObjectEnv sigma c n -> Omega =
  match f {
    FokScopedBottom ↦ λxs. Bottom;
    FokScopedAtom i ↦ λxs.
      fok_pred_p sigma c rho (fok_object_env_lookup sigma c n xs i);
    FokScopedOr p q ↦ λxs.
      ‖Or
        ((fok_denote_at sigma c rho n p) xs)
        ((fok_denote_at sigma c rho n q) xs)‖;
    FokScopedImp p q ↦ λxs.
      (fok_denote_at sigma c rho n p xs)
        -> (fok_denote_at sigma c rho n q xs);
    FokScopedForall p ↦ λxs.
      (x : fok_sort_a sigma c) ->
        (fok_denote_at sigma c rho (Suc n) p)
          (FokObjectEnvCons sigma c n x xs)
  }

-- Public denotation starts from a closed source form and the unique empty
-- object environment. Every atom is therefore reached only below a forall.
fn fok_denote
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    (f : FokScopedIForm sigma Zero)
    : Omega =
  fok_denote_at sigma c rho Zero f (FokObjectEnvNil sigma c)

-- Forget only the scope evidence. Constructor order and atom identity are
-- unchanged, and the bounded index becomes the same de Bruijn `Nat`.
fn fok_erase_n
    (sigma : FokSignature)
    (n : Nat)
    (f : FokScopedIForm sigma n)
    : FokIForm =
  match f {
    FokScopedBottom ↦ FokIBottom;
    FokScopedAtom i ↦ FokIAtom (FokMkIVar (fok_fin_to_nat n i));
    FokScopedOr p q ↦
      FokIOr (fok_erase_n sigma n p) (fok_erase_n sigma n q);
    FokScopedImp p q ↦
      FokIImp (fok_erase_n sigma n p) (fok_erase_n sigma n q);
    FokScopedForall p ↦ FokIForall (fok_erase_n sigma (Suc n) p)
  }

-- The target leg uses the already-landed embedding verbatim on the forgetful
-- image; denotation above never passes through erasure.
fn fok_scoped_embed
    (sigma : FokSignature)
    (f : FokScopedIForm sigma Zero)
    : FokForm =
  fok_embed (fok_erase_n sigma Zero f)

-- === D2: check_cert -- computable (23 section 4.3) ===
--
-- Mirrors `fo_kripke::check_tree`'s GUARDED discipline exactly
-- (`evt_5fc6hsgcn9exq`, Architect ruling): the Rust reference has zero
-- `unwrap`/`expect`/`panic!`/`unreachable!` in this range, and its two bare
-- index writes are each on a `clone()` of the very `Vec` whose `.get()` at
-- the same index returned `Some` immediately above -- so it is total in
-- BEHAVIOUR, not merely `-> bool` in signature. Every lookup below returns
-- `Option` LOCALLY and every `None` maps to `False`, exactly what Rust's
-- `let Some(x) = ... else { return false }` does; the `Option` never
-- surfaces as the verdict's own shape. `Form`/`QTerm` stay untagged, while
-- the derived validation pass below rejects wrong-sort and out-of-scope
-- occurrences before this structural checker runs. The Rust boundary applies
-- the same monotonic restriction over its unchanged calculus checker.

-- `Nat` equality, structural.
fn fok_nat_eq (a : Nat) (b : Nat) : Bool =
  match a {
    Zero ↦
      match b {
        Zero ↦ True;
        Suc j ↦ False
      };
    Suc i ↦
      match b {
        Zero ↦ False;
        Suc j ↦ fok_nat_eq i j
      }
  }

-- `a < b`, structural.
fn fok_nat_lt (a : Nat) (b : Nat) : Bool =
  match a {
    Zero ↦
      match b {
        Zero ↦ False;
        Suc j ↦ True
      };
    Suc i ↦
      match b {
        Zero ↦ False;
        Suc j ↦ fok_nat_lt i j
      }
  }

-- Predecessor, `Zero` at `Zero` (never reached at any call site below: it is
-- only ever applied where `fok_nat_lt depth i` already established `i > 0`).
fn fok_nat_pred (a : Nat) : Nat =
  match a {
    Zero ↦ Zero;
    Suc i ↦ i
  }

-- Short-circuit boolean or.
fn fok_or (a : Bool) (b : Bool) : Bool =
  match a {
    True ↦ True;
    False ↦ b
  }

-- Short-circuit boolean and.
fn fok_and (a : Bool) (b : Bool) : Bool =
  match a {
    True ↦ b;
    False ↦ False
  }

-- Total lookup into a `FokForm`-valued `List` at a `Nat` index, `None` out of
-- range -- mirrors `Vec::get`, used everywhere `check_tree` writes
-- `.get(*right)`/`.get(*left)`.
fn fok_nth_form (xs : List FokForm) (i : Nat) : Option FokForm =
  match xs {
    Nil ↦ None FokForm;
    Cons x rest ↦
      match i {
        Zero ↦ Some FokForm x;
        Suc j ↦ fok_nth_form rest j
      }
  }

-- Replace the element at `i` with `v`. Out-of-range is a structural no-op
-- (returns `xs` unchanged past where it runs out) -- unreachable at every
-- call site below, each of which only calls this after a `fok_nth_form`
-- lookup at the SAME index already returned `Some`, exactly as Rust's
-- `expected_delta[*right] = ...` is only reached after `.get(*right)`
-- returned `Some` two lines above it.
fn fok_list_form_set_nth (xs : List FokForm) (i : Nat) (v : FokForm) : List FokForm =
  match xs {
    Nil ↦ Nil FokForm;
    Cons x rest ↦
      match i {
        Zero ↦ Cons FokForm v rest;
        Suc j ↦ Cons FokForm x (fok_list_form_set_nth rest j v)
      }
  }

-- Append one element at the end -- mirrors `expected_gamma.push(...)`.
fn fok_list_form_append_one (xs : List FokForm) (v : FokForm) : List FokForm =
  match xs {
    Nil ↦ Cons FokForm v (Nil FokForm);
    Cons x rest ↦ Cons FokForm x (fok_list_form_append_one rest v)
  }

-- The "exactly one child" guard (Rust's slice pattern `let [child] =
-- node.children.as_slice() else { return false }`) is inlined directly at
-- each of its two call sites below, as a `Cons child (Nil ...)` match,
-- rather than factored through a `List FokCert -> Option FokCert` helper:
-- the kernel's termination checker traces a structural decrease only through
-- a DIRECT pattern match feeding a recursive call in the same function, not
-- through an intervening non-recursive helper's return value (confirmed
-- empirically -- factoring it out reds `SCT: idempotent self-loop has no
-- strictly-decreasing parameter` on this mutual-recursion clique).

-- `FokQTerm` equality, structural -- every constructor pair named explicitly
-- (no wildcard arm), so a future `FokQTerm` variant is a compile error here
-- rather than a silent fall-through.
fn fok_qterm_eq (a : FokQTerm) (b : FokQTerm) : Bool =
  match a {
    FokQBound i ↦
      match b {
        FokQBound j ↦ fok_nat_eq i j;
        FokQParameter j ↦ False
      };
    FokQParameter i ↦
      match b {
        FokQBound j ↦ False;
        FokQParameter j ↦ fok_nat_eq i j
      }
  }

-- `FokForm` equality, structural over all nine slice constructors -- every
-- pair named explicitly, matching the `bool_expr_eq`-style precedent
-- (`Capability/Parsing/Parsing.ken.md`) rather than a wildcard arm.
fn fok_form_eq (a : FokForm) (b : FokForm) : Bool =
  match a {
    FokBottom ↦
      match b {
        FokBottom ↦ True;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokAccess a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ fok_and (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2);
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokDomainA a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ fok_and (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2);
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokForcingP a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ fok_and (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2);
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokAnd a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ fok_and (fok_form_eq a1 b1) (fok_form_eq a2 b2);
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokOr a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ fok_and (fok_form_eq a1 b1) (fok_form_eq a2 b2);
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokImp a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ fok_and (fok_form_eq a1 b1) (fok_form_eq a2 b2);
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokForallWorld a1 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ fok_form_eq a1 b1;
        FokForallObj b1 ↦ False
      };
    FokForallObj a1 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ fok_form_eq a1 b1
      }
  }

-- Element-wise `List FokForm` equality (length and every position).
fn fok_list_form_eq (xs : List FokForm) (ys : List FokForm) : Bool =
  match xs {
    Nil ↦
      match ys {
        Nil ↦ True;
        Cons y ys2 ↦ False
      };
    Cons x xs2 ↦
      match ys {
        Nil ↦ False;
        Cons y ys2 ↦
          match fok_form_eq x y {
            True ↦ fok_list_form_eq xs2 ys2;
            False ↦ False
          }
      }
  }

-- `FokSequent` equality: both sides, `gamma` then `delta`.
fn fok_sequent_eq (a : FokSequent) (b : FokSequent) : Bool =
  match a {
    FokMkSequent ga da ↦
      match b {
        FokMkSequent gb db ↦
          match fok_list_form_eq ga gb {
            True ↦ fok_list_form_eq da db;
            False ↦ False
          }
      }
  }

-- Does `target` occur anywhere in `form`?
fn fok_form_mentions_parameter (form : FokForm) (target : FokQTerm) : Bool =
  match form {
    FokBottom ↦ False;
    FokAccess a b ↦ fok_or (fok_qterm_eq a target) (fok_qterm_eq b target);
    FokDomainA a b ↦ fok_or (fok_qterm_eq a target) (fok_qterm_eq b target);
    FokForcingP a b ↦ fok_or (fok_qterm_eq a target) (fok_qterm_eq b target);
    FokAnd p q ↦ fok_or (fok_form_mentions_parameter p target) (fok_form_mentions_parameter q target);
    FokOr p q ↦ fok_or (fok_form_mentions_parameter p target) (fok_form_mentions_parameter q target);
    FokImp p q ↦ fok_or (fok_form_mentions_parameter p target) (fok_form_mentions_parameter q target);
    FokForallWorld b ↦ fok_form_mentions_parameter b target;
    FokForallObj b ↦ fok_form_mentions_parameter b target
  }

fn fok_list_form_any_mentions (xs : List FokForm) (target : FokQTerm) : Bool =
  match xs {
    Nil ↦ False;
    Cons x rest ↦
      fok_or (fok_form_mentions_parameter x target) (fok_list_form_any_mentions rest target)
  }

-- Does `target` occur anywhere in `sequent` (either side)?
fn fok_sequent_mentions_parameter (sequent : FokSequent) (target : FokQTerm) : Bool =
  match sequent {
    FokMkSequent gamma delta ↦
      fok_or (fok_list_form_any_mentions gamma target) (fok_list_form_any_mentions delta target)
  }

-- Substitute the outermost bound `QTerm` variable (index `0`, relative to
-- `depth`) with `replacement`, shrinking every strictly-higher bound index
-- by one -- the `subst0` convention, restated at `FokQTerm`.
fn fok_subst_qterm_at (q : FokQTerm) (depth : Nat) (replacement : FokQTerm) : FokQTerm =
  match q {
    FokQBound i ↦
      match fok_nat_eq i depth {
        True ↦ replacement;
        False ↦
          match fok_nat_lt depth i {
            True ↦ FokQBound (fok_nat_pred i);
            False ↦ FokQBound i
          }
      };
    FokQParameter p ↦ FokQParameter p
  }

fn fok_subst_form_at (form : FokForm) (depth : Nat) (replacement : FokQTerm) : FokForm =
  match form {
    FokBottom ↦ FokBottom;
    FokAccess a b ↦
      FokAccess (fok_subst_qterm_at a depth replacement) (fok_subst_qterm_at b depth replacement);
    FokDomainA a b ↦
      FokDomainA (fok_subst_qterm_at a depth replacement) (fok_subst_qterm_at b depth replacement);
    FokForcingP a b ↦
      FokForcingP (fok_subst_qterm_at a depth replacement) (fok_subst_qterm_at b depth replacement);
    FokAnd p q ↦
      FokAnd (fok_subst_form_at p depth replacement) (fok_subst_form_at q depth replacement);
    FokOr p q ↦
      FokOr (fok_subst_form_at p depth replacement) (fok_subst_form_at q depth replacement);
    FokImp p q ↦
      FokImp (fok_subst_form_at p depth replacement) (fok_subst_form_at q depth replacement);
    FokForallWorld b ↦ FokForallWorld (fok_subst_form_at b (Suc depth) replacement);
    FokForallObj b ↦ FokForallObj (fok_subst_form_at b (Suc depth) replacement)
  }

fn fok_subst0_form (form : FokForm) (replacement : FokQTerm) : FokForm =
  fok_subst_form_at form Zero replacement

-- Derived only while validating a complete certificate. The target syntax
-- stays untagged; positions and binders determine these two sorts.
data FokDerivedSort = FokWorldSort | FokObjectSort

data FokParameterSort = FokMkParameterSort Nat FokDerivedSort

fn fok_derived_sort_eq (a : FokDerivedSort) (b : FokDerivedSort) : Bool =
  match a {
    FokWorldSort ↦
      match b {
        FokWorldSort ↦ True;
        FokObjectSort ↦ False
      };
    FokObjectSort ↦
      match b {
        FokWorldSort ↦ False;
        FokObjectSort ↦ True
      }
  }

fn fok_nth_derived_sort (xs : List FokDerivedSort) (index : Nat) : Option FokDerivedSort =
  match xs {
    Nil ↦ None FokDerivedSort;
    Cons x rest ↦
      match index {
        Zero ↦ Some FokDerivedSort x;
        Suc previous ↦ fok_nth_derived_sort rest previous
      }
  }

fn fok_parameter_sort_prepend
      (head : FokParameterSort) (outcome : Option (List FokParameterSort))
    : Option (List FokParameterSort) =
  match outcome {
    None ↦ None (List FokParameterSort);
    Some rest ↦ Some (List FokParameterSort) (Cons FokParameterSort head rest)
  }

fn fok_constrain_parameter_sort
      (parameter : Nat) (expected : FokDerivedSort) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match constraints {
    Nil ↦
      Some
        (List FokParameterSort)
        (Cons FokParameterSort (FokMkParameterSort parameter expected) (Nil FokParameterSort));
    Cons constraint rest ↦
      match constraint {
        FokMkParameterSort existing actual ↦
          match fok_nat_eq parameter existing {
            True ↦
              match fok_derived_sort_eq expected actual {
                True ↦ Some (List FokParameterSort) constraints;
                False ↦ None (List FokParameterSort)
              };
            False ↦
              fok_parameter_sort_prepend
                constraint
                (fok_constrain_parameter_sort parameter expected rest)
          }
      }
  }

fn fok_validate_qterm_sort
      (term : FokQTerm)
      (expected : FokDerivedSort)
      (binders : List FokDerivedSort)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match term {
    FokQBound index ↦
      match fok_nth_derived_sort binders index {
        None ↦ None (List FokParameterSort);
        Some actual ↦
          match fok_derived_sort_eq expected actual {
            True ↦ Some (List FokParameterSort) constraints;
            False ↦ None (List FokParameterSort)
          }
      };
    FokQParameter parameter ↦ fok_constrain_parameter_sort parameter expected constraints
  }

fn fok_validate_second_qterm
      (first : Option (List FokParameterSort))
      (second : FokQTerm)
      (second_sort : FokDerivedSort)
      (binders : List FokDerivedSort)
    : Option (List FokParameterSort) =
  match first {
    None ↦ None (List FokParameterSort);
    Some constraints ↦ fok_validate_qterm_sort second second_sort binders constraints
  }

fn fok_validate_qterm_pair
      (first : FokQTerm)
      (first_sort : FokDerivedSort)
      (second : FokQTerm)
      (second_sort : FokDerivedSort)
      (binders : List FokDerivedSort)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  fok_validate_second_qterm
    (fok_validate_qterm_sort first first_sort binders constraints)
    second
    second_sort
    binders

fn fok_validate_second_form
      (first : Option (List FokParameterSort))
      (second : FokForm)
      (binders : List FokDerivedSort)
    : Option (List FokParameterSort) =
  match first {
    None ↦ None (List FokParameterSort);
    Some constraints ↦ fok_validate_form second binders constraints
  }

fn fok_validate_form_pair
      (first : FokForm)
      (second : FokForm)
      (binders : List FokDerivedSort)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  fok_validate_second_form (fok_validate_form first binders constraints) second binders

fn fok_validate_form
      (form : FokForm) (binders : List FokDerivedSort) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match form {
    FokBottom ↦ Some (List FokParameterSort) constraints;
    FokAccess first second ↦
      fok_validate_qterm_pair first FokWorldSort second FokWorldSort binders constraints;
    FokDomainA world object ↦
      fok_validate_qterm_pair world FokWorldSort object FokObjectSort binders constraints;
    FokForcingP world object ↦
      fok_validate_qterm_pair world FokWorldSort object FokObjectSort binders constraints;
    FokAnd first second ↦ fok_validate_form_pair first second binders constraints;
    FokOr first second ↦ fok_validate_form_pair first second binders constraints;
    FokImp first second ↦ fok_validate_form_pair first second binders constraints;
    FokForallWorld body ↦
      fok_validate_form body (Cons FokDerivedSort FokWorldSort binders) constraints;
    FokForallObj body ↦
      fok_validate_form body (Cons FokDerivedSort FokObjectSort binders) constraints
  }

fn fok_validate_form_list
      (forms : List FokForm) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match forms {
    Nil ↦ Some (List FokParameterSort) constraints;
    Cons form rest ↦
      match fok_validate_form form (Nil FokDerivedSort) constraints {
        None ↦ None (List FokParameterSort);
        Some next ↦ fok_validate_form_list rest next
      }
  }

fn fok_validate_sequent
      (sequent : FokSequent) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match sequent {
    FokMkSequent gamma delta ↦
      match fok_validate_form_list gamma constraints {
        None ↦ None (List FokParameterSort);
        Some next ↦ fok_validate_form_list delta next
      }
  }

fn fok_validate_forall_eigen
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match fok_nth_form delta right {
    None ↦ None (List FokParameterSort);
    Some target ↦
      match target {
        FokForallWorld body ↦
          fok_validate_qterm_sort eigen FokWorldSort (Nil FokDerivedSort) constraints;
        FokForallObj body ↦
          fok_validate_qterm_sort eigen FokObjectSort (Nil FokDerivedSort) constraints;
        FokBottom ↦ None (List FokParameterSort);
        FokAccess a b ↦ None (List FokParameterSort);
        FokDomainA a b ↦ None (List FokParameterSort);
        FokForcingP a b ↦ None (List FokParameterSort);
        FokAnd p q ↦ None (List FokParameterSort);
        FokOr p q ↦ None (List FokParameterSort);
        FokImp p q ↦ None (List FokParameterSort)
      }
  }

fn fok_validate_rule_side
      (conclusion : FokSequent) (rule : FokRule) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match rule {
    FokInit left right ↦ Some (List FokParameterSort) constraints;
    FokImpRight right ↦ Some (List FokParameterSort) constraints;
    FokForallRight right eigen ↦
      match conclusion {
        FokMkSequent gamma delta ↦ fok_validate_forall_eigen delta right eigen constraints
      }
  }

fn fok_validate_certificate_after_children
      (node_result : Option (List FokParameterSort)) (children : List FokCert)
    : Option (List FokParameterSort) =
  match node_result {
    None ↦ None (List FokParameterSort);
    Some constraints ↦ fok_validate_certificate_list children constraints
  }

fn fok_validate_certificate_list
      (certificates : List FokCert) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match certificates {
    Nil ↦ Some (List FokParameterSort) constraints;
    Cons certificate rest ↦
      match fok_validate_certificate certificate constraints {
        None ↦ None (List FokParameterSort);
        Some next ↦ fok_validate_certificate_list rest next
      }
  }

fn fok_validate_certificate
      (node : FokCert) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match node {
    FokMkCert conclusion rule children ↦
      match fok_validate_sequent conclusion constraints {
        None ↦ None (List FokParameterSort);
        Some after_conclusion ↦
          fok_validate_certificate_after_children
            (fok_validate_rule_side conclusion rule after_conclusion)
            children
      }
  }

-- The `ForallRight` guard: shared by both `FokForallWorld`/`FokForallObj`
-- targets (Rust's single `Form::ForallWorld(b) | Form::ForallObj(b) => b`
-- arm) -- freshness, then exactly-one-child, then recurse on the
-- instantiated child sequent.
fn fok_check_forall_right
      (conclusion : FokSequent) (gamma : List FokForm) (delta : List FokForm)
      (right : Nat) (eigen : FokQTerm) (body : FokForm) (children : List FokCert)
    : Bool =
  match fok_sequent_mentions_parameter conclusion eigen {
    True ↦ False;
    False ↦
      match children {
        Nil ↦ False;
        Cons child rest ↦
          match rest {
            Cons c2 rest2 ↦ False;
            Nil ↦
              fok_check_tree_structural
                (FokMkSequent gamma (fok_list_form_set_nth delta right (fok_subst0_form body eigen)))
                child
          }
      }
  }

-- Dispatch on the certificate's rule, given its (already conclusion-matched)
-- `gamma`/`delta` and `children`.
fn fok_check_rule (gamma : List FokForm) (delta : List FokForm) (rule : FokRule) (children : List FokCert) : Bool =
  match rule {
    FokInit left right ↦
      match children {
        Cons c rest ↦ False;
        Nil ↦
          match fok_nth_form gamma left {
            None ↦ False;
            Some g ↦
              match fok_nth_form delta right {
                None ↦ False;
                Some d ↦ fok_form_eq g d
              }
          }
      };
    FokImpRight right ↦
      match fok_nth_form delta right {
        None ↦ False;
        Some target ↦
          match target {
            FokBottom ↦ False;
            FokAccess a b ↦ False;
            FokDomainA a b ↦ False;
            FokForcingP a b ↦ False;
            FokAnd p q ↦ False;
            FokOr p q ↦ False;
            FokImp p q ↦
              match children {
                Nil ↦ False;
                Cons child rest ↦
                  match rest {
                    Cons c2 rest2 ↦ False;
                    Nil ↦
                      fok_check_tree_structural
                        (FokMkSequent (fok_list_form_append_one gamma p) (fok_list_form_set_nth delta right q))
                        child
                  }
              };
            FokForallWorld b ↦ False;
            FokForallObj b ↦ False
          }
      };
    FokForallRight right eigen ↦
      match fok_nth_form delta right {
        None ↦ False;
        Some target ↦
          match target {
            FokBottom ↦ False;
            FokAccess a b ↦ False;
            FokDomainA a b ↦ False;
            FokForcingP a b ↦ False;
            FokAnd p q ↦ False;
            FokOr p q ↦ False;
            FokImp p q ↦ False;
            FokForallWorld body ↦
              fok_check_forall_right (FokMkSequent gamma delta) gamma delta right eigen body children;
            FokForallObj body ↦
              fok_check_forall_right (FokMkSequent gamma delta) gamma delta right eigen body children
          }
      }
  }

fn fok_check_tree_structural (expected_conclusion : FokSequent) (node : FokCert) : Bool =
  match node {
    FokMkCert conclusion rule children ↦
      match fok_sequent_eq conclusion expected_conclusion {
        False ↦ False;
        True ↦
          match conclusion {
            FokMkSequent gamma delta ↦ fok_check_rule gamma delta rule children
          }
      }
  }

fn fok_validate_certificate_bool (node : FokCert) : Bool =
  match fok_validate_certificate node (Nil FokParameterSort) {
    None ↦ False;
    Some constraints ↦ True
  }

-- Validation is a monotonic adapter around the unchanged calculus checker.
-- One constraint environment covers the complete stored certificate tree.
fn fok_check_tree (expected_conclusion : FokSequent) (node : FokCert) : Bool =
  fok_and
    (fok_validate_certificate_bool node)
    (fok_check_tree_structural expected_conclusion node)

-- `check_cert : FokForm -> FokCert -> Bool` (23 section 4.3), restricted to
-- the slice's three rules -- an ordinary kernel-checked total function,
-- distinct from the kernel API `check` (`seed-prover.md:49-50`). Mirrors
-- `fo_kripke::check_cert`.
fn fok_check_cert (q : FokForm) (pi : FokCert) : Bool =
  fok_check_tree (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm))) pi

-- === D1a: indexed derivations (23 section 4.3) ===
--
-- The four constructors are the proof-relevant reflection of exactly the
-- branches accepted by `fok_check_rule`: Init, ImpRight, and the World/Obj
-- conclusion shapes of ForallRight. A recursive premise represents the one
-- child required by the corresponding checker branch; Init has none. The
-- lookup equalities expose the same selected principal occurrences, and both
-- ForallRight constructors carry `fok_check_forall_right`'s freshness guard.
data FokDerivation : FokSequent → Type where {
  FokDerivInit :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (left : Nat)
    → (right : Nat)
    → (g : FokForm)
    → (d : FokForm)
    → Equal (Option FokForm) (fok_nth_form gamma left) (Some FokForm g)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm d)
    → Equal Bool (fok_form_eq g d) True
    → FokDerivation (FokMkSequent gamma delta);
  FokDerivImpRight :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (right : Nat)
    → (p : FokForm)
    → (q : FokForm)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokImp p q))
    → FokDerivation
      (FokMkSequent (fok_list_form_append_one gamma p) (fok_list_form_set_nth delta right q))
    → FokDerivation (FokMkSequent gamma delta);
  FokDerivForallWorldRight :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (right : Nat)
    → (eigen : FokQTerm)
    → (body : FokForm)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokForallWorld body))
    → Equal Bool (fok_sequent_mentions_parameter (FokMkSequent gamma delta) eigen) False
    → FokDerivation
      (FokMkSequent gamma (fok_list_form_set_nth delta right (fok_subst0_form body eigen)))
    → FokDerivation (FokMkSequent gamma delta);
  FokDerivForallObjRight :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (right : Nat)
    → (eigen : FokQTerm)
    → (body : FokForm)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokForallObj body))
    → Equal Bool (fok_sequent_mentions_parameter (FokMkSequent gamma delta) eigen) False
    → FokDerivation
      (FokMkSequent gamma (fok_list_form_set_nth delta right (fok_subst0_form body eigen)))
    → FokDerivation (FokMkSequent gamma delta)
}

-- The proof-relevant rule tree lives in `Type`; its propositional reflection
-- is the truncation required by 23 section 4.3. Classical validity means
-- derivability from the empty antecedent to the singleton conclusion.
fn fok_derives (s : FokSequent) : Omega = ‖FokDerivation s‖

fn fok_classically_valid (q : FokForm) : Omega =
  fok_derives (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm)))

-- The D1 adequacy statement. Its kernel-checked proof is the following
-- increment; this proposition adds no assumption or trusted declaration.
fn fok_embedding_adequacy_statement
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    (f : FokScopedIForm sigma Zero)
    : Omega =
  fok_classically_valid (fok_scoped_embed sigma f)
    -> fok_denote sigma c rho f

-- === D2: Bool-inversion infrastructure (23 section 4.3) ===
--
-- `checker_soundness`'s proof needs to invert the Bool verdicts
-- `fok_check_rule` accepts on back into operand-level facts. Neither
-- `fok_and` nor `fok_or` is called directly by `fok_check_rule`
-- (`:572`-`:633`) -- the polarity census below traces the ACTUAL routes,
-- corrected from this section's own first draft, which claimed a direct
-- call that a full read of `fok_check_rule`'s span does not support.
--
-- `fok_and` reaches checker acceptance through the six compound arms of
-- `fok_form_eq` (`:352`, `:365`, `:378`, `:391`, `:404`, `:417`), which
-- call `fok_qterm_eq` only as a leaf where appropriate. `FokInit`'s guard
-- consumes `fok_form_eq g d` at `= True`, so `fok_and_left` and
-- `fok_and_right` below invert the `= True` case.
--
-- `fok_or` reaches the checker only through `fok_form_mentions_parameter`
-- (`:480`), `fok_list_form_any_mentions` (`:493`), and
-- `fok_sequent_mentions_parameter` (`:501`) -- the freshness chain -- whose
-- sole external consumer is `fok_check_forall_right`'s guard (`:554`):
-- `match fok_sequent_mentions_parameter conclusion eigen { True -> False;
-- False -> ... }`. On every path where the checker ACCEPTS a `ForallRight`
-- step, that `or`-built chain is `False`, not `True`. Hence
-- `fok_or_left_false`/`fok_or_right_false` below invert the `= False` case
-- -- the polarity the checker actually produces.
--
-- No `and = False` eliminator is needed by checker soundness: accepted
-- ForallRight produces the `or`-built freshness chain at `= False`, while
-- accepted Init produces form equality at `= True`. An `or = True`
-- eliminator likewise has no checker consumer; `fok_or_elim` remains a
-- general proved helper rather than part of the soundness route.
--
-- Every lemma case-splits on exactly the variable `fok_and`/`fok_or`'s own
-- definitions scrutinize (`a`), with its equality hypothesis relegated to
-- the RETURN type's `Pi`-chain -- the only signature shape that elaborates
-- (`D0` part (3), re-confirmed below by the naive pre-bound counterexample
-- for each lemma).

-- `Equal Bool (fok_and a b) True -> Equal Bool a True`. True branch:
-- `fok_and True b` reduces to `b`, so the goal is
-- `Equal Bool b True -> Equal Bool True True` and `h` is unused -- `a = True`
-- is already the conclusion. False branch: `fok_and False b` reduces to
-- `False`, so the goal is `Equal Bool False True -> Equal Bool False True`,
-- the hypothesis IS the conclusion.
theorem fok_and_left (a : Bool) (b : Bool)
    : Equal Bool (fok_and a b) True -> Equal Bool a True =
  match a {
    True ↦ λh. Proved;
    False ↦ λh. h
  }

-- `Equal Bool (fok_and a b) True -> Equal Bool b True`, the partner
-- projection. True branch: `fok_and True b` reduces to `b`, so the goal is
-- `Equal Bool b True -> Equal Bool b True` -- the hypothesis IS the
-- conclusion. False branch: `fok_and False b` reduces to `False`, so `h` has
-- the absurd type `Equal Bool False True`, discharging any target.
theorem fok_and_right (a : Bool) (b : Bool)
    : Equal Bool (fok_and a b) True -> Equal Bool b True =
  match a {
    True ↦ λh. h;
    False ↦ λh. absurd h
  }

-- `Equal Bool (fok_or a b) False -> Equal Bool a False` -- the polarity
-- `fok_check_forall_right` actually produces on acceptance. True branch:
-- `fok_or True b` reduces to `True`, so `h` has the absurd type
-- `Equal Bool True False`, discharging any target (here, coincidentally,
-- the same shape the goal already has -- `absurd h` is used regardless, so
-- this case reads as impossible rather than as an accidental identity).
-- False branch: `fok_or False b` reduces to `b`, so the goal
-- `Equal Bool b False -> Equal Bool False False` holds by `Proved`
-- independent of `h`.
theorem fok_or_left_false (a : Bool) (b : Bool)
    : Equal Bool (fok_or a b) False -> Equal Bool a False =
  match a {
    True ↦ λh. absurd h;
    False ↦ λh. Proved
  }

-- `Equal Bool (fok_or a b) False -> Equal Bool b False`, the partner
-- projection. True branch: `fok_or True b` reduces to `True`, so `h` is
-- again the absurd `Equal Bool True False`, discharging any target. False
-- branch: `fok_or False b` reduces to `b`, so the goal
-- `Equal Bool b False -> Equal Bool b False` is the hypothesis itself.
theorem fok_or_right_false (a : Bool) (b : Bool)
    : Equal Bool (fok_or a b) False -> Equal Bool b False =
  match a {
    True ↦ λh. absurd h;
    False ↦ λh. h
  }

-- `fok_or`'s `= True` disjunction eliminator: a continuation-passing case
-- analysis into an arbitrary Type-sorted result `target` (proof-relevant,
-- so `fn`, not `theorem` -- the overall Pi ends in the bound
-- `target : Type`, not in an `Omega`-classified `Equal`). A true,
-- kernel-checked lemma kept for completeness -- NOT because the checker
-- consumes an `or = True` hypothesis anywhere (it does not; see the
-- polarity census above). Only `a` (the case-split variable) is pre-bound
-- alongside `b`/`target`, which the match does not refine; the hypothesis
-- and both continuations mention `a`/`b` and sit in the return type's
-- `Pi`-chain, exactly like the `theorem`s above. True branch: `fok_or True
-- b` reduces to `True`, so `h : Equal Bool True True` feeds `ka` directly.
-- False branch: `fok_or False b` reduces to `b`, so `h : Equal Bool b True`
-- feeds `kb` directly.
fn fok_or_elim (a : Bool) (b : Bool) (target : Type)
    : Equal Bool (fok_or a b) True ->
      (Equal Bool a True -> target) -> (Equal Bool b True -> target) -> target =
  match a {
    True ↦ λh. λka. λkb. ka h;
    False ↦ λh. λka. λkb. kb h
  }

-- === D3/D4: checker soundness (23 section 4.4) ===
--
-- D3 introduced this full-tree classifier for its Init/ImpRight partition
-- without introducing a parallel certificate type. D4 retains it as a durable
-- description of that partition, while the full proof below no longer needs
-- the classifier as a hypothesis.
fn fok_rule_is_not_forall_right (rule : FokRule) : Bool =
  match rule {
    FokInit left right ↦ True;
    FokImpRight right ↦ True;
    FokForallRight right eigen ↦ False
  }

fn fok_cert_no_forall_right (pi : FokCert) : Bool =
  match pi {
    FokMkCert conclusion rule children ↦
      fok_and
        (fok_rule_is_not_forall_right rule)
        (fok_cert_children_all_no_forall_right children)
  }

fn fok_cert_children_all_no_forall_right (children : List FokCert) : Bool =
  match children {
    Nil ↦ True;
    Cons child rest ↦
      fok_and
        (fok_cert_no_forall_right child)
        (fok_cert_children_all_no_forall_right rest)
  }

-- Boolean equality results become kernel equalities before checker evidence is
-- transported across a stored conclusion. These helpers follow the actual
-- equality-checker call chain rather than assuming boolean reflection.
theorem fok_cong
      (a : Type) (b : Type) (x : a) (y : a) (f : a → b) (same : Equal a x y)
    : Equal b (f x) (f y) =
  J (λy2 _. Equal b (f x) (f y2)) Refl same

theorem fok_cong2
      (a : Type)
      (b : Type)
      (c : Type)
      (x1 : a)
      (y1 : a)
      (x2 : b)
      (y2 : b)
      (f : a → b → c)
      (same1 : Equal a x1 y1)
      (same2 : Equal b x2 y2)
    : Equal c (f x1 x2) (f y1 y2) =
  J
    (λy1b _. Equal c (f x1 x2) (f y1b y2))
    (J (λy2b _. Equal c (f x1 x2) (f x1 y2b)) Refl same2)
    same1

theorem fok_nat_eq_sound (a : Nat)
    : (b : Nat) → Equal Bool (fok_nat_eq a b) True → Equal Nat a b =
  match a {
    Zero ↦
      λb.
        match b {
          Zero ↦ λh. Proved;
          Suc j ↦ λh. absurd h
        };
    Suc i ↦
      λb.
        match b {
          Zero ↦ λh. absurd h;
          Suc j ↦
            λh.
              fok_cong Nat Nat i j (λn. Suc n) (fok_nat_eq_sound i j h)
        }
  }

theorem fok_qterm_eq_sound (a : FokQTerm)
    : (b : FokQTerm) →
      Equal Bool (fok_qterm_eq a b) True → Equal FokQTerm a b =
  match a {
    FokQBound i ↦
      λb.
        match b {
          FokQBound j ↦
            λh.
              fok_cong
                Nat FokQTerm i j (λn. FokQBound n) (fok_nat_eq_sound i j h);
          FokQParameter j ↦ λh. absurd h
        };
    FokQParameter i ↦
      λb.
        match b {
          FokQBound j ↦ λh. absurd h;
          FokQParameter j ↦
            λh.
              fok_cong
                Nat FokQTerm i j (λn. FokQParameter n) (fok_nat_eq_sound i j h)
        }
  }

theorem fok_form_eq_sound (a : FokForm)
    : (b : FokForm) →
      Equal Bool (fok_form_eq a b) True → Equal FokForm a b =
  match a {
    FokBottom ↦
      λb.
        match b {
          FokBottom ↦ λh. Proved;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokAccess a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦
            λh.
              fok_cong2 FokQTerm FokQTerm FokForm a1 b1 a2 b2
                (λx. λy. FokAccess x y)
                (fok_qterm_eq_sound a1 b1
                  (fok_and_left (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h))
                (fok_qterm_eq_sound a2 b2
                  (fok_and_right (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h));
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokDomainA a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦
            λh.
              fok_cong2 FokQTerm FokQTerm FokForm a1 b1 a2 b2
                (λx. λy. FokDomainA x y)
                (fok_qterm_eq_sound a1 b1
                  (fok_and_left (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h))
                (fok_qterm_eq_sound a2 b2
                  (fok_and_right (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h));
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokForcingP a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦
            λh.
              fok_cong2 FokQTerm FokQTerm FokForm a1 b1 a2 b2
                (λx. λy. FokForcingP x y)
                (fok_qterm_eq_sound a1 b1
                  (fok_and_left (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h))
                (fok_qterm_eq_sound a2 b2
                  (fok_and_right (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h));
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokAnd a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦
            λh.
              fok_cong2 FokForm FokForm FokForm a1 b1 a2 b2
                (λx. λy. FokAnd x y)
                (fok_form_eq_sound a1 b1
                  (fok_and_left (fok_form_eq a1 b1) (fok_form_eq a2 b2) h))
                (fok_form_eq_sound a2 b2
                  (fok_and_right (fok_form_eq a1 b1) (fok_form_eq a2 b2) h));
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokOr a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦
            λh.
              fok_cong2 FokForm FokForm FokForm a1 b1 a2 b2
                (λx. λy. FokOr x y)
                (fok_form_eq_sound a1 b1
                  (fok_and_left (fok_form_eq a1 b1) (fok_form_eq a2 b2) h))
                (fok_form_eq_sound a2 b2
                  (fok_and_right (fok_form_eq a1 b1) (fok_form_eq a2 b2) h));
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokImp a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦
            λh.
              fok_cong2 FokForm FokForm FokForm a1 b1 a2 b2
                (λx. λy. FokImp x y)
                (fok_form_eq_sound a1 b1
                  (fok_and_left (fok_form_eq a1 b1) (fok_form_eq a2 b2) h))
                (fok_form_eq_sound a2 b2
                  (fok_and_right (fok_form_eq a1 b1) (fok_form_eq a2 b2) h));
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokForallWorld a1 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦
            λh.
              fok_cong FokForm FokForm a1 b1
                (λx. FokForallWorld x) (fok_form_eq_sound a1 b1 h);
          FokForallObj b1 ↦ λh. absurd h
        };
    FokForallObj a1 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦
            λh.
              fok_cong FokForm FokForm a1 b1
                (λx. FokForallObj x) (fok_form_eq_sound a1 b1 h)
        }
  }

fn fok_list_form_eq_cons_result
      (x : FokForm)
      (rest : List FokForm)
      (y : FokForm)
      (ys2 : List FokForm)
      (head_result : Bool)
    : Omega =
  Equal Bool
    (match head_result {
      True ↦ fok_list_form_eq rest ys2;
      False ↦ False
    })
    True

theorem fok_list_form_eq_sound_cons
      (x : FokForm)
      (rest : List FokForm)
      (y : FokForm)
      (ys2 : List FokForm)
      (ih : (ys : List FokForm) →
        Equal Bool (fok_list_form_eq rest ys) True → Equal (List FokForm) rest ys)
    : fok_list_form_eq_cons_result x rest y ys2 (fok_form_eq x y) →
      Equal (List FokForm) (Cons FokForm x rest) (Cons FokForm y ys2) =
  match fok_form_eq x y eqn : head_true {
    True ↦
      λh.
        J
          (λy2 _.
            Equal (List FokForm)
              (Cons FokForm x rest)
              (Cons FokForm y2 ys2))
          (fok_cong
            (List FokForm)
            (List FokForm)
            rest
            ys2
            (λtail. Cons FokForm x tail)
            (ih ys2 h))
          (fok_form_eq_sound x y head_true);
    False ↦ λh. absurd h
  }

theorem fok_list_form_eq_sound (xs : List FokForm)
    : (ys : List FokForm) →
      Equal Bool (fok_list_form_eq xs ys) True → Equal (List FokForm) xs ys =
  match xs {
    Nil ↦
      λys.
        match ys {
          Nil ↦ λh. Proved;
          Cons y rest ↦ λh. absurd h
        };
    Cons x rest ↦
      λys.
        match ys {
          Nil ↦ λh. absurd h;
          Cons y ys2 ↦
            fok_list_form_eq_sound_cons
              x rest y ys2 (fok_list_form_eq_sound rest)
        }
  }

theorem fok_sequent_eq_sound_fields
      (gamma : List FokForm)
      (delta : List FokForm)
      (gamma2 : List FokForm)
      (delta2 : List FokForm)
      (gamma_same : Equal (List FokForm) gamma gamma2)
      (delta_same : Equal (List FokForm) delta delta2)
    : Equal FokSequent
      (FokMkSequent gamma delta) (FokMkSequent gamma2 delta2) =
  J
    (λgamma3 _.
      Equal FokSequent
        (FokMkSequent gamma delta)
        (FokMkSequent gamma3 delta2))
    (J
      (λdelta3 _.
        Equal FokSequent
          (FokMkSequent gamma delta)
          (FokMkSequent gamma delta3))
      (Refl, Refl)
      delta_same)
    gamma_same

fn fok_sequent_eq_result
      (gamma : List FokForm)
      (delta : List FokForm)
      (gamma2 : List FokForm)
      (delta2 : List FokForm)
      (gamma_result : Bool)
    : Omega =
  Equal Bool
    (match gamma_result {
      True ↦ fok_list_form_eq delta delta2;
      False ↦ False
    })
    True

theorem fok_sequent_eq_sound_parts
      (gamma : List FokForm)
      (delta : List FokForm)
      (gamma2 : List FokForm)
      (delta2 : List FokForm)
    : fok_sequent_eq_result
        gamma delta gamma2 delta2 (fok_list_form_eq gamma gamma2) →
      Equal FokSequent
        (FokMkSequent gamma delta) (FokMkSequent gamma2 delta2) =
  match fok_list_form_eq gamma gamma2 eqn : gamma_true {
    True ↦
      λh.
        fok_sequent_eq_sound_fields
          gamma delta gamma2 delta2
          (fok_list_form_eq_sound gamma gamma2 gamma_true)
          (fok_list_form_eq_sound delta delta2 h);
    False ↦ λh. absurd h
  }

theorem fok_sequent_eq_sound (a : FokSequent)
    : (b : FokSequent) →
      Equal Bool (fok_sequent_eq a b) True → Equal FokSequent a b =
  match a {
    FokMkSequent gamma delta ↦
      λb.
        match b {
          FokMkSequent gamma2 delta2 ↦
            fok_sequent_eq_sound_parts gamma delta gamma2 delta2
        }
  }

-- The rule proof is total over FokRule. Init and ImpRight reflect their exact
-- checker paths; ForallRight additionally reflects target shape, exact child
-- arity, recursive child acceptance, and the `= False` freshness guard.
fn fok_false_elim (target : Type) (h : Equal Bool False True) : target = absurd h

theorem fok_equal_bool_true_transport
      (a : Bool)
      (b : Bool)
      (ab : Equal Bool a b)
      (a_true : Equal Bool a True)
    : Equal Bool b True =
  J (λb2 _. Equal Bool b2 True) a_true ab

fn fok_init_right_check (g : FokForm) (right_lookup : Option FokForm) : Bool =
  match right_lookup {
    None ↦ False;
    Some d ↦ fok_form_eq g d
  }

fn fok_init_left_check
      (delta : List FokForm)
      (right : Nat)
      (left_lookup : Option FokForm)
    : Bool =
  match left_lookup {
    None ↦ False;
    Some g ↦ fok_init_right_check g (fok_nth_form delta right)
  }

fn fok_prop_init_right_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (g : FokForm)
      (left_lookup : Equal (Option FokForm)
        (fok_nth_form gamma left) (Some FokForm g))
      (right_result : Option FokForm)
    : Equal (Option FokForm) (fok_nth_form delta right) right_result →
      Equal Bool (fok_init_right_check g right_result) True →
      FokDerivation (FokMkSequent gamma delta) =
  match right_result {
    None ↦
      λright_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some d ↦
      λright_lookup. λaccepted.
        FokDerivInit gamma delta left right g d
          left_lookup right_lookup accepted
  }

fn fok_prop_init_left_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (left_result : Option FokForm)
    : Equal (Option FokForm) (fok_nth_form gamma left) left_result →
      Equal Bool (fok_init_left_check delta right left_result) True →
      FokDerivation (FokMkSequent gamma delta) =
  match left_result {
    None ↦
      λleft_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some g ↦
      λleft_lookup. λaccepted.
        fok_prop_init_right_sound
          gamma delta left right g left_lookup
          (fok_nth_form delta right) Refl accepted
  }

fn fok_prop_init_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (children : List FokCert)
    : Equal Bool (fok_check_rule gamma delta (FokInit left right) children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Cons child rest ↦
      λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Nil ↦
      λaccepted.
        fok_prop_init_left_sound
          gamma delta left right (fok_nth_form gamma left) Refl accepted
  }

fn fok_imp_rest_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (child : FokCert)
      (rest : List FokCert)
    : Bool =
  match rest {
    Cons child2 rest2 ↦ False;
    Nil ↦
      fok_check_tree_structural
        (FokMkSequent
          (fok_list_form_append_one gamma p)
          (fok_list_form_set_nth delta right q))
        child
  }

fn fok_imp_children_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (children : List FokCert)
    : Bool =
  match children {
    Nil ↦ False;
    Cons child rest ↦
      fok_imp_rest_check gamma delta right p q child rest
  }

fn fok_imp_form_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target : FokForm)
      (children : List FokCert)
    : Bool =
  match target {
    FokBottom ↦ False;
    FokAccess a b ↦ False;
    FokDomainA a b ↦ False;
    FokForcingP a b ↦ False;
    FokAnd p q ↦ False;
    FokOr p q ↦ False;
    FokImp p q ↦ fok_imp_children_check gamma delta right p q children;
    FokForallWorld body ↦ False;
    FokForallObj body ↦ False
  }

fn fok_imp_lookup_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target_result : Option FokForm)
      (children : List FokCert)
    : Bool =
  match target_result {
    None ↦ False;
    Some target ↦ fok_imp_form_check gamma delta right target children
  }

fn fok_prop_check_tree_sound_type (pi : FokCert) : Type =
  (expected : FokSequent)
    → Equal Bool
    (fok_check_tree_structural expected pi)
    True → FokDerivation expected

-- The recursion result for a child list is the head certificate's soundness
-- proof. Empty lists carry an inert Nat because no checker rule recurs there.
fn fok_prop_children_head_sound_type (children : List FokCert) : Type =
  match children {
    Nil ↦ Nat;
    Cons child rest ↦ fok_prop_check_tree_sound_type child
  }

fn fok_prop_imp_build
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (child_derivation : FokDerivation
        (FokMkSequent
          (fok_list_form_append_one gamma p)
          (fok_list_form_set_nth delta right q)))
    : FokDerivation (FokMkSequent gamma delta) =
  FokDerivImpRight
    gamma delta right p q target_lookup child_derivation

fn fok_prop_imp_build_from_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (child : FokCert)
      (child_sound : fok_prop_check_tree_sound_type child)
    : Equal Bool
        (fok_check_tree_structural
          (FokMkSequent
            (fok_list_form_append_one gamma p)
            (fok_list_form_set_nth delta right q))
          child) True →
      FokDerivation (FokMkSequent gamma delta) =
  λaccepted.
    fok_prop_imp_build gamma delta right p q target_lookup
      (child_sound
        (FokMkSequent
          (fok_list_form_append_one gamma p)
          (fok_list_form_set_nth delta right q))
        accepted)

fn fok_prop_imp_children_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (children : List FokCert)
    : fok_prop_children_head_sound_type children →
      Equal Bool (fok_imp_children_check gamma delta right p q children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Nil ↦
      λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Cons child rest ↦
      λchildren_sound.
        match rest {
          Cons child2 rest2 ↦
            λaccepted.
              fok_false_elim
                (FokDerivation (FokMkSequent gamma delta)) accepted;
          Nil ↦
            fok_prop_imp_build_from_sound
              gamma delta right p q target_lookup child children_sound
        }
  }

fn fok_prop_imp_form_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target : FokForm)
    : (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm target)) →
      (children : List FokCert) →
      (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool (fok_imp_form_check gamma delta right target children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target {
    FokBottom ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAccess a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokDomainA a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForcingP a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAnd p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokOr p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokImp p q ↦
      λtarget_lookup. λchildren. λchildren_sound.
        fok_prop_imp_children_sound
          gamma delta right p q target_lookup children children_sound;
    FokForallWorld body ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForallObj body ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted
  }

fn fok_prop_imp_lookup_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target_result : Option FokForm)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal (Option FokForm) (fok_nth_form delta right) target_result →
      Equal Bool
        (fok_imp_lookup_check gamma delta right target_result children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target_result {
    None ↦
      λtarget_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some target ↦
      λtarget_lookup.
        fok_prop_imp_form_sound
          gamma delta right target target_lookup children children_sound
  }

fn fok_prop_imp_right_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool (fok_check_rule gamma delta (FokImpRight right) children) True →
      FokDerivation (FokMkSequent gamma delta) =
  fok_prop_imp_lookup_sound
    gamma delta right (fok_nth_form delta right)
    children children_sound Refl

fn fok_forall_form_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (target : FokForm)
      (children : List FokCert)
    : Bool =
  match target {
    FokBottom ↦ False;
    FokAccess a b ↦ False;
    FokDomainA a b ↦ False;
    FokForcingP a b ↦ False;
    FokAnd p q ↦ False;
    FokOr p q ↦ False;
    FokImp p q ↦ False;
    FokForallWorld body ↦
      fok_check_forall_right
        (FokMkSequent gamma delta) gamma delta right eigen body children;
    FokForallObj body ↦
      fok_check_forall_right
        (FokMkSequent gamma delta) gamma delta right eigen body children
  }

fn fok_forall_lookup_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (target_result : Option FokForm)
      (children : List FokCert)
    : Bool =
  match target_result {
    None ↦ False;
    Some target ↦
      fok_forall_form_check gamma delta right eigen target children
  }

fn fok_forall_children_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (children : List FokCert)
    : Bool =
  match children {
    Nil ↦ False;
    Cons child rest ↦
      match rest {
        Cons child2 rest2 ↦ False;
        Nil ↦
          fok_check_tree_structural
            (FokMkSequent gamma
              (fok_list_form_set_nth delta right
                (fok_subst0_form body eigen)))
            child
      }
  }

fn fok_forall_fresh_result (child_result : Bool) (fresh : Bool) : Bool =
  match fresh {
    True ↦ False;
    False ↦ child_result
  }

theorem fok_check_forall_right_result_eq
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (children : List FokCert)
    : Equal Bool
        (fok_check_forall_right
          (FokMkSequent gamma delta)
          gamma delta right eigen body children)
        (fok_forall_fresh_result
          (fok_forall_children_check
            gamma delta right eigen body children)
          (fok_sequent_mentions_parameter
            (FokMkSequent gamma delta) eigen)) = Refl

theorem fok_forall_fresh_false (child_result : Bool) (fresh : Bool)
    : Equal Bool (fok_forall_fresh_result child_result fresh) True →
      Equal Bool fresh False =
  match fresh {
    True ↦ λaccepted. absurd accepted;
    False ↦ λaccepted. Proved
  }

theorem fok_forall_child_accepted (child_result : Bool) (fresh : Bool)
    : Equal Bool (fok_forall_fresh_result child_result fresh) True →
      Equal Bool child_result True =
  match fresh {
    True ↦ λaccepted. absurd accepted;
    False ↦ λaccepted. accepted
  }

fn fok_forall_world_children_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallWorld body)))
      (fresh : Equal Bool
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) eigen) False)
      (children : List FokCert)
    : (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool
        (fok_forall_children_check
          gamma delta right eigen body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Nil ↦
      λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Cons child rest ↦
      λchildren_sound.
        match rest {
          Cons child2 rest2 ↦
            λaccepted.
              fok_false_elim
                (FokDerivation (FokMkSequent gamma delta)) accepted;
          Nil ↦
            λaccepted.
              FokDerivForallWorldRight
                gamma delta right eigen body target_lookup fresh
                (children_sound
                  (FokMkSequent gamma
                    (fok_list_form_set_nth delta right
                      (fok_subst0_form body eigen)))
                  accepted)
        }
  }

fn fok_forall_world_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallWorld body)))
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_forall_right
          (FokMkSequent gamma delta)
          gamma delta right eigen body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  λaccepted.
    fok_forall_world_children_sound
      gamma delta right eigen body target_lookup
      (fok_forall_fresh_false
        (fok_forall_children_check
          gamma delta right eigen body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) eigen)
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right eigen body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right eigen body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) eigen))
          (fok_check_forall_right_result_eq
            gamma delta right eigen body children)
          accepted))
      children children_sound
      (fok_forall_child_accepted
        (fok_forall_children_check
          gamma delta right eigen body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) eigen)
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right eigen body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right eigen body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) eigen))
          (fok_check_forall_right_result_eq
            gamma delta right eigen body children)
          accepted))

fn fok_forall_obj_children_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallObj body)))
      (fresh : Equal Bool
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) eigen) False)
      (children : List FokCert)
    : (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool
        (fok_forall_children_check
          gamma delta right eigen body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Nil ↦
      λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Cons child rest ↦
      λchildren_sound.
        match rest {
          Cons child2 rest2 ↦
            λaccepted.
              fok_false_elim
                (FokDerivation (FokMkSequent gamma delta)) accepted;
          Nil ↦
            λaccepted.
              FokDerivForallObjRight
                gamma delta right eigen body target_lookup fresh
                (children_sound
                  (FokMkSequent gamma
                    (fok_list_form_set_nth delta right
                      (fok_subst0_form body eigen)))
                  accepted)
        }
  }

fn fok_forall_obj_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallObj body)))
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_forall_right
          (FokMkSequent gamma delta)
          gamma delta right eigen body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  λaccepted.
    fok_forall_obj_children_sound
      gamma delta right eigen body target_lookup
      (fok_forall_fresh_false
        (fok_forall_children_check
          gamma delta right eigen body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) eigen)
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right eigen body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right eigen body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) eigen))
          (fok_check_forall_right_result_eq
            gamma delta right eigen body children)
          accepted))
      children children_sound
      (fok_forall_child_accepted
        (fok_forall_children_check
          gamma delta right eigen body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) eigen)
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right eigen body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right eigen body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) eigen))
          (fok_check_forall_right_result_eq
            gamma delta right eigen body children)
          accepted))

fn fok_forall_form_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (target : FokForm)
    : (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm target)) →
      (children : List FokCert) →
      (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool
        (fok_forall_form_check gamma delta right eigen target children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target {
    FokBottom ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAccess a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokDomainA a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForcingP a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAnd p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokOr p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokImp p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForallWorld body ↦
      λtarget_lookup. λchildren. λchildren_sound.
        fok_forall_world_sound
          gamma delta right eigen body target_lookup children children_sound;
    FokForallObj body ↦
      λtarget_lookup. λchildren. λchildren_sound.
        fok_forall_obj_sound
          gamma delta right eigen body target_lookup children children_sound
  }

fn fok_forall_lookup_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (target_result : Option FokForm)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal (Option FokForm) (fok_nth_form delta right) target_result →
      Equal Bool
        (fok_forall_lookup_check
          gamma delta right eigen target_result children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target_result {
    None ↦
      λtarget_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some target ↦
      λtarget_lookup.
        fok_forall_form_sound
          gamma delta right eigen target target_lookup
          children children_sound
  }

fn fok_forall_right_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_rule
          gamma delta (FokForallRight right eigen) children) True →
      FokDerivation (FokMkSequent gamma delta) =
  fok_forall_lookup_sound
    gamma delta right eigen (fok_nth_form delta right)
    children children_sound Refl

fn fok_prop_check_rule_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
    : (children : List FokCert) →
      (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool (fok_check_rule gamma delta rule children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match rule {
    FokInit left right ↦
      λchildren. λchildren_sound.
        fok_prop_init_sound gamma delta left right children;
    FokImpRight right ↦
      λchildren. λchildren_sound.
        fok_prop_imp_right_sound
          gamma delta right children children_sound;
    FokForallRight right eigen ↦
      λchildren. λchildren_sound.
        fok_forall_right_sound
          gamma delta right eigen children children_sound
  }

fn fok_matched_conclusion_check
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Bool =
  match conclusion {
    FokMkSequent gamma delta ↦ fok_check_rule gamma delta rule children
  }

fn fok_prop_matched_fields_sound
      (expected : FokSequent)
      (gamma : List FokForm)
      (delta : List FokForm)
      (conclusion_matches : Equal Bool
        (fok_sequent_eq (FokMkSequent gamma delta) expected) True)
      (rule : FokRule)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool (fok_check_rule gamma delta rule children) True →
      FokDerivation expected =
  λaccepted.
    J
      (λexpected2 _. FokDerivation expected2)
      (fok_prop_check_rule_sound
        gamma delta rule children children_sound accepted)
      (fok_sequent_eq_sound
        (FokMkSequent gamma delta) expected conclusion_matches)

fn fok_check_tree_view
      (expected : FokSequent)
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Bool =
  match fok_sequent_eq conclusion expected {
    False ↦ False;
    True ↦ fok_matched_conclusion_check conclusion rule children
  }

theorem fok_check_tree_view_eq
      (expected : FokSequent)
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Equal Bool
        (fok_check_tree_view expected conclusion rule children)
        (fok_check_tree_structural expected (FokMkCert conclusion rule children)) =
  Refl

fn fok_check_tree_result
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
      (conclusion_result : Bool)
    : Bool =
  match conclusion_result {
    False ↦ False;
    True ↦ fok_matched_conclusion_check conclusion rule children
  }

theorem fok_check_tree_result_view_eq
      (expected : FokSequent)
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Equal Bool
        (fok_check_tree_result conclusion rule children
          (fok_sequent_eq conclusion expected))
        (fok_check_tree_view expected conclusion rule children) = Refl

fn fok_prop_check_tree_result_sound
      (expected : FokSequent)
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
      (conclusion_result : Bool)
    : Equal Bool
        (fok_sequent_eq (FokMkSequent gamma delta) expected)
        conclusion_result →
      Equal Bool
        (fok_check_tree_result
          (FokMkSequent gamma delta) rule children conclusion_result) True →
      FokDerivation expected =
  match conclusion_result {
    False ↦
      λconclusion_matches. λaccepted.
        fok_false_elim (FokDerivation expected) accepted;
    True ↦
      λconclusion_matches.
        fok_prop_matched_fields_sound
          expected gamma delta conclusion_matches
          rule children children_sound
  }

fn fok_prop_check_tree_view_sound
      (expected : FokSequent)
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_tree_view
          expected (FokMkSequent gamma delta) rule children) True →
      FokDerivation expected =
  J
    (λcheck_result _.
      Equal Bool check_result True → FokDerivation expected)
    (fok_prop_check_tree_result_sound
      expected gamma delta rule children children_sound
      (fok_sequent_eq (FokMkSequent gamma delta) expected) Refl)
    (fok_check_tree_result_view_eq
      expected (FokMkSequent gamma delta) rule children)

fn fok_prop_check_tree_sound_by_cert (pi : FokCert)
    : fok_prop_check_tree_sound_type pi =
  match pi {
    FokMkCert conclusion rule children ↦
      match conclusion {
        FokMkSequent gamma delta ↦
          fok_prop_check_tree_sound_by_children
            gamma delta rule children
      }
  }

fn fok_prop_check_tree_sound_by_children
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
      (children : List FokCert)
    : fok_prop_check_tree_sound_type
        (FokMkCert (FokMkSequent gamma delta) rule children) =
  match children {
    Nil ↦
      λexpected.
        J
          (λcheck_result _.
            Equal Bool check_result True → FokDerivation expected)
          (fok_prop_check_tree_view_sound
            expected gamma delta
            rule (Nil FokCert) Zero)
          (fok_check_tree_view_eq
            expected (FokMkSequent gamma delta)
            rule (Nil FokCert));
    Cons child rest ↦
      λexpected.
        J
          (λcheck_result _.
            Equal Bool check_result True → FokDerivation expected)
          (fok_prop_check_tree_view_sound
            expected gamma delta
            rule (Cons FokCert child rest)
            (fok_prop_check_tree_sound_by_cert child))
          (fok_check_tree_view_eq
            expected (FokMkSequent gamma delta)
            rule (Cons FokCert child rest))
  }

fn fok_prop_check_tree_sound
      (expected : FokSequent) (pi : FokCert)
    : Equal Bool (fok_check_tree_structural expected pi) True → FokDerivation expected =
  fok_prop_check_tree_sound_by_cert pi expected

theorem fok_check_tree_validation_monotonic
      (expected : FokSequent) (pi : FokCert)
    : Equal Bool (fok_check_tree expected pi) True
      → Equal Bool (fok_check_tree_structural expected pi) True =
  fok_and_right (fok_validate_certificate_bool pi) (fok_check_tree_structural expected pi)

-- D4 closes both ForallRight target shapes and their shared freshness guard,
-- so every accepted certificate is reflected into the indexed derivation.
-- The validation adapter is monotonic: validated acceptance first yields the
-- unchanged calculus checker's acceptance, then the existing reflection proof.
theorem fok_checker_soundness (q : FokForm) (pi : FokCert)
    : Equal Bool (fok_check_cert q pi) True → fok_classically_valid q =
  λaccepted.
    trunc_intro
      (fok_prop_check_tree_sound
        (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm)))
        pi
        (fok_check_tree_validation_monotonic
          (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm)))
          pi
          accepted))
