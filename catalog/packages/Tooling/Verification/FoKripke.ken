-- FO Kripke embedding slice: quoted syntax and embed (23 section 4.3, 4.5).
--
-- Ken-level mirror of `crates/ken-elaborator/src/fo_kripke.rs`'s D0 quoted
-- types and D1 `embed` (V3-FO-KEN-LEVEL-CHECKER-AUTHORING, increment 1). The
-- Rust module is reference for SHAPE only -- every definition here is
-- authored independently, never transcribed from Rust computation. Every
-- name carries a `Fok`/`fok_` prefix to keep this file's constructors and
-- functions out of the shared catalog namespace, following the `nc9_`
-- convention in `ProofErasureBoundaryChecker.ken`.
--
-- This file now includes the later `fok_check_cert` increment and its
-- fail-closed derived sort/scope validation. Still deliberately absent: any
-- FO `Proved` verdict, new kernel primitive or trusted axiom, or widening of
-- the five-constructor / three-rule slice below.

import Core.Logic.Or (Or, Inl, Inr)

-- === D0: quoted source data (23 section 4.3, slice subset) ===

-- A bound source object variable, de Bruijn (23 section 4.3 `IVar`).
data FokIVar = FokMkIVar Nat

-- Quoted intuitionistic source formula -- SLICE CONSTRUCTOR SUBSET (23
-- section 4.5: bottom, atom, or, imp, forall). Exactly five constructors,
-- mirroring `fo_kripke::IForm`. The general section 4.3 `IForm` also has
-- `top`, `and`, and `exists`; this slice's source grammar deliberately
-- carries none of the three -- not an oversight, the same omission the Rust
-- reference makes for the same reason (23 section 4.5's fragment).
data FokIForm =
    FokIBottom
  | FokIAtom FokIVar
  | FokIOr FokIForm FokIForm
  | FokIImp FokIForm FokIForm
  | FokIForall FokIForm

-- The slice's one-sort, one-predicate signature. Keeping the signature as an
-- index makes the source-side families state their common profile even though
-- this first vertical slice has exactly one profile.
data FokSignature : Type where {
  FokSliceSignature : FokSignature
}

-- The closed rigid carrier for the slice's object sort A. The carrier may be
-- empty; no inhabitant is stored or synthesized here.
data FokCarriers (sigma : FokSignature) : Type 1 where {
  FokMkCarriers : Type -> FokCarriers sigma
}

fn fok_sort_a (sigma : FokSignature) (c : FokCarriers sigma) : Type =
  match c {
    FokMkCarriers a ↦ a
  }

-- The slice's unary predicate P, proposition-valued over the selected carrier.
class FokAtomPred (a : Type) {
  pred_p : a -> Omega
}

-- An atom interpretation is indexed by the same signature and carrier value.
data FokAtomEnv (sigma : FokSignature) (c : FokCarriers sigma) : Type 1 where {
  FokMkAtomEnv : FokAtomPred (fok_sort_a sigma c) -> FokAtomEnv sigma c
}

fn fok_pred_p
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    : fok_sort_a sigma c -> Omega =
  match rho {
    FokMkAtomEnv d ↦ d.pred_p
  }

-- A bounded de Bruijn object-variable index. `FokFin Zero` has no
-- constructor, so a closed formula cannot contain a free object atom.
data FokFin : Nat -> Type where {
  FokFinZero : (n : Nat) -> FokFin (Suc n);
  FokFinSuc : (n : Nat) -> FokFin n -> FokFin (Suc n)
}

fn fok_fin_to_nat (n : Nat) (i : FokFin n) : Nat =
  match i {
    FokFinZero m ↦ Zero;
    FokFinSuc m j ↦ Suc (fok_fin_to_nat m j)
  }

-- A length-indexed environment of actual carrier values. Lookup by `FokFin`
-- is total: neither `Option` nor a default carrier value occurs in its type.
data FokObjectEnv
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    : Nat -> Type 1 where {
  FokObjectEnvNil : FokObjectEnv sigma c Zero;
  FokObjectEnvCons :
    (n : Nat)
    -> fok_sort_a sigma c
    -> FokObjectEnv sigma c n
    -> FokObjectEnv sigma c (Suc n)
}

fn fok_object_env_lookup
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (n : Nat)
    (xs : FokObjectEnv sigma c n)
    (i : FokFin n)
    : fok_sort_a sigma c =
  match i {
    FokFinZero m ↦
      match xs {
        FokObjectEnvCons k x rest ↦ x
      };
    FokFinSuc m j ↦
      match xs {
        FokObjectEnvCons k x rest ↦
          fok_object_env_lookup sigma c m rest j
      }
  }

-- The intrinsically-scoped source form `IForm Sigma n` from 23 section 4.4.
-- `n` counts enclosing object binders. Implication keeps that count unchanged;
-- forall checks its body at one additional object slot.
data FokScopedIForm (sigma : FokSignature) : Nat -> Type where {
  FokScopedBottom : (n : Nat) -> FokScopedIForm sigma n;
  FokScopedAtom : (n : Nat) -> FokFin n -> FokScopedIForm sigma n;
  FokScopedOr :
    (n : Nat)
    -> FokScopedIForm sigma n
    -> FokScopedIForm sigma n
    -> FokScopedIForm sigma n;
  FokScopedImp :
    (n : Nat)
    -> FokScopedIForm sigma n
    -> FokScopedIForm sigma n
    -> FokScopedIForm sigma n;
  FokScopedForall :
    (n : Nat) -> FokScopedIForm sigma (Suc n) -> FokScopedIForm sigma n
}

-- === D0: quoted target data (23 section 4.3, slice subset) ===

-- A quoted-target variable, de Bruijn bound or a certificate-local free
-- eigenparameter (23 section 4.3 `QTerm`). The slice folds `QSort` (world
-- vs. object) into which `FokForm`/`FokRule` variant is used, never onto
-- `FokQTerm` itself -- mirroring `fo_kripke::QTerm`.
data FokQTerm = FokQBound Nat | FokQParameter Nat

-- Target classical formula -- SLICE CONSTRUCTOR SUBSET (23 section 4.5):
-- bottom, relation, and, or, imp, forall. Nine constructors, mirroring
-- `fo_kripke::Form`. `FokAnd` is needed even though the SOURCE slice above
-- has no `and`: `K(Sigma)`'s own axioms (23 section 4.2) use it in their
-- antecedents.
data FokForm =
    FokBottom
  | FokAccess FokQTerm FokQTerm
  | FokDomainA FokQTerm FokQTerm
  | FokForcingP FokQTerm FokQTerm
  | FokAnd FokForm FokForm
  | FokOr FokForm FokForm
  | FokImp FokForm FokForm
  | FokForallWorld FokForm
  | FokForallObj FokForm

-- A sequent Gamma => Delta (23 section 4.3). The general contract uses
-- canonical multisets (exchange is representation equality); the slice's
-- three rules below never weaken/contract/exchange, so an insertion-order
-- `List` loses nothing here, exactly as `fo_kripke::Sequent` uses `Vec`.
data FokSequent = FokMkSequent (List FokForm) (List FokForm)

-- Certificate rule tags -- SLICE SUBSET ONLY: init, imp-right, forall-right
-- (23 section 4.5: "the positive proof needs exactly [these] certificate
-- rules"). Three variants against the general section 4.3 `Rule`'s ~20: this
-- slice deliberately carries none of and-left/and-right, or-left, imp-left,
-- forall-left, exists-left/exists-right, top-right, bottom-left, cut,
-- weaken, contract, exchange, or any classical double-negation/excluded-
-- middle rule the general calculus offers. The route's own positive-proof
-- fragment closes every certificate this slice can produce with exactly
-- these three.
-- `FokForallRight`'s second field is the eigenPARAMETER's INDEX, not a general
-- `FokQTerm` (`V3-FO-SORTED-EIGENPARAMETER-DERIVATION` `D1`). A bound eigen is
-- therefore UNREPRESENTABLE; the rule always denotes `FokQParameter eigen`, so
-- a fresh bound index can never pass as if it were a parameter. Mirrors Rust's
-- `Rule::ForallRight { eigen: usize }`.
data FokRule =
    FokInit Nat Nat
  | FokImpRight Nat
  | FokForallRight Nat Nat

-- A certificate proof-tree node (23 section 4.3 `Cert`).
data FokCert = FokMkCert FokSequent FokRule (List FokCert)

-- === D1: embed -- the exact classical Kripke theory (23 section 4.2) ===

-- Total lookup into a `Nat`-valued `List` at a `Nat` index, defaulting to
-- `Zero` out of range. `fok_w_forces` below only ever indexes `object_env`
-- at a position a well-scoped `FokIForm` guarantees present (one entry per
-- enclosing `FokIForall`, in binder order) -- the default arm is
-- unreachable on any input this increment's controls exercise, exactly as
-- `fo_kripke::w_forces`'s `object_env[*k]` relies on the same invariant
-- without asserting it.
fn fok_nth_nat_default (xs : List Nat) (i : Nat) : Nat =
  match xs {
    Nil ↦ Zero;
    Cons x rest ↦
      match i {
        Zero ↦ x;
        Suc j ↦ fok_nth_nat_default rest j
      }
  }

-- `object_env.iter().map(|i| i + 1)` -- `fo_kripke.rs`'s own shift-on-entry
-- discipline, shared by both the `Imp` and `Forall` cases below.
fn fok_map_suc (xs : List Nat) : List Nat =
  match xs {
    Nil ↦ Nil Nat;
    Cons x rest ↦ Cons Nat (Suc x) (fok_map_suc rest)
  }

-- `K(Sigma)`'s five axioms (23 section 4.2), each its own top-level
-- definition so `fok_k_sigma`'s composition below mirrors
-- `fo_kripke::k_sigma`'s local-`let` structure exactly.

-- `forall w. Le w w`.
const fok_preorder_reflexive : FokForm =
  FokForallWorld (FokAccess (FokQBound Zero) (FokQBound Zero))

-- `forall w v u. (Le w v and Le v u) => Le w u`.
const fok_preorder_transitive : FokForm =
  FokForallWorld (FokForallWorld (FokForallWorld
    (FokImp
      (FokAnd
        (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound (Suc Zero)))
        (FokAccess (FokQBound (Suc Zero)) (FokQBound Zero)))
      (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound Zero)))))

-- `forall w v x. (Le w v and Dom_A w x) => Dom_A v x`.
const fok_domain_growth_a : FokForm =
  FokForallWorld (FokForallWorld (FokForallObj
    (FokImp
      (FokAnd
        (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound (Suc Zero)))
        (FokDomainA (FokQBound (Suc (Suc Zero))) (FokQBound Zero)))
      (FokDomainA (FokQBound (Suc Zero)) (FokQBound Zero)))))

-- `forall w x. Force_P w x => Dom_A w x` (unary P: single conjunct, no
-- `and` needed).
const fok_atom_domain_p : FokForm =
  FokForallWorld (FokForallObj
    (FokImp
      (FokForcingP (FokQBound (Suc Zero)) (FokQBound Zero))
      (FokDomainA (FokQBound (Suc Zero)) (FokQBound Zero))))

-- `forall w v x. (Le w v and Force_P w x) => Force_P v x`.
const fok_atom_persistence_p : FokForm =
  FokForallWorld (FokForallWorld (FokForallObj
    (FokImp
      (FokAnd
        (FokAccess (FokQBound (Suc (Suc Zero))) (FokQBound (Suc Zero)))
        (FokForcingP (FokQBound (Suc (Suc Zero))) (FokQBound Zero)))
      (FokForcingP (FokQBound (Suc Zero)) (FokQBound Zero)))))

-- The five axioms conjoined, matching `fo_kripke::k_sigma`'s nesting
-- exactly: `And(And(And(reflexive, transitive), domain_growth), And(atom_
-- domain, atom_persistence))`.
const fok_k_sigma : FokForm =
  FokAnd
    (FokAnd
      (FokAnd fok_preorder_reflexive fok_preorder_transitive)
      fok_domain_growth_a)
    (FokAnd fok_atom_domain_p fok_atom_persistence_p)

-- `w |= f`, the forcing translation (23 section 4.2), given the current
-- world's index and the object-variable environment (source `FokIVar`
-- index -> its current target index), both counted in the SAME unified de
-- Bruijn space `FokForm` uses for world and object binders alike -- mirrors
-- `fo_kripke::w_forces` exactly, case by case.
fn fok_w_forces (world : Nat) (object_env : List Nat) (f : FokIForm) : FokForm =
  match f {
    FokIBottom ↦ FokBottom;
    FokIAtom v ↦
      match v {
        FokMkIVar k ↦
          FokForcingP (FokQBound world) (FokQBound (fok_nth_nat_default object_env k))
      };
    FokIOr p q ↦
      FokOr (fok_w_forces world object_env p) (fok_w_forces world object_env q);
    FokIImp p q ↦
      FokForallWorld
        (FokImp
          (FokAccess (FokQBound (Suc world)) (FokQBound Zero))
          (FokImp
            (fok_w_forces Zero (fok_map_suc object_env) p)
            (fok_w_forces Zero (fok_map_suc object_env) q)));
    FokIForall p ↦
      FokForallWorld
        (FokImp
          (FokAccess (FokQBound (Suc world)) (FokQBound Zero))
          (FokForallObj
            (FokImp
              (FokDomainA (FokQBound (Suc Zero)) (FokQBound Zero))
              (fok_w_forces
                (Suc Zero)
                (Cons Nat Zero (fok_map_suc (fok_map_suc object_env)))
                p))))
  }

-- `embed(Sigma, f) := K(Sigma) => forall w : World. w |= f` (23 section
-- 4.2). `K(Sigma)` is INSIDE the target: no frame or forcing premise is
-- emitted outside `fok_embed`'s own `FokForm` -- mirrors `fo_kripke::embed`.
fn fok_embed (f : FokIForm) : FokForm =
  FokImp fok_k_sigma (FokForallWorld (fok_w_forces Zero (Nil Nat) f))

-- Source denotation under an environment whose length is the source scope.
-- The environment is returned as a function argument so each recursive call
-- remains directly beneath the constructor match that exposes its subform.
fn fok_denote_at
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    (n : Nat)
    (f : FokScopedIForm sigma n)
    : FokObjectEnv sigma c n -> Omega =
  match f {
    FokScopedBottom m ↦ λxs. Bottom;
    FokScopedAtom m i ↦ λxs.
      fok_pred_p sigma c rho (fok_object_env_lookup sigma c n xs i);
    FokScopedOr m p q ↦ λxs.
      ‖Or
        ((fok_denote_at sigma c rho n p) xs)
        ((fok_denote_at sigma c rho n q) xs)‖;
    FokScopedImp m p q ↦ λxs.
      (fok_denote_at sigma c rho n p xs)
        -> (fok_denote_at sigma c rho n q xs);
    FokScopedForall m p ↦ λxs.
      (x : fok_sort_a sigma c) ->
        (fok_denote_at sigma c rho (Suc n) p)
          (FokObjectEnvCons sigma c n x xs)
  }

-- Public denotation starts from a closed source form and the unique empty
-- object environment. Every atom is therefore reached only below a forall.
fn fok_denote
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    (f : FokScopedIForm sigma Zero)
    : Omega =
  fok_denote_at sigma c rho Zero f (FokObjectEnvNil sigma c)

-- Forget only the scope evidence. Constructor order and atom identity are
-- unchanged, and the bounded index becomes the same de Bruijn `Nat`.
fn fok_erase_n
    (sigma : FokSignature)
    (n : Nat)
    (f : FokScopedIForm sigma n)
    : FokIForm =
  match f {
    FokScopedBottom m ↦ FokIBottom;
    FokScopedAtom m i ↦ FokIAtom (FokMkIVar (fok_fin_to_nat n i));
    FokScopedOr m p q ↦
      FokIOr (fok_erase_n sigma n p) (fok_erase_n sigma n q);
    FokScopedImp m p q ↦
      FokIImp (fok_erase_n sigma n p) (fok_erase_n sigma n q);
    FokScopedForall m p ↦ FokIForall (fok_erase_n sigma (Suc n) p)
  }

-- The target leg uses the already-landed embedding verbatim on the forgetful
-- image; denotation above never passes through erasure.
fn fok_scoped_embed
    (sigma : FokSignature)
    (f : FokScopedIForm sigma Zero)
    : FokForm =
  fok_embed (fok_erase_n sigma Zero f)

-- === D2: check_cert -- computable (23 section 4.3) ===
--
-- Mirrors `fo_kripke::check_tree`'s GUARDED discipline exactly
-- (`evt_5fc6hsgcn9exq`, Architect ruling): the Rust reference has zero
-- `unwrap`/`expect`/`panic!`/`unreachable!` in this range, and its two bare
-- index writes are each on a `clone()` of the very `Vec` whose `.get()` at
-- the same index returned `Some` immediately above -- so it is total in
-- BEHAVIOUR, not merely `-> bool` in signature. Every lookup below returns
-- `Option` LOCALLY and every `None` maps to `False`, exactly what Rust's
-- `let Some(x) = ... else { return false }` does; the `Option` never
-- surfaces as the verdict's own shape. `Form`/`QTerm` stay untagged, while
-- the derived validation pass below rejects wrong-sort and out-of-scope
-- occurrences before this structural checker runs. The Rust boundary applies
-- the same monotonic restriction over its unchanged calculus checker.

-- `Nat` equality, structural.
fn fok_nat_eq (a : Nat) (b : Nat) : Bool =
  match a {
    Zero ↦
      match b {
        Zero ↦ True;
        Suc j ↦ False
      };
    Suc i ↦
      match b {
        Zero ↦ False;
        Suc j ↦ fok_nat_eq i j
      }
  }

-- `a < b`, structural.
fn fok_nat_lt (a : Nat) (b : Nat) : Bool =
  match a {
    Zero ↦
      match b {
        Zero ↦ False;
        Suc j ↦ True
      };
    Suc i ↦
      match b {
        Zero ↦ False;
        Suc j ↦ fok_nat_lt i j
      }
  }

-- Predecessor, `Zero` at `Zero` (never reached at any call site below: it is
-- only ever applied where `fok_nat_lt depth i` already established `i > 0`).
fn fok_nat_pred (a : Nat) : Nat =
  match a {
    Zero ↦ Zero;
    Suc i ↦ i
  }

-- Short-circuit boolean or.
fn fok_or (a : Bool) (b : Bool) : Bool =
  match a {
    True ↦ True;
    False ↦ b
  }

-- Short-circuit boolean and.
fn fok_and (a : Bool) (b : Bool) : Bool =
  match a {
    True ↦ b;
    False ↦ False
  }

-- Total lookup into a `FokForm`-valued `List` at a `Nat` index, `None` out of
-- range -- mirrors `Vec::get`, used everywhere `check_tree` writes
-- `.get(*right)`/`.get(*left)`.
fn fok_nth_form (xs : List FokForm) (i : Nat) : Option FokForm =
  match xs {
    Nil ↦ None FokForm;
    Cons x rest ↦
      match i {
        Zero ↦ Some FokForm x;
        Suc j ↦ fok_nth_form rest j
      }
  }

-- Replace the element at `i` with `v`. Out-of-range is a structural no-op
-- (returns `xs` unchanged past where it runs out) -- unreachable at every
-- call site below, each of which only calls this after a `fok_nth_form`
-- lookup at the SAME index already returned `Some`, exactly as Rust's
-- `expected_delta[*right] = ...` is only reached after `.get(*right)`
-- returned `Some` two lines above it.
fn fok_list_form_set_nth (xs : List FokForm) (i : Nat) (v : FokForm) : List FokForm =
  match xs {
    Nil ↦ Nil FokForm;
    Cons x rest ↦
      match i {
        Zero ↦ Cons FokForm v rest;
        Suc j ↦ Cons FokForm x (fok_list_form_set_nth rest j v)
      }
  }

-- Append one element at the end -- mirrors `expected_gamma.push(...)`.
fn fok_list_form_append_one (xs : List FokForm) (v : FokForm) : List FokForm =
  match xs {
    Nil ↦ Cons FokForm v (Nil FokForm);
    Cons x rest ↦ Cons FokForm x (fok_list_form_append_one rest v)
  }

-- The "exactly one child" guard (Rust's slice pattern `let [child] =
-- node.children.as_slice() else { return false }`) is inlined directly at
-- each of its two call sites below, as a `Cons child (Nil ...)` match,
-- rather than factored through a `List FokCert -> Option FokCert` helper:
-- the kernel's termination checker traces a structural decrease only through
-- a DIRECT pattern match feeding a recursive call in the same function, not
-- through an intervening non-recursive helper's return value (confirmed
-- empirically -- factoring it out reds `SCT: idempotent self-loop has no
-- strictly-decreasing parameter` on this mutual-recursion clique).

-- `FokQTerm` equality, structural -- every constructor pair named explicitly
-- (no wildcard arm), so a future `FokQTerm` variant is a compile error here
-- rather than a silent fall-through.
fn fok_qterm_eq (a : FokQTerm) (b : FokQTerm) : Bool =
  match a {
    FokQBound i ↦
      match b {
        FokQBound j ↦ fok_nat_eq i j;
        FokQParameter j ↦ False
      };
    FokQParameter i ↦
      match b {
        FokQBound j ↦ False;
        FokQParameter j ↦ fok_nat_eq i j
      }
  }

-- `FokForm` equality, structural over all nine slice constructors -- every
-- pair named explicitly, matching the `bool_expr_eq`-style precedent
-- (`Capability/Parsing/Parsing.ken.md`) rather than a wildcard arm.
fn fok_form_eq (a : FokForm) (b : FokForm) : Bool =
  match a {
    FokBottom ↦
      match b {
        FokBottom ↦ True;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokAccess a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ fok_and (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2);
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokDomainA a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ fok_and (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2);
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokForcingP a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ fok_and (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2);
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokAnd a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ fok_and (fok_form_eq a1 b1) (fok_form_eq a2 b2);
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokOr a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ fok_and (fok_form_eq a1 b1) (fok_form_eq a2 b2);
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokImp a1 a2 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ fok_and (fok_form_eq a1 b1) (fok_form_eq a2 b2);
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ False
      };
    FokForallWorld a1 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ fok_form_eq a1 b1;
        FokForallObj b1 ↦ False
      };
    FokForallObj a1 ↦
      match b {
        FokBottom ↦ False;
        FokAccess b1 b2 ↦ False;
        FokDomainA b1 b2 ↦ False;
        FokForcingP b1 b2 ↦ False;
        FokAnd b1 b2 ↦ False;
        FokOr b1 b2 ↦ False;
        FokImp b1 b2 ↦ False;
        FokForallWorld b1 ↦ False;
        FokForallObj b1 ↦ fok_form_eq a1 b1
      }
  }

-- Element-wise `List FokForm` equality (length and every position).
fn fok_list_form_eq (xs : List FokForm) (ys : List FokForm) : Bool =
  match xs {
    Nil ↦
      match ys {
        Nil ↦ True;
        Cons y ys2 ↦ False
      };
    Cons x xs2 ↦
      match ys {
        Nil ↦ False;
        Cons y ys2 ↦
          match fok_form_eq x y {
            True ↦ fok_list_form_eq xs2 ys2;
            False ↦ False
          }
      }
  }

-- `FokSequent` equality: both sides, `gamma` then `delta`.
fn fok_sequent_eq (a : FokSequent) (b : FokSequent) : Bool =
  match a {
    FokMkSequent ga da ↦
      match b {
        FokMkSequent gb db ↦
          match fok_list_form_eq ga gb {
            True ↦ fok_list_form_eq da db;
            False ↦ False
          }
      }
  }

-- Does `target` occur anywhere in `form`?
fn fok_form_mentions_parameter (form : FokForm) (target : FokQTerm) : Bool =
  match form {
    FokBottom ↦ False;
    FokAccess a b ↦ fok_or (fok_qterm_eq a target) (fok_qterm_eq b target);
    FokDomainA a b ↦ fok_or (fok_qterm_eq a target) (fok_qterm_eq b target);
    FokForcingP a b ↦ fok_or (fok_qterm_eq a target) (fok_qterm_eq b target);
    FokAnd p q ↦ fok_or (fok_form_mentions_parameter p target) (fok_form_mentions_parameter q target);
    FokOr p q ↦ fok_or (fok_form_mentions_parameter p target) (fok_form_mentions_parameter q target);
    FokImp p q ↦ fok_or (fok_form_mentions_parameter p target) (fok_form_mentions_parameter q target);
    FokForallWorld b ↦ fok_form_mentions_parameter b target;
    FokForallObj b ↦ fok_form_mentions_parameter b target
  }

fn fok_list_form_any_mentions (xs : List FokForm) (target : FokQTerm) : Bool =
  match xs {
    Nil ↦ False;
    Cons x rest ↦
      fok_or (fok_form_mentions_parameter x target) (fok_list_form_any_mentions rest target)
  }

-- Does `target` occur anywhere in `sequent` (either side)?
fn fok_sequent_mentions_parameter (sequent : FokSequent) (target : FokQTerm) : Bool =
  match sequent {
    FokMkSequent gamma delta ↦
      fok_or (fok_list_form_any_mentions gamma target) (fok_list_form_any_mentions delta target)
  }

-- Substitute the outermost bound `QTerm` variable (index `0`, relative to
-- `depth`) with `replacement`, shrinking every strictly-higher bound index
-- by one -- the `subst0` convention, restated at `FokQTerm`.
fn fok_subst_qterm_at (q : FokQTerm) (depth : Nat) (replacement : FokQTerm) : FokQTerm =
  match q {
    FokQBound i ↦
      match fok_nat_eq i depth {
        True ↦ replacement;
        False ↦
          match fok_nat_lt depth i {
            True ↦ FokQBound (fok_nat_pred i);
            False ↦ FokQBound i
          }
      };
    FokQParameter p ↦ FokQParameter p
  }

fn fok_subst_form_at (form : FokForm) (depth : Nat) (replacement : FokQTerm) : FokForm =
  match form {
    FokBottom ↦ FokBottom;
    FokAccess a b ↦
      FokAccess (fok_subst_qterm_at a depth replacement) (fok_subst_qterm_at b depth replacement);
    FokDomainA a b ↦
      FokDomainA (fok_subst_qterm_at a depth replacement) (fok_subst_qterm_at b depth replacement);
    FokForcingP a b ↦
      FokForcingP (fok_subst_qterm_at a depth replacement) (fok_subst_qterm_at b depth replacement);
    FokAnd p q ↦
      FokAnd (fok_subst_form_at p depth replacement) (fok_subst_form_at q depth replacement);
    FokOr p q ↦
      FokOr (fok_subst_form_at p depth replacement) (fok_subst_form_at q depth replacement);
    FokImp p q ↦
      FokImp (fok_subst_form_at p depth replacement) (fok_subst_form_at q depth replacement);
    FokForallWorld b ↦ FokForallWorld (fok_subst_form_at b (Suc depth) replacement);
    FokForallObj b ↦ FokForallObj (fok_subst_form_at b (Suc depth) replacement)
  }

fn fok_subst0_form (form : FokForm) (replacement : FokQTerm) : FokForm =
  fok_subst_form_at form Zero replacement

-- Derived only while validating a complete certificate. The target syntax
-- stays untagged; positions and binders determine these two sorts.
data FokDerivedSort = FokWorldSort | FokObjectSort

data FokParameterSort = FokMkParameterSort Nat FokDerivedSort

fn fok_derived_sort_eq (a : FokDerivedSort) (b : FokDerivedSort) : Bool =
  match a {
    FokWorldSort ↦
      match b {
        FokWorldSort ↦ True;
        FokObjectSort ↦ False
      };
    FokObjectSort ↦
      match b {
        FokWorldSort ↦ False;
        FokObjectSort ↦ True
      }
  }

fn fok_nth_derived_sort (xs : List FokDerivedSort) (index : Nat) : Option FokDerivedSort =
  match xs {
    Nil ↦ None FokDerivedSort;
    Cons x rest ↦
      match index {
        Zero ↦ Some FokDerivedSort x;
        Suc previous ↦ fok_nth_derived_sort rest previous
      }
  }

fn fok_parameter_sort_prepend
      (head : FokParameterSort) (outcome : Option (List FokParameterSort))
    : Option (List FokParameterSort) =
  match outcome {
    None ↦ None (List FokParameterSort);
    Some rest ↦ Some (List FokParameterSort) (Cons FokParameterSort head rest)
  }

fn fok_constrain_parameter_sort
      (parameter : Nat) (expected : FokDerivedSort) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match constraints {
    Nil ↦
      Some
        (List FokParameterSort)
        (Cons FokParameterSort (FokMkParameterSort parameter expected) (Nil FokParameterSort));
    Cons constraint rest ↦
      match constraint {
        FokMkParameterSort existing actual ↦
          match fok_nat_eq parameter existing {
            True ↦
              match fok_derived_sort_eq expected actual {
                True ↦ Some (List FokParameterSort) constraints;
                False ↦ None (List FokParameterSort)
              };
            False ↦
              fok_parameter_sort_prepend
                constraint
                (fok_constrain_parameter_sort parameter expected rest)
          }
      }
  }

fn fok_validate_qterm_sort
      (term : FokQTerm)
      (expected : FokDerivedSort)
      (binders : List FokDerivedSort)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match term {
    FokQBound index ↦
      match fok_nth_derived_sort binders index {
        None ↦ None (List FokParameterSort);
        Some actual ↦
          match fok_derived_sort_eq expected actual {
            True ↦ Some (List FokParameterSort) constraints;
            False ↦ None (List FokParameterSort)
          }
      };
    FokQParameter parameter ↦ fok_constrain_parameter_sort parameter expected constraints
  }

fn fok_validate_second_qterm
      (first : Option (List FokParameterSort))
      (second : FokQTerm)
      (second_sort : FokDerivedSort)
      (binders : List FokDerivedSort)
    : Option (List FokParameterSort) =
  match first {
    None ↦ None (List FokParameterSort);
    Some constraints ↦ fok_validate_qterm_sort second second_sort binders constraints
  }

fn fok_validate_qterm_pair
      (first : FokQTerm)
      (first_sort : FokDerivedSort)
      (second : FokQTerm)
      (second_sort : FokDerivedSort)
      (binders : List FokDerivedSort)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  fok_validate_second_qterm
    (fok_validate_qterm_sort first first_sort binders constraints)
    second
    second_sort
    binders

fn fok_validate_second_form
      (first : Option (List FokParameterSort))
      (second : FokForm)
      (binders : List FokDerivedSort)
    : Option (List FokParameterSort) =
  match first {
    None ↦ None (List FokParameterSort);
    Some constraints ↦ fok_validate_form second binders constraints
  }

fn fok_validate_form_pair
      (first : FokForm)
      (second : FokForm)
      (binders : List FokDerivedSort)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  fok_validate_second_form (fok_validate_form first binders constraints) second binders

fn fok_validate_form
      (form : FokForm) (binders : List FokDerivedSort) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match form {
    FokBottom ↦ Some (List FokParameterSort) constraints;
    FokAccess first second ↦
      fok_validate_qterm_pair first FokWorldSort second FokWorldSort binders constraints;
    FokDomainA world object ↦
      fok_validate_qterm_pair world FokWorldSort object FokObjectSort binders constraints;
    FokForcingP world object ↦
      fok_validate_qterm_pair world FokWorldSort object FokObjectSort binders constraints;
    FokAnd first second ↦ fok_validate_form_pair first second binders constraints;
    FokOr first second ↦ fok_validate_form_pair first second binders constraints;
    FokImp first second ↦ fok_validate_form_pair first second binders constraints;
    FokForallWorld body ↦
      fok_validate_form body (Cons FokDerivedSort FokWorldSort binders) constraints;
    FokForallObj body ↦
      fok_validate_form body (Cons FokDerivedSort FokObjectSort binders) constraints
  }

fn fok_validate_form_list
      (forms : List FokForm) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match forms {
    Nil ↦ Some (List FokParameterSort) constraints;
    Cons form rest ↦
      match fok_validate_form form (Nil FokDerivedSort) constraints {
        None ↦ None (List FokParameterSort);
        Some next ↦ fok_validate_form_list rest next
      }
  }

fn fok_validate_sequent
      (sequent : FokSequent) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match sequent {
    FokMkSequent gamma delta ↦
      match fok_validate_form_list gamma constraints {
        None ↦ None (List FokParameterSort);
        Some next ↦ fok_validate_form_list delta next
      }
  }

fn fok_validate_forall_eigen
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match fok_nth_form delta right {
    None ↦ None (List FokParameterSort);
    Some target ↦
      match target {
        FokForallWorld body ↦
          fok_validate_qterm_sort eigen FokWorldSort (Nil FokDerivedSort) constraints;
        FokForallObj body ↦
          fok_validate_qterm_sort eigen FokObjectSort (Nil FokDerivedSort) constraints;
        FokBottom ↦ None (List FokParameterSort);
        FokAccess a b ↦ None (List FokParameterSort);
        FokDomainA a b ↦ None (List FokParameterSort);
        FokForcingP a b ↦ None (List FokParameterSort);
        FokAnd p q ↦ None (List FokParameterSort);
        FokOr p q ↦ None (List FokParameterSort);
        FokImp p q ↦ None (List FokParameterSort)
      }
  }

fn fok_validate_rule_side
      (conclusion : FokSequent) (rule : FokRule) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match rule {
    FokInit left right ↦ Some (List FokParameterSort) constraints;
    FokImpRight right ↦ Some (List FokParameterSort) constraints;
    FokForallRight right eigen ↦
      match conclusion {
        FokMkSequent gamma delta ↦
          fok_validate_forall_eigen delta right (FokQParameter eigen) constraints
      }
  }

fn fok_validate_certificate_after_children
      (node_result : Option (List FokParameterSort)) (children : List FokCert)
    : Option (List FokParameterSort) =
  match node_result {
    None ↦ None (List FokParameterSort);
    Some constraints ↦ fok_validate_certificate_list children constraints
  }

fn fok_validate_certificate_list
      (certificates : List FokCert) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match certificates {
    Nil ↦ Some (List FokParameterSort) constraints;
    Cons certificate rest ↦
      match fok_validate_certificate certificate constraints {
        None ↦ None (List FokParameterSort);
        Some next ↦ fok_validate_certificate_list rest next
      }
  }

fn fok_validate_certificate
      (node : FokCert) (constraints : List FokParameterSort)
    : Option (List FokParameterSort) =
  match node {
    FokMkCert conclusion rule children ↦
      match fok_validate_sequent conclusion constraints {
        None ↦ None (List FokParameterSort);
        Some after_conclusion ↦
          fok_validate_certificate_after_children
            (fok_validate_rule_side conclusion rule after_conclusion)
            children
      }
  }

-- The `ForallRight` freshness/child guard -- freshness, then
-- exactly-one-child, then recurse on the instantiated child sequent. It is
-- SHARED by both binder kinds and the World-vs-Object distinction lives
-- elsewhere: `fok_check_rule` dispatches `FokForallWorld` and `FokForallObj`
-- targets to SEPARATE arms (mirroring Rust's now-split
-- `Form::ForallWorld(b) => b` and `Form::ForallObj(b) => b` arms of
-- `check_tree_structural`, `V3-FO-SORTED-EIGENPARAMETER-DERIVATION` `D1`), and
-- the eigenparameter's SORT is demanded per binder kind by the separate
-- derived-sort validation pass (`fok_validate_forall_eigen`). This guard runs
-- on the structural side with sortedness already established, so it is
-- sort-agnostic: freshness and the single-child recurrence are identical for a
-- world eigen and an object eigen.
fn fok_check_forall_right
      (conclusion : FokSequent) (gamma : List FokForm) (delta : List FokForm)
      (right : Nat) (eigen : FokQTerm) (body : FokForm) (children : List FokCert)
    : Bool =
  match fok_sequent_mentions_parameter conclusion eigen {
    True ↦ False;
    False ↦
      match children {
        Nil ↦ False;
        Cons child rest ↦
          match rest {
            Cons c2 rest2 ↦ False;
            Nil ↦
              fok_check_tree_structural
                (FokMkSequent gamma (fok_list_form_set_nth delta right (fok_subst0_form body eigen)))
                child
          }
      }
  }

-- Dispatch on the certificate's rule, given its (already conclusion-matched)
-- `gamma`/`delta` and `children`.
fn fok_check_rule (gamma : List FokForm) (delta : List FokForm) (rule : FokRule) (children : List FokCert) : Bool =
  match rule {
    FokInit left right ↦
      match children {
        Cons c rest ↦ False;
        Nil ↦
          match fok_nth_form gamma left {
            None ↦ False;
            Some g ↦
              match fok_nth_form delta right {
                None ↦ False;
                Some d ↦ fok_form_eq g d
              }
          }
      };
    FokImpRight right ↦
      match fok_nth_form delta right {
        None ↦ False;
        Some target ↦
          match target {
            FokBottom ↦ False;
            FokAccess a b ↦ False;
            FokDomainA a b ↦ False;
            FokForcingP a b ↦ False;
            FokAnd p q ↦ False;
            FokOr p q ↦ False;
            FokImp p q ↦
              match children {
                Nil ↦ False;
                Cons child rest ↦
                  match rest {
                    Cons c2 rest2 ↦ False;
                    Nil ↦
                      fok_check_tree_structural
                        (FokMkSequent (fok_list_form_append_one gamma p) (fok_list_form_set_nth delta right q))
                        child
                  }
              };
            FokForallWorld b ↦ False;
            FokForallObj b ↦ False
          }
      };
    FokForallRight right eigen ↦
      match fok_nth_form delta right {
        None ↦ False;
        Some target ↦
          match target {
            FokBottom ↦ False;
            FokAccess a b ↦ False;
            FokDomainA a b ↦ False;
            FokForcingP a b ↦ False;
            FokAnd p q ↦ False;
            FokOr p q ↦ False;
            FokImp p q ↦ False;
            FokForallWorld body ↦
              fok_check_forall_right
                (FokMkSequent gamma delta) gamma delta right (FokQParameter eigen) body children;
            FokForallObj body ↦
              fok_check_forall_right
                (FokMkSequent gamma delta) gamma delta right (FokQParameter eigen) body children
          }
      }
  }

fn fok_check_tree_structural (expected_conclusion : FokSequent) (node : FokCert) : Bool =
  match node {
    FokMkCert conclusion rule children ↦
      match fok_sequent_eq conclusion expected_conclusion {
        False ↦ False;
        True ↦
          match conclusion {
            FokMkSequent gamma delta ↦ fok_check_rule gamma delta rule children
          }
      }
  }

fn fok_validate_certificate_bool (node : FokCert) : Bool =
  match fok_validate_certificate node (Nil FokParameterSort) {
    None ↦ False;
    Some constraints ↦ True
  }

-- Validation is a monotonic adapter around the unchanged calculus checker.
-- One constraint environment covers the complete stored certificate tree.
fn fok_check_tree (expected_conclusion : FokSequent) (node : FokCert) : Bool =
  fok_and
    (fok_validate_certificate_bool node)
    (fok_check_tree_structural expected_conclusion node)

-- `check_cert : FokForm -> FokCert -> Bool` (23 section 4.3), restricted to
-- the slice's three rules -- an ordinary kernel-checked total function,
-- distinct from the kernel API `check` (`seed-prover.md:49-50`). Mirrors
-- `fo_kripke::check_cert`.
fn fok_check_cert (q : FokForm) (pi : FokCert) : Bool =
  fok_check_tree (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm))) pi

-- === D1a: indexed derivations (23 section 4.3) ===
--
-- The four constructors are the proof-relevant reflection of exactly the
-- branches accepted by `fok_check_rule`: Init, ImpRight, and the World/Obj
-- conclusion shapes of ForallRight. A recursive premise represents the one
-- child required by the corresponding checker branch; Init has none. The
-- lookup equalities expose the same selected principal occurrences, and both
-- ForallRight constructors carry `fok_check_forall_right`'s freshness guard.
data FokDerivation : FokSequent → Type where {
  FokDerivInit :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (left : Nat)
    → (right : Nat)
    → (g : FokForm)
    → (d : FokForm)
    → Equal (Option FokForm) (fok_nth_form gamma left) (Some FokForm g)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm d)
    → Equal Bool (fok_form_eq g d) True
    → FokDerivation (FokMkSequent gamma delta);
  FokDerivImpRight :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (right : Nat)
    → (p : FokForm)
    → (q : FokForm)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokImp p q))
    → FokDerivation
      (FokMkSequent (fok_list_form_append_one gamma p) (fok_list_form_set_nth delta right q))
    → FokDerivation (FokMkSequent gamma delta);
  FokDerivForallWorldRight :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (right : Nat)
    → (eigen : Nat)
    → (body : FokForm)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokForallWorld body))
    → Equal Bool
        (fok_sequent_mentions_parameter (FokMkSequent gamma delta) (FokQParameter eigen)) False
    → FokDerivation
      (FokMkSequent gamma
        (fok_list_form_set_nth delta right (fok_subst0_form body (FokQParameter eigen))))
    → FokDerivation (FokMkSequent gamma delta);
  FokDerivForallObjRight :
    (gamma : List FokForm)
    → (delta : List FokForm)
    → (right : Nat)
    → (eigen : Nat)
    → (body : FokForm)
    → Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokForallObj body))
    → Equal Bool
        (fok_sequent_mentions_parameter (FokMkSequent gamma delta) (FokQParameter eigen)) False
    → FokDerivation
      (FokMkSequent gamma
        (fok_list_form_set_nth delta right (fok_subst0_form body (FokQParameter eigen))))
    → FokDerivation (FokMkSequent gamma delta)
}

-- The proof-relevant rule tree lives in `Type`; its propositional reflection
-- is the truncation required by 23 section 4.3. Classical validity means
-- derivability from the empty antecedent to the singleton conclusion.
fn fok_derives (s : FokSequent) : Omega = ‖FokDerivation s‖

fn fok_classically_valid (q : FokForm) : Omega =
  fok_derives (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm)))

-- The D1 adequacy statement. Its kernel-checked proof is the following
-- increment; this proposition adds no assumption or trusted declaration.
fn fok_embedding_adequacy_statement
    (sigma : FokSignature)
    (c : FokCarriers sigma)
    (rho : FokAtomEnv sigma c)
    (f : FokScopedIForm sigma Zero)
    : Omega =
  fok_classically_valid (fok_scoped_embed sigma f)
    -> fok_denote sigma c rho f

-- === D2: Bool-inversion infrastructure (23 section 4.3) ===
--
-- `checker_soundness`'s proof needs to invert the Bool verdicts
-- `fok_check_rule` accepts on back into operand-level facts. Neither
-- `fok_and` nor `fok_or` is called directly by `fok_check_rule`
-- (`:572`-`:633`) -- the polarity census below traces the ACTUAL routes,
-- corrected from this section's own first draft, which claimed a direct
-- call that a full read of `fok_check_rule`'s span does not support.
--
-- `fok_and` reaches checker acceptance through the six compound arms of
-- `fok_form_eq` (`:352`, `:365`, `:378`, `:391`, `:404`, `:417`), which
-- call `fok_qterm_eq` only as a leaf where appropriate. `FokInit`'s guard
-- consumes `fok_form_eq g d` at `= True`, so `fok_and_left` and
-- `fok_and_right` below invert the `= True` case.
--
-- `fok_or` reaches the checker only through `fok_form_mentions_parameter`
-- (`:480`), `fok_list_form_any_mentions` (`:493`), and
-- `fok_sequent_mentions_parameter` (`:501`) -- the freshness chain -- whose
-- sole external consumer is `fok_check_forall_right`'s guard (`:554`):
-- `match fok_sequent_mentions_parameter conclusion eigen { True -> False;
-- False -> ... }`. On every path where the checker ACCEPTS a `ForallRight`
-- step, that `or`-built chain is `False`, not `True`. Hence
-- `fok_or_left_false`/`fok_or_right_false` below invert the `= False` case
-- -- the polarity the checker actually produces.
--
-- No `and = False` eliminator is needed by checker soundness: accepted
-- ForallRight produces the `or`-built freshness chain at `= False`, while
-- accepted Init produces form equality at `= True`. An `or = True`
-- eliminator likewise has no checker consumer; `fok_or_elim` remains a
-- general proved helper rather than part of the soundness route.
--
-- Every lemma case-splits on exactly the variable `fok_and`/`fok_or`'s own
-- definitions scrutinize (`a`), with its equality hypothesis relegated to
-- the RETURN type's `Pi`-chain -- the only signature shape that elaborates
-- (`D0` part (3), re-confirmed below by the naive pre-bound counterexample
-- for each lemma).

-- `Equal Bool (fok_and a b) True -> Equal Bool a True`. True branch:
-- `fok_and True b` reduces to `b`, so the goal is
-- `Equal Bool b True -> Equal Bool True True` and `h` is unused -- `a = True`
-- is already the conclusion. False branch: `fok_and False b` reduces to
-- `False`, so the goal is `Equal Bool False True -> Equal Bool False True`,
-- the hypothesis IS the conclusion.
theorem fok_and_left (a : Bool) (b : Bool)
    : Equal Bool (fok_and a b) True -> Equal Bool a True =
  match a {
    True ↦ λh. Proved;
    False ↦ λh. h
  }

-- `Equal Bool (fok_and a b) True -> Equal Bool b True`, the partner
-- projection. True branch: `fok_and True b` reduces to `b`, so the goal is
-- `Equal Bool b True -> Equal Bool b True` -- the hypothesis IS the
-- conclusion. False branch: `fok_and False b` reduces to `False`, so `h` has
-- the absurd type `Equal Bool False True`, discharging any target.
theorem fok_and_right (a : Bool) (b : Bool)
    : Equal Bool (fok_and a b) True -> Equal Bool b True =
  match a {
    True ↦ λh. h;
    False ↦ λh. absurd h
  }

-- `Equal Bool (fok_or a b) False -> Equal Bool a False` -- the polarity
-- `fok_check_forall_right` actually produces on acceptance. True branch:
-- `fok_or True b` reduces to `True`, so `h` has the absurd type
-- `Equal Bool True False`, discharging any target (here, coincidentally,
-- the same shape the goal already has -- `absurd h` is used regardless, so
-- this case reads as impossible rather than as an accidental identity).
-- False branch: `fok_or False b` reduces to `b`, so the goal
-- `Equal Bool b False -> Equal Bool False False` holds by `Proved`
-- independent of `h`.
theorem fok_or_left_false (a : Bool) (b : Bool)
    : Equal Bool (fok_or a b) False -> Equal Bool a False =
  match a {
    True ↦ λh. absurd h;
    False ↦ λh. Proved
  }

-- `Equal Bool (fok_or a b) False -> Equal Bool b False`, the partner
-- projection. True branch: `fok_or True b` reduces to `True`, so `h` is
-- again the absurd `Equal Bool True False`, discharging any target. False
-- branch: `fok_or False b` reduces to `b`, so the goal
-- `Equal Bool b False -> Equal Bool b False` is the hypothesis itself.
theorem fok_or_right_false (a : Bool) (b : Bool)
    : Equal Bool (fok_or a b) False -> Equal Bool b False =
  match a {
    True ↦ λh. absurd h;
    False ↦ λh. h
  }

-- `fok_or`'s `= True` disjunction eliminator: a continuation-passing case
-- analysis into an arbitrary Type-sorted result `target` (proof-relevant,
-- so `fn`, not `theorem` -- the overall Pi ends in the bound
-- `target : Type`, not in an `Omega`-classified `Equal`). A true,
-- kernel-checked lemma kept for completeness -- NOT because the checker
-- consumes an `or = True` hypothesis anywhere (it does not; see the
-- polarity census above). Only `a` (the case-split variable) is pre-bound
-- alongside `b`/`target`, which the match does not refine; the hypothesis
-- and both continuations mention `a`/`b` and sit in the return type's
-- `Pi`-chain, exactly like the `theorem`s above. True branch: `fok_or True
-- b` reduces to `True`, so `h : Equal Bool True True` feeds `ka` directly.
-- False branch: `fok_or False b` reduces to `b`, so `h : Equal Bool b True`
-- feeds `kb` directly.
fn fok_or_elim (a : Bool) (b : Bool) (target : Type)
    : Equal Bool (fok_or a b) True ->
      (Equal Bool a True -> target) -> (Equal Bool b True -> target) -> target =
  match a {
    True ↦ λh. λka. λkb. ka h;
    False ↦ λh. λka. λkb. kb h
  }

-- === D3/D4: checker soundness (23 section 4.4) ===
--
-- D3 introduced this full-tree classifier for its Init/ImpRight partition
-- without introducing a parallel certificate type. D4 retains it as a durable
-- description of that partition, while the full proof below no longer needs
-- the classifier as a hypothesis.
fn fok_rule_is_not_forall_right (rule : FokRule) : Bool =
  match rule {
    FokInit left right ↦ True;
    FokImpRight right ↦ True;
    FokForallRight right eigen ↦ False
  }

fn fok_cert_no_forall_right (pi : FokCert) : Bool =
  match pi {
    FokMkCert conclusion rule children ↦
      fok_and
        (fok_rule_is_not_forall_right rule)
        (fok_cert_children_all_no_forall_right children)
  }

fn fok_cert_children_all_no_forall_right (children : List FokCert) : Bool =
  match children {
    Nil ↦ True;
    Cons child rest ↦
      fok_and
        (fok_cert_no_forall_right child)
        (fok_cert_children_all_no_forall_right rest)
  }

-- Boolean equality results become kernel equalities before checker evidence is
-- transported across a stored conclusion. These helpers follow the actual
-- equality-checker call chain rather than assuming boolean reflection.
theorem fok_cong
      (a : Type) (b : Type) (x : a) (y : a) (f : a → b) (same : Equal a x y)
    : Equal b (f x) (f y) =
  J (λy2 _. Equal b (f x) (f y2)) Refl same

theorem fok_cong2
      (a : Type)
      (b : Type)
      (c : Type)
      (x1 : a)
      (y1 : a)
      (x2 : b)
      (y2 : b)
      (f : a → b → c)
      (same1 : Equal a x1 y1)
      (same2 : Equal b x2 y2)
    : Equal c (f x1 x2) (f y1 y2) =
  J
    (λy1b _. Equal c (f x1 x2) (f y1b y2))
    (J (λy2b _. Equal c (f x1 x2) (f x1 y2b)) Refl same2)
    same1

theorem fok_nat_eq_sound (a : Nat)
    : (b : Nat) → Equal Bool (fok_nat_eq a b) True → Equal Nat a b =
  match a {
    Zero ↦
      λb.
        match b {
          Zero ↦ λh. Proved;
          Suc j ↦ λh. absurd h
        };
    Suc i ↦
      λb.
        match b {
          Zero ↦ λh. absurd h;
          Suc j ↦
            λh.
              fok_cong Nat Nat i j (λn. Suc n) (fok_nat_eq_sound i j h)
        }
  }

theorem fok_qterm_eq_sound (a : FokQTerm)
    : (b : FokQTerm) →
      Equal Bool (fok_qterm_eq a b) True → Equal FokQTerm a b =
  match a {
    FokQBound i ↦
      λb.
        match b {
          FokQBound j ↦
            λh.
              fok_cong
                Nat FokQTerm i j (λn. FokQBound n) (fok_nat_eq_sound i j h);
          FokQParameter j ↦ λh. absurd h
        };
    FokQParameter i ↦
      λb.
        match b {
          FokQBound j ↦ λh. absurd h;
          FokQParameter j ↦
            λh.
              fok_cong
                Nat FokQTerm i j (λn. FokQParameter n) (fok_nat_eq_sound i j h)
        }
  }

theorem fok_form_eq_sound (a : FokForm)
    : (b : FokForm) →
      Equal Bool (fok_form_eq a b) True → Equal FokForm a b =
  match a {
    FokBottom ↦
      λb.
        match b {
          FokBottom ↦ λh. Proved;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokAccess a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦
            λh.
              fok_cong2 FokQTerm FokQTerm FokForm a1 b1 a2 b2
                (λx. λy. FokAccess x y)
                (fok_qterm_eq_sound a1 b1
                  (fok_and_left (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h))
                (fok_qterm_eq_sound a2 b2
                  (fok_and_right (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h));
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokDomainA a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦
            λh.
              fok_cong2 FokQTerm FokQTerm FokForm a1 b1 a2 b2
                (λx. λy. FokDomainA x y)
                (fok_qterm_eq_sound a1 b1
                  (fok_and_left (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h))
                (fok_qterm_eq_sound a2 b2
                  (fok_and_right (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h));
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokForcingP a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦
            λh.
              fok_cong2 FokQTerm FokQTerm FokForm a1 b1 a2 b2
                (λx. λy. FokForcingP x y)
                (fok_qterm_eq_sound a1 b1
                  (fok_and_left (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h))
                (fok_qterm_eq_sound a2 b2
                  (fok_and_right (fok_qterm_eq a1 b1) (fok_qterm_eq a2 b2) h));
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokAnd a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦
            λh.
              fok_cong2 FokForm FokForm FokForm a1 b1 a2 b2
                (λx. λy. FokAnd x y)
                (fok_form_eq_sound a1 b1
                  (fok_and_left (fok_form_eq a1 b1) (fok_form_eq a2 b2) h))
                (fok_form_eq_sound a2 b2
                  (fok_and_right (fok_form_eq a1 b1) (fok_form_eq a2 b2) h));
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokOr a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦
            λh.
              fok_cong2 FokForm FokForm FokForm a1 b1 a2 b2
                (λx. λy. FokOr x y)
                (fok_form_eq_sound a1 b1
                  (fok_and_left (fok_form_eq a1 b1) (fok_form_eq a2 b2) h))
                (fok_form_eq_sound a2 b2
                  (fok_and_right (fok_form_eq a1 b1) (fok_form_eq a2 b2) h));
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokImp a1 a2 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦
            λh.
              fok_cong2 FokForm FokForm FokForm a1 b1 a2 b2
                (λx. λy. FokImp x y)
                (fok_form_eq_sound a1 b1
                  (fok_and_left (fok_form_eq a1 b1) (fok_form_eq a2 b2) h))
                (fok_form_eq_sound a2 b2
                  (fok_and_right (fok_form_eq a1 b1) (fok_form_eq a2 b2) h));
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦ λh. absurd h
        };
    FokForallWorld a1 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦
            λh.
              fok_cong FokForm FokForm a1 b1
                (λx. FokForallWorld x) (fok_form_eq_sound a1 b1 h);
          FokForallObj b1 ↦ λh. absurd h
        };
    FokForallObj a1 ↦
      λb.
        match b {
          FokBottom ↦ λh. absurd h;
          FokAccess b1 b2 ↦ λh. absurd h;
          FokDomainA b1 b2 ↦ λh. absurd h;
          FokForcingP b1 b2 ↦ λh. absurd h;
          FokAnd b1 b2 ↦ λh. absurd h;
          FokOr b1 b2 ↦ λh. absurd h;
          FokImp b1 b2 ↦ λh. absurd h;
          FokForallWorld b1 ↦ λh. absurd h;
          FokForallObj b1 ↦
            λh.
              fok_cong FokForm FokForm a1 b1
                (λx. FokForallObj x) (fok_form_eq_sound a1 b1 h)
        }
  }

fn fok_list_form_eq_cons_result
      (x : FokForm)
      (rest : List FokForm)
      (y : FokForm)
      (ys2 : List FokForm)
      (head_result : Bool)
    : Omega =
  Equal Bool
    (match head_result {
      True ↦ fok_list_form_eq rest ys2;
      False ↦ False
    })
    True

theorem fok_list_form_eq_sound_cons
      (x : FokForm)
      (rest : List FokForm)
      (y : FokForm)
      (ys2 : List FokForm)
      (ih : (ys : List FokForm) →
        Equal Bool (fok_list_form_eq rest ys) True → Equal (List FokForm) rest ys)
    : fok_list_form_eq_cons_result x rest y ys2 (fok_form_eq x y) →
      Equal (List FokForm) (Cons FokForm x rest) (Cons FokForm y ys2) =
  match fok_form_eq x y eqn : head_true {
    True ↦
      λh.
        J
          (λy2 _.
            Equal (List FokForm)
              (Cons FokForm x rest)
              (Cons FokForm y2 ys2))
          (fok_cong
            (List FokForm)
            (List FokForm)
            rest
            ys2
            (λtail. Cons FokForm x tail)
            (ih ys2 h))
          (fok_form_eq_sound x y head_true);
    False ↦ λh. absurd h
  }

theorem fok_list_form_eq_sound (xs : List FokForm)
    : (ys : List FokForm) →
      Equal Bool (fok_list_form_eq xs ys) True → Equal (List FokForm) xs ys =
  match xs {
    Nil ↦
      λys.
        match ys {
          Nil ↦ λh. Proved;
          Cons y rest ↦ λh. absurd h
        };
    Cons x rest ↦
      λys.
        match ys {
          Nil ↦ λh. absurd h;
          Cons y ys2 ↦
            fok_list_form_eq_sound_cons
              x rest y ys2 (fok_list_form_eq_sound rest)
        }
  }

theorem fok_sequent_eq_sound_fields
      (gamma : List FokForm)
      (delta : List FokForm)
      (gamma2 : List FokForm)
      (delta2 : List FokForm)
      (gamma_same : Equal (List FokForm) gamma gamma2)
      (delta_same : Equal (List FokForm) delta delta2)
    : Equal FokSequent
      (FokMkSequent gamma delta) (FokMkSequent gamma2 delta2) =
  J
    (λgamma3 _.
      Equal FokSequent
        (FokMkSequent gamma delta)
        (FokMkSequent gamma3 delta2))
    (J
      (λdelta3 _.
        Equal FokSequent
          (FokMkSequent gamma delta)
          (FokMkSequent gamma delta3))
      (Refl, Refl)
      delta_same)
    gamma_same

fn fok_sequent_eq_result
      (gamma : List FokForm)
      (delta : List FokForm)
      (gamma2 : List FokForm)
      (delta2 : List FokForm)
      (gamma_result : Bool)
    : Omega =
  Equal Bool
    (match gamma_result {
      True ↦ fok_list_form_eq delta delta2;
      False ↦ False
    })
    True

theorem fok_sequent_eq_sound_parts
      (gamma : List FokForm)
      (delta : List FokForm)
      (gamma2 : List FokForm)
      (delta2 : List FokForm)
    : fok_sequent_eq_result
        gamma delta gamma2 delta2 (fok_list_form_eq gamma gamma2) →
      Equal FokSequent
        (FokMkSequent gamma delta) (FokMkSequent gamma2 delta2) =
  match fok_list_form_eq gamma gamma2 eqn : gamma_true {
    True ↦
      λh.
        fok_sequent_eq_sound_fields
          gamma delta gamma2 delta2
          (fok_list_form_eq_sound gamma gamma2 gamma_true)
          (fok_list_form_eq_sound delta delta2 h);
    False ↦ λh. absurd h
  }

theorem fok_sequent_eq_sound (a : FokSequent)
    : (b : FokSequent) →
      Equal Bool (fok_sequent_eq a b) True → Equal FokSequent a b =
  match a {
    FokMkSequent gamma delta ↦
      λb.
        match b {
          FokMkSequent gamma2 delta2 ↦
            fok_sequent_eq_sound_parts gamma delta gamma2 delta2
        }
  }

-- The rule proof is total over FokRule. Init and ImpRight reflect their exact
-- checker paths; ForallRight additionally reflects target shape, exact child
-- arity, recursive child acceptance, and the `= False` freshness guard.
fn fok_false_elim (target : Type) (h : Equal Bool False True) : target = absurd h

theorem fok_equal_bool_true_transport
      (a : Bool)
      (b : Bool)
      (ab : Equal Bool a b)
      (a_true : Equal Bool a True)
    : Equal Bool b True =
  J (λb2 _. Equal Bool b2 True) a_true ab

fn fok_init_right_check (g : FokForm) (right_lookup : Option FokForm) : Bool =
  match right_lookup {
    None ↦ False;
    Some d ↦ fok_form_eq g d
  }

fn fok_init_left_check
      (delta : List FokForm)
      (right : Nat)
      (left_lookup : Option FokForm)
    : Bool =
  match left_lookup {
    None ↦ False;
    Some g ↦ fok_init_right_check g (fok_nth_form delta right)
  }

fn fok_prop_init_right_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (g : FokForm)
      (left_lookup : Equal (Option FokForm)
        (fok_nth_form gamma left) (Some FokForm g))
      (right_result : Option FokForm)
    : Equal (Option FokForm) (fok_nth_form delta right) right_result →
      Equal Bool (fok_init_right_check g right_result) True →
      FokDerivation (FokMkSequent gamma delta) =
  match right_result {
    None ↦
      λright_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some d ↦
      λright_lookup. λaccepted.
        FokDerivInit gamma delta left right g d
          left_lookup right_lookup accepted
  }

fn fok_prop_init_left_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (left_result : Option FokForm)
    : Equal (Option FokForm) (fok_nth_form gamma left) left_result →
      Equal Bool (fok_init_left_check delta right left_result) True →
      FokDerivation (FokMkSequent gamma delta) =
  match left_result {
    None ↦
      λleft_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some g ↦
      λleft_lookup. λaccepted.
        fok_prop_init_right_sound
          gamma delta left right g left_lookup
          (fok_nth_form delta right) Refl accepted
  }

fn fok_prop_init_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (children : List FokCert)
    : Equal Bool (fok_check_rule gamma delta (FokInit left right) children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Cons child rest ↦
      λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Nil ↦
      λaccepted.
        fok_prop_init_left_sound
          gamma delta left right (fok_nth_form gamma left) Refl accepted
  }

fn fok_imp_rest_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (child : FokCert)
      (rest : List FokCert)
    : Bool =
  match rest {
    Cons child2 rest2 ↦ False;
    Nil ↦
      fok_check_tree_structural
        (FokMkSequent
          (fok_list_form_append_one gamma p)
          (fok_list_form_set_nth delta right q))
        child
  }

fn fok_imp_children_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (children : List FokCert)
    : Bool =
  match children {
    Nil ↦ False;
    Cons child rest ↦
      fok_imp_rest_check gamma delta right p q child rest
  }

fn fok_imp_form_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target : FokForm)
      (children : List FokCert)
    : Bool =
  match target {
    FokBottom ↦ False;
    FokAccess a b ↦ False;
    FokDomainA a b ↦ False;
    FokForcingP a b ↦ False;
    FokAnd p q ↦ False;
    FokOr p q ↦ False;
    FokImp p q ↦ fok_imp_children_check gamma delta right p q children;
    FokForallWorld body ↦ False;
    FokForallObj body ↦ False
  }

fn fok_imp_lookup_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target_result : Option FokForm)
      (children : List FokCert)
    : Bool =
  match target_result {
    None ↦ False;
    Some target ↦ fok_imp_form_check gamma delta right target children
  }

fn fok_prop_check_tree_sound_type (pi : FokCert) : Type =
  (expected : FokSequent)
    → Equal Bool
    (fok_check_tree_structural expected pi)
    True → FokDerivation expected

-- The recursion result for a child list is the head certificate's soundness
-- proof. Empty lists carry an inert Nat because no checker rule recurs there.
fn fok_prop_children_head_sound_type (children : List FokCert) : Type =
  match children {
    Nil ↦ Nat;
    Cons child rest ↦ fok_prop_check_tree_sound_type child
  }

fn fok_prop_imp_build
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (child_derivation : FokDerivation
        (FokMkSequent
          (fok_list_form_append_one gamma p)
          (fok_list_form_set_nth delta right q)))
    : FokDerivation (FokMkSequent gamma delta) =
  FokDerivImpRight
    gamma delta right p q target_lookup child_derivation

fn fok_prop_imp_build_from_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (child : FokCert)
      (child_sound : fok_prop_check_tree_sound_type child)
    : Equal Bool
        (fok_check_tree_structural
          (FokMkSequent
            (fok_list_form_append_one gamma p)
            (fok_list_form_set_nth delta right q))
          child) True →
      FokDerivation (FokMkSequent gamma delta) =
  λaccepted.
    fok_prop_imp_build gamma delta right p q target_lookup
      (child_sound
        (FokMkSequent
          (fok_list_form_append_one gamma p)
          (fok_list_form_set_nth delta right q))
        accepted)

fn fok_prop_imp_children_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (children : List FokCert)
    : fok_prop_children_head_sound_type children →
      Equal Bool (fok_imp_children_check gamma delta right p q children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Nil ↦
      λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Cons child rest ↦
      λchildren_sound.
        match rest {
          Cons child2 rest2 ↦
            λaccepted.
              fok_false_elim
                (FokDerivation (FokMkSequent gamma delta)) accepted;
          Nil ↦
            fok_prop_imp_build_from_sound
              gamma delta right p q target_lookup child children_sound
        }
  }

fn fok_prop_imp_form_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target : FokForm)
    : (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm target)) →
      (children : List FokCert) →
      (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool (fok_imp_form_check gamma delta right target children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target {
    FokBottom ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAccess a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokDomainA a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForcingP a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAnd p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokOr p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokImp p q ↦
      λtarget_lookup. λchildren. λchildren_sound.
        fok_prop_imp_children_sound
          gamma delta right p q target_lookup children children_sound;
    FokForallWorld body ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForallObj body ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted
  }

fn fok_prop_imp_lookup_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (target_result : Option FokForm)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal (Option FokForm) (fok_nth_form delta right) target_result →
      Equal Bool
        (fok_imp_lookup_check gamma delta right target_result children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target_result {
    None ↦
      λtarget_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some target ↦
      λtarget_lookup.
        fok_prop_imp_form_sound
          gamma delta right target target_lookup children children_sound
  }

fn fok_prop_imp_right_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool (fok_check_rule gamma delta (FokImpRight right) children) True →
      FokDerivation (FokMkSequent gamma delta) =
  fok_prop_imp_lookup_sound
    gamma delta right (fok_nth_form delta right)
    children children_sound Refl

fn fok_forall_form_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (target : FokForm)
      (children : List FokCert)
    : Bool =
  match target {
    FokBottom ↦ False;
    FokAccess a b ↦ False;
    FokDomainA a b ↦ False;
    FokForcingP a b ↦ False;
    FokAnd p q ↦ False;
    FokOr p q ↦ False;
    FokImp p q ↦ False;
    FokForallWorld body ↦
      fok_check_forall_right
        (FokMkSequent gamma delta) gamma delta right eigen body children;
    FokForallObj body ↦
      fok_check_forall_right
        (FokMkSequent gamma delta) gamma delta right eigen body children
  }

fn fok_forall_lookup_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (target_result : Option FokForm)
      (children : List FokCert)
    : Bool =
  match target_result {
    None ↦ False;
    Some target ↦
      fok_forall_form_check gamma delta right eigen target children
  }

fn fok_forall_children_check
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (children : List FokCert)
    : Bool =
  match children {
    Nil ↦ False;
    Cons child rest ↦
      match rest {
        Cons child2 rest2 ↦ False;
        Nil ↦
          fok_check_tree_structural
            (FokMkSequent gamma
              (fok_list_form_set_nth delta right
                (fok_subst0_form body eigen)))
            child
      }
  }

fn fok_forall_fresh_result (child_result : Bool) (fresh : Bool) : Bool =
  match fresh {
    True ↦ False;
    False ↦ child_result
  }

theorem fok_check_forall_right_result_eq
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : FokQTerm)
      (body : FokForm)
      (children : List FokCert)
    : Equal Bool
        (fok_check_forall_right
          (FokMkSequent gamma delta)
          gamma delta right eigen body children)
        (fok_forall_fresh_result
          (fok_forall_children_check
            gamma delta right eigen body children)
          (fok_sequent_mentions_parameter
            (FokMkSequent gamma delta) eigen)) = Refl

theorem fok_forall_fresh_false (child_result : Bool) (fresh : Bool)
    : Equal Bool (fok_forall_fresh_result child_result fresh) True →
      Equal Bool fresh False =
  match fresh {
    True ↦ λaccepted. absurd accepted;
    False ↦ λaccepted. Proved
  }

theorem fok_forall_child_accepted (child_result : Bool) (fresh : Bool)
    : Equal Bool (fok_forall_fresh_result child_result fresh) True →
      Equal Bool child_result True =
  match fresh {
    True ↦ λaccepted. absurd accepted;
    False ↦ λaccepted. accepted
  }

fn fok_forall_world_children_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallWorld body)))
      (fresh : Equal Bool
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) (FokQParameter eigen)) False)
      (children : List FokCert)
    : (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool
        (fok_forall_children_check
          gamma delta right (FokQParameter eigen) body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Nil ↦
      λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Cons child rest ↦
      λchildren_sound.
        match rest {
          Cons child2 rest2 ↦
            λaccepted.
              fok_false_elim
                (FokDerivation (FokMkSequent gamma delta)) accepted;
          Nil ↦
            λaccepted.
              FokDerivForallWorldRight
                gamma delta right eigen body target_lookup fresh
                (children_sound
                  (FokMkSequent gamma
                    (fok_list_form_set_nth delta right
                      (fok_subst0_form body (FokQParameter eigen))))
                  accepted)
        }
  }

fn fok_forall_world_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallWorld body)))
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_forall_right
          (FokMkSequent gamma delta)
          gamma delta right (FokQParameter eigen) body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  λaccepted.
    fok_forall_world_children_sound
      gamma delta right eigen body target_lookup
      (fok_forall_fresh_false
        (fok_forall_children_check
          gamma delta right (FokQParameter eigen) body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) (FokQParameter eigen))
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right (FokQParameter eigen) body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right (FokQParameter eigen) body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) (FokQParameter eigen)))
          (fok_check_forall_right_result_eq
            gamma delta right (FokQParameter eigen) body children)
          accepted))
      children children_sound
      (fok_forall_child_accepted
        (fok_forall_children_check
          gamma delta right (FokQParameter eigen) body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) (FokQParameter eigen))
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right (FokQParameter eigen) body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right (FokQParameter eigen) body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) (FokQParameter eigen)))
          (fok_check_forall_right_result_eq
            gamma delta right (FokQParameter eigen) body children)
          accepted))

fn fok_forall_obj_children_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallObj body)))
      (fresh : Equal Bool
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) (FokQParameter eigen)) False)
      (children : List FokCert)
    : (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool
        (fok_forall_children_check
          gamma delta right (FokQParameter eigen) body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match children {
    Nil ↦
      λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Cons child rest ↦
      λchildren_sound.
        match rest {
          Cons child2 rest2 ↦
            λaccepted.
              fok_false_elim
                (FokDerivation (FokMkSequent gamma delta)) accepted;
          Nil ↦
            λaccepted.
              FokDerivForallObjRight
                gamma delta right eigen body target_lookup fresh
                (children_sound
                  (FokMkSequent gamma
                    (fok_list_form_set_nth delta right
                      (fok_subst0_form body (FokQParameter eigen))))
                  accepted)
        }
  }

fn fok_forall_obj_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (body : FokForm)
      (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm (FokForallObj body)))
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_forall_right
          (FokMkSequent gamma delta)
          gamma delta right (FokQParameter eigen) body children) True →
      FokDerivation (FokMkSequent gamma delta) =
  λaccepted.
    fok_forall_obj_children_sound
      gamma delta right eigen body target_lookup
      (fok_forall_fresh_false
        (fok_forall_children_check
          gamma delta right (FokQParameter eigen) body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) (FokQParameter eigen))
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right (FokQParameter eigen) body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right (FokQParameter eigen) body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) (FokQParameter eigen)))
          (fok_check_forall_right_result_eq
            gamma delta right (FokQParameter eigen) body children)
          accepted))
      children children_sound
      (fok_forall_child_accepted
        (fok_forall_children_check
          gamma delta right (FokQParameter eigen) body children)
        (fok_sequent_mentions_parameter
          (FokMkSequent gamma delta) (FokQParameter eigen))
        (fok_equal_bool_true_transport
          (fok_check_forall_right
            (FokMkSequent gamma delta)
            gamma delta right (FokQParameter eigen) body children)
          (fok_forall_fresh_result
            (fok_forall_children_check
              gamma delta right (FokQParameter eigen) body children)
            (fok_sequent_mentions_parameter
              (FokMkSequent gamma delta) (FokQParameter eigen)))
          (fok_check_forall_right_result_eq
            gamma delta right (FokQParameter eigen) body children)
          accepted))

fn fok_forall_form_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (target : FokForm)
    : (target_lookup : Equal (Option FokForm)
        (fok_nth_form delta right) (Some FokForm target)) →
      (children : List FokCert) →
      (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool
        (fok_forall_form_check gamma delta right (FokQParameter eigen) target children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target {
    FokBottom ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAccess a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokDomainA a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForcingP a b ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokAnd p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokOr p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokImp p q ↦
      λtarget_lookup. λchildren. λchildren_sound. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    FokForallWorld body ↦
      λtarget_lookup. λchildren. λchildren_sound.
        fok_forall_world_sound
          gamma delta right eigen body target_lookup children children_sound;
    FokForallObj body ↦
      λtarget_lookup. λchildren. λchildren_sound.
        fok_forall_obj_sound
          gamma delta right eigen body target_lookup children children_sound
  }

fn fok_forall_lookup_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (target_result : Option FokForm)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal (Option FokForm) (fok_nth_form delta right) target_result →
      Equal Bool
        (fok_forall_lookup_check
          gamma delta right (FokQParameter eigen) target_result children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match target_result {
    None ↦
      λtarget_lookup. λaccepted.
        fok_false_elim (FokDerivation (FokMkSequent gamma delta)) accepted;
    Some target ↦
      λtarget_lookup.
        fok_forall_form_sound
          gamma delta right eigen target target_lookup
          children children_sound
  }

fn fok_forall_right_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_rule
          gamma delta (FokForallRight right eigen) children) True →
      FokDerivation (FokMkSequent gamma delta) =
  fok_forall_lookup_sound
    gamma delta right eigen (fok_nth_form delta right)
    children children_sound Refl

fn fok_prop_check_rule_sound
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
    : (children : List FokCert) →
      (children_sound : fok_prop_children_head_sound_type children) →
      Equal Bool (fok_check_rule gamma delta rule children) True →
      FokDerivation (FokMkSequent gamma delta) =
  match rule {
    FokInit left right ↦
      λchildren. λchildren_sound.
        fok_prop_init_sound gamma delta left right children;
    FokImpRight right ↦
      λchildren. λchildren_sound.
        fok_prop_imp_right_sound
          gamma delta right children children_sound;
    FokForallRight right eigen ↦
      λchildren. λchildren_sound.
        fok_forall_right_sound
          gamma delta right eigen children children_sound
  }

fn fok_matched_conclusion_check
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Bool =
  match conclusion {
    FokMkSequent gamma delta ↦ fok_check_rule gamma delta rule children
  }

fn fok_prop_matched_fields_sound
      (expected : FokSequent)
      (gamma : List FokForm)
      (delta : List FokForm)
      (conclusion_matches : Equal Bool
        (fok_sequent_eq (FokMkSequent gamma delta) expected) True)
      (rule : FokRule)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool (fok_check_rule gamma delta rule children) True →
      FokDerivation expected =
  λaccepted.
    J
      (λexpected2 _. FokDerivation expected2)
      (fok_prop_check_rule_sound
        gamma delta rule children children_sound accepted)
      (fok_sequent_eq_sound
        (FokMkSequent gamma delta) expected conclusion_matches)

fn fok_check_tree_view
      (expected : FokSequent)
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Bool =
  match fok_sequent_eq conclusion expected {
    False ↦ False;
    True ↦ fok_matched_conclusion_check conclusion rule children
  }

theorem fok_check_tree_view_eq
      (expected : FokSequent)
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Equal Bool
        (fok_check_tree_view expected conclusion rule children)
        (fok_check_tree_structural expected (FokMkCert conclusion rule children)) =
  Refl

fn fok_check_tree_result
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
      (conclusion_result : Bool)
    : Bool =
  match conclusion_result {
    False ↦ False;
    True ↦ fok_matched_conclusion_check conclusion rule children
  }

theorem fok_check_tree_result_view_eq
      (expected : FokSequent)
      (conclusion : FokSequent)
      (rule : FokRule)
      (children : List FokCert)
    : Equal Bool
        (fok_check_tree_result conclusion rule children
          (fok_sequent_eq conclusion expected))
        (fok_check_tree_view expected conclusion rule children) = Refl

fn fok_prop_check_tree_result_sound
      (expected : FokSequent)
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
      (conclusion_result : Bool)
    : Equal Bool
        (fok_sequent_eq (FokMkSequent gamma delta) expected)
        conclusion_result →
      Equal Bool
        (fok_check_tree_result
          (FokMkSequent gamma delta) rule children conclusion_result) True →
      FokDerivation expected =
  match conclusion_result {
    False ↦
      λconclusion_matches. λaccepted.
        fok_false_elim (FokDerivation expected) accepted;
    True ↦
      λconclusion_matches.
        fok_prop_matched_fields_sound
          expected gamma delta conclusion_matches
          rule children children_sound
  }

fn fok_prop_check_tree_view_sound
      (expected : FokSequent)
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
      (children : List FokCert)
      (children_sound : fok_prop_children_head_sound_type children)
    : Equal Bool
        (fok_check_tree_view
          expected (FokMkSequent gamma delta) rule children) True →
      FokDerivation expected =
  J
    (λcheck_result _.
      Equal Bool check_result True → FokDerivation expected)
    (fok_prop_check_tree_result_sound
      expected gamma delta rule children children_sound
      (fok_sequent_eq (FokMkSequent gamma delta) expected) Refl)
    (fok_check_tree_result_view_eq
      expected (FokMkSequent gamma delta) rule children)

fn fok_prop_check_tree_sound_by_cert (pi : FokCert)
    : fok_prop_check_tree_sound_type pi =
  match pi {
    FokMkCert conclusion rule children ↦
      match conclusion {
        FokMkSequent gamma delta ↦
          fok_prop_check_tree_sound_by_children
            gamma delta rule children
      }
  }

fn fok_prop_check_tree_sound_by_children
      (gamma : List FokForm)
      (delta : List FokForm)
      (rule : FokRule)
      (children : List FokCert)
    : fok_prop_check_tree_sound_type
        (FokMkCert (FokMkSequent gamma delta) rule children) =
  match children {
    Nil ↦
      λexpected.
        J
          (λcheck_result _.
            Equal Bool check_result True → FokDerivation expected)
          (fok_prop_check_tree_view_sound
            expected gamma delta
            rule (Nil FokCert) Zero)
          (fok_check_tree_view_eq
            expected (FokMkSequent gamma delta)
            rule (Nil FokCert));
    Cons child rest ↦
      λexpected.
        J
          (λcheck_result _.
            Equal Bool check_result True → FokDerivation expected)
          (fok_prop_check_tree_view_sound
            expected gamma delta
            rule (Cons FokCert child rest)
            (fok_prop_check_tree_sound_by_cert child))
          (fok_check_tree_view_eq
            expected (FokMkSequent gamma delta)
            rule (Cons FokCert child rest))
  }

fn fok_prop_check_tree_sound
      (expected : FokSequent) (pi : FokCert)
    : Equal Bool (fok_check_tree_structural expected pi) True → FokDerivation expected =
  fok_prop_check_tree_sound_by_cert pi expected

theorem fok_check_tree_validation_monotonic
      (expected : FokSequent) (pi : FokCert)
    : Equal Bool (fok_check_tree expected pi) True
      → Equal Bool (fok_check_tree_structural expected pi) True =
  fok_and_right (fok_validate_certificate_bool pi) (fok_check_tree_structural expected pi)

-- Reflection closes both ForallRight target shapes and their shared freshness
-- guard, so every accepted certificate is reflected into the indexed
-- derivation. The validation adapter is monotonic: validated acceptance first
-- yields the unchanged calculus checker's acceptance, then the reflection proof.
--
-- `V3-FO-SORTED-EIGENPARAMETER-DERIVATION` `D4` -- the reach of this theorem,
-- stated honestly:
--   * WHAT IT NOW SAYS. `FokDerivation` is generated by the corrected
--     parameter-only sorted rule: `FokDerivForall{World,Obj}Right` take a
--     parameter INDEX and instantiate `FokQParameter eigen` at the binder's
--     sort (world under `FokForallWorld`, object under `FokForallObj`); a bound
--     eigen is UNREPRESENTABLE. Each constructor STATES that rule (its lookup,
--     freshness, and typed instantiation premises); none cites a checker
--     verdict. `fok_checker_soundness` therefore reflects checker acceptance
--     into a derivation of the CORRECTED relation.
--   * WHAT IT DOES NOT SAY. This is a corrected RELATION, not a semantic
--     soundness result. That checker acceptance reflects into `FokDerivation`
--     is not evidence that the reflected rule is semantically lawful. The
--     semantic claim -- that a `FokDerivation` of `fok_embed`'s image entails
--     the object proposition -- is `fok_embedding_adequacy_statement`, proved
--     below by `fok_embedding_adequacy` over this corrected relation. The proof
--     consumes the relation directly; it does not narrow validity to checker
--     output.
--   * VERDICT BOUNDARY UNCHANGED. Route-FO's production verdict is untouched by
--     this node: `attempt_fo_with_signature` still returns the audited
--     `Unknown` (`emit_unknown_hole_fo_withheld`); nothing here returns
--     `proved` for FO or wires the verdict boundary.
theorem fok_checker_soundness (q : FokForm) (pi : FokCert)
    : Equal Bool (fok_check_cert q pi) True → fok_classically_valid q =
  λaccepted.
    trunc_intro
      (fok_prop_check_tree_sound
        (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm)))
        pi
        (fok_check_tree_validation_monotonic
          (FokMkSequent (Nil FokForm) (Cons FokForm q (Nil FokForm)))
          pi
          accepted))

-- === D2b: embedding adequacy proof (23 section 4.4) ===
--
-- Architecture B proves the target slice sound in one canonical one-world
-- model, proves that the forcing translation in that model is the intrinsic
-- source denotation, and composes the two results. It consumes every inhabitant
-- of `fok_classically_valid`, including directly constructed derivations. The
-- failed bare-form ledger and assignment scaffolding is deliberately absent.
-- Target parameters are de Bruijn levels. A level slot records its sort and,
-- for an object slot, its carrier value. Levels are stable when another slot is
-- filled; an absent level is explicit and cannot invent a carrier inhabitant.
data FokLevelSlot (a : Type) : Type where {
  FokLevelUnused : FokLevelSlot a;
  FokLevelWorld : FokLevelSlot a;
  FokLevelObject : a → FokLevelSlot a
}

-- A level context is positional: the target parameter number is its level.
-- The total resolver returns `Unused` outside the grown prefix, so even an
-- empty object carrier needs no invented default value.
data FokLevelContext (a : Type) : Type 1 where {
  FokMkLevelContext : (Nat → FokLevelSlot a) → FokLevelContext a
}

fn fok_level_lookup (a : Type) (levels : FokLevelContext a) (i : Nat) : FokLevelSlot a =
  match levels {
    FokMkLevelContext resolve ↦ resolve i
  }

const fok_level_empty (a : Type) : FokLevelContext a =
  FokMkLevelContext a (λi. FokLevelUnused a)

-- Filling a fresh target level is a stable positional extension: every other
-- level resolves through the prior context unchanged.
fn fok_level_set
      (a : Type) (levels : FokLevelContext a) (i : Nat) (slot : FokLevelSlot a)
    : FokLevelContext a =
  match levels {
    FokMkLevelContext resolve ↦
      FokMkLevelContext
        a
        (λkey.
          match fok_nat_eq key i {
            True ↦ slot;
            False ↦ resolve key
          })
  }

data FokBoundContext (a : Type) : Type 1 where {
  FokBoundNil : FokBoundContext a;
  FokBoundCons : FokLevelSlot a → FokBoundContext a → FokBoundContext a
}

fn fok_bound_lookup (a : Type) (bound : FokBoundContext a) (i : Nat) : FokLevelSlot a =
  match bound {
    FokBoundNil ↦ FokLevelUnused a;
    FokBoundCons head rest ↦
      match i {
        Zero ↦ head;
        Suc j ↦ fok_bound_lookup a rest j
      }
  }

const fok_bound_empty (a : Type) : FokBoundContext a = FokBoundNil a

fn fok_bound_insert
      (a : Type) (bound : FokBoundContext a) (depth : Nat) (slot : FokLevelSlot a)
    : FokBoundContext a =
  match depth {
    Zero ↦ FokBoundCons a slot bound;
    Suc j ↦
      match bound {
        FokBoundNil ↦
          FokBoundCons a (FokLevelUnused a) (fok_bound_insert a (FokBoundNil a) j slot);
        FokBoundCons head rest ↦ FokBoundCons a head (fok_bound_insert a rest j slot)
      }
  }

fn fok_bound_push
      (a : Type) (slot : FokLevelSlot a) (bound : FokBoundContext a)
    : FokBoundContext a =
  FokBoundCons a slot bound

fn fok_slot_object (a : Type) (slot : FokLevelSlot a) : Option a =
  match slot {
    FokLevelUnused ↦ None a;
    FokLevelWorld ↦ None a;
    FokLevelObject x ↦ Some a x
  }

-- Bound variables use ordinary de Bruijn indices into `bound`; free target
-- eigenparameters use stable levels into `levels`.
fn fok_qobject_value
      (a : Type) (levels : FokLevelContext a) (bound : FokBoundContext a) (q : FokQTerm)
    : Option a =
  match q {
    FokQBound i ↦ fok_slot_object a (fok_bound_lookup a bound i);
    FokQParameter i ↦ fok_slot_object a (fok_level_lookup a levels i)
  }

-- Proof-relevant conjunction is truncated when used as a target proposition.
data FokConjunction (p : Omega) (q : Omega) : Type where {
  FokConjoin : p → q → FokConjunction p q
}

fn fok_domain_truth (a : Type) (value : Option a) : Omega =
  match value {
    None ↦ Bottom;
    Some x ↦ Top
  }

fn fok_atom_truth
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (value : Option (fok_sort_a sigma c))
    : Omega =
  match value {
    None ↦ Bottom;
    Some x ↦ fok_pred_p sigma c rho x
  }

-- Truth of a target formula in the canonical one-world model. Accessibility is
-- total. Domain and atom truth share the same object resolver, so malformed
-- world-as-object occurrences fail closed instead of inventing a value.
fn fok_target_forces
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (form : FokForm)
    : Omega =
  match form {
    FokBottom ↦ Bottom;
    FokAccess w v ↦ Top;
    FokDomainA w x ↦
      fok_domain_truth
        (fok_sort_a sigma c)
        (fok_qobject_value (fok_sort_a sigma c) levels bound x);
    FokForcingP w x ↦
      fok_atom_truth sigma c rho (fok_qobject_value (fok_sort_a sigma c) levels bound x);
    FokAnd p q ↦
      ‖ FokConjunction
        (fok_target_forces sigma c rho levels bound p)
        (fok_target_forces sigma c rho levels bound q) ‖;
    FokOr p q ↦
      ‖ Or
        (fok_target_forces sigma c rho levels bound p)
        (fok_target_forces sigma c rho levels bound q) ‖;
    FokImp p q ↦
      fok_target_forces sigma c rho levels bound p
      → fok_target_forces sigma c rho levels bound q;
    FokForallWorld body ↦
      fok_target_forces
        sigma
        c
        rho
        levels
        (fok_bound_push (fok_sort_a sigma c) (FokLevelWorld (fok_sort_a sigma c)) bound)
        body;
    FokForallObj body ↦
      (x : fok_sort_a sigma c)
        → fok_target_forces sigma c rho levels
        (fok_bound_push (fok_sort_a sigma c) (FokLevelObject (fok_sort_a sigma c) x) bound)
        body
  }

-- A proof-relevant equivalence used for semantic weakening and substitution.
data FokForcingIff (p : Omega) (q : Omega) : Type where {
  FokMkForcingIff : (p → q) → (q → p) → FokForcingIff p q
}

theorem fok_iff_forward (p : Omega) (q : Omega) (h : FokForcingIff p q) : p → q =
  match h {
    FokMkForcingIff forward backward ↦ forward
  }

theorem fok_iff_backward (p : Omega) (q : Omega) (h : FokForcingIff p q) : q → p =
  match h {
    FokMkForcingIff forward backward ↦ backward
  }

-- === D2b: derivation inversion and semantic soundness backbone ===
fn fok_seq_gamma (s : FokSequent) : List FokForm =
  match s {
    FokMkSequent gamma delta ↦ gamma
  }

fn fok_seq_delta (s : FokSequent) : List FokForm =
  match s {
    FokMkSequent gamma delta ↦ delta
  }

-- True exactly for the goal shapes with a right-introduction rule in this slice
-- (Imp, ForallWorld, ForallObj). Every atomlike goal -- Bottom, the three
-- relation atoms, And, Or -- is False and can only be closed by Init.
fn fok_has_right_intro (goal : FokForm) : Bool =
  match goal {
    FokBottom ↦ False;
    FokAccess a b ↦ False;
    FokDomainA a b ↦ False;
    FokForcingP a b ↦ False;
    FokAnd p q ↦ False;
    FokOr p q ↦ False;
    FokImp p q ↦ True;
    FokForallWorld body ↦ True;
    FokForallObj body ↦ True
  }

-- Projections/discriminators for `Option FokForm`, for Some-injectivity and the
-- None/Some discrimination the inversion needs.
fn fok_option_form_default (o : Option FokForm) : FokForm =
  match o {
    None ↦ FokBottom;
    Some x ↦ x
  }

fn fok_option_form_is_some (o : Option FokForm) : Bool =
  match o {
    None ↦ False;
    Some x ↦ True
  }

theorem fok_some_form_injective
      (a : FokForm) (b : FokForm) (h : Equal (Option FokForm) (Some FokForm a) (Some FokForm b))
    : Equal FokForm a b =
  fok_cong (Option FokForm) FokForm (Some FokForm a) (Some FokForm b) fok_option_form_default h

theorem fok_none_is_not_some
      (b : FokForm) (h : Equal (Option FokForm) (None FokForm) (Some FokForm b))
    : Equal Bool False True =
  fok_cong (Option FokForm) Bool (None FokForm) (Some FokForm b) fok_option_form_is_some h

-- A lookup into the singleton `[goal]` that returns `Some dd` forces `dd = goal`
-- (only index 0 hits; every higher index is `None`, absurd against `Some`).
theorem fok_nth_singleton_some
      (goal : FokForm) (dd : FokForm) (right : Nat)
    : Equal
        (Option FokForm)
        (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
        (Some FokForm dd)
      → Equal FokForm goal dd =
  match right {
    Zero ↦ λh. fok_some_form_injective goal dd h;
    Suc j ↦ λh. absurd (fok_none_is_not_some dd h)
  }

-- The Init closure witness recovered by inverting an atomlike-goal derivation.
data FokInitWitness (gamma : List FokForm) (goal : FokForm) : Type where {
  FokMkInitWitness :
    (left : Nat)
    → Equal (Option FokForm) (fok_nth_form gamma left) (Some FokForm goal)
    → FokInitWitness gamma goal
}

-- Generic equality symmetry / transitivity (J one-liners) used by the inversion.
theorem fok_eq_sym (a : Type) (x : a) (y : a) (h : Equal a x y) : Equal a y x =
  J (λy2 _. Equal a y2 x) Refl h

theorem fok_eq_trans
      (a : Type) (x : a) (y : a) (z : a) (h1 : Equal a x y) (h2 : Equal a y z)
    : Equal a x z =
  J (λz2 _. Equal a x z2) h1 h2

-- A right-intro goal SHAPE contradicts an atomlike hypothesis: for Imp /
-- ForallWorld / ForallObj, `fok_has_right_intro shape` reduces to `True`, so
-- `False = has_right_intro shape` is `Equal Bool False True`.
theorem fok_absurd_right_intro
      (goal : FokForm)
      (shape : FokForm)
      (h_atom : Equal Bool (fok_has_right_intro goal) False)
      (heq : Equal FokForm goal shape)
    : Equal Bool False (fok_has_right_intro shape) =
  fok_eq_trans
    Bool
    False
    (fok_has_right_intro goal)
    (fok_has_right_intro shape)
    (fok_eq_sym Bool (fok_has_right_intro goal) False h_atom)
    (fok_cong FokForm Bool goal shape fok_has_right_intro heq)

-- Invert a derivation of an atomlike (no-right-intro) SINGLETON goal: only Init
-- can close it, yielding the Init closure witness. Each right-intro rule is
-- impossible here -- its `delta[right]` shape (via `fok_nth_singleton_some`)
-- would force the goal to be Imp / ForallWorld / ForallObj, contradicting the
-- atomlike hypothesis.
fn fok_invert_atomlike
      (gamma : List FokForm)
      (goal : FokForm)
      (h_atom : Equal Bool (fok_has_right_intro goal) False)
      (d : FokDerivation (FokMkSequent gamma (Cons FokForm goal (Nil FokForm))))
    : FokInitWitness gamma goal =
  match d {
    FokDerivInit g0 d0 left right g dd h_g h_d h_eq ↦
      FokMkInitWitness
        gamma
        goal
        left
        (fok_eq_trans
          (Option FokForm)
          (fok_nth_form gamma left)
          (Some FokForm g)
          (Some FokForm goal)
          h_g
          (fok_cong
            FokForm
            (Option FokForm)
            g
            goal
            (λx. Some FokForm x)
            (fok_eq_trans
              FokForm
              g
              dd
              goal
              (fok_form_eq_sound g dd h_eq)
              (fok_eq_sym FokForm goal dd (fok_nth_singleton_some goal dd right h_d)))));
    FokDerivImpRight g0 d0 right p q h_d prem ↦
      fok_false_elim
        (FokInitWitness gamma goal)
        (fok_absurd_right_intro
          goal
          (FokImp p q)
          h_atom
          (fok_nth_singleton_some goal (FokImp p q) right h_d));
    FokDerivForallWorldRight g0 d0 right eigen body h_d h_fresh prem ↦
      fok_false_elim
        (FokInitWitness gamma goal)
        (fok_absurd_right_intro
          goal
          (FokForallWorld body)
          h_atom
          (fok_nth_singleton_some goal (FokForallWorld body) right h_d));
    FokDerivForallObjRight g0 d0 right eigen body h_d h_fresh prem ↦
      fok_false_elim
        (FokInitWitness gamma goal)
        (fok_absurd_right_intro
          goal
          (FokForallObj body)
          h_atom
          (fok_nth_singleton_some goal (FokForallObj body) right h_d))
  }

-- === D2b: level stability ===
theorem fok_nat_eq_refl (i : Nat) : Equal Bool (fok_nat_eq i i) True =
  match i {
    Zero ↦ Proved;
    Suc j ↦ fok_nat_eq_refl j
  }

theorem fok_level_lookup_set_same
      (a : Type) (levels : FokLevelContext a) (i : Nat) (slot : FokLevelSlot a)
    : Equal (FokLevelSlot a) (fok_level_lookup a (fok_level_set a levels i slot) i) slot =
  match levels {
    FokMkLevelContext resolve ↦
      J
        (λanswer _.
          Equal
            (FokLevelSlot a)
            (match answer {
              True ↦ slot;
              False ↦ resolve i
            })
            slot)
        Refl
        (fok_eq_sym Bool (fok_nat_eq i i) True (fok_nat_eq_refl i))
  }

theorem fok_level_lookup_set_other
      (a : Type) (levels : FokLevelContext a) (i : Nat) (key : Nat) (slot : FokLevelSlot a)
    : Equal Bool (fok_nat_eq key i) False
      → Equal
        (FokLevelSlot a)
        (fok_level_lookup a (fok_level_set a levels i slot) key)
        (fok_level_lookup a levels key) =
  match levels {
    FokMkLevelContext resolve ↦
      λh.
        J
          (λanswer _.
            Equal
              (FokLevelSlot a)
              (match answer {
                True ↦ slot;
                False ↦ resolve key
              })
              (resolve key))
          Refl
          (fok_eq_sym Bool (fok_nat_eq key i) False h)
  }

theorem fok_qobject_parameter_update_fresh
      (a : Type)
      (levels : FokLevelContext a)
      (bound : FokBoundContext a)
      (eigen : Nat)
      (slot : FokLevelSlot a)
      (key : Nat)
    : Equal Bool (fok_nat_eq key eigen) False
      → Equal
        (Option a)
        (fok_slot_object a (fok_level_lookup a (fok_level_set a levels eigen slot) key))
        (fok_slot_object a (fok_level_lookup a levels key)) =
  λh.
    fok_cong
      (FokLevelSlot a)
      (Option a)
      (fok_level_lookup a (fok_level_set a levels eigen slot) key)
      (fok_level_lookup a levels key)
      (fok_slot_object a)
      (fok_level_lookup_set_other a levels eigen key slot h)

-- A parameter absent from a term resolves identically before and after filling
-- that stable level.
theorem fok_qobject_value_update_fresh
      (a : Type)
      (levels : FokLevelContext a)
      (bound : FokBoundContext a)
      (eigen : Nat)
      (slot : FokLevelSlot a)
      (q : FokQTerm)
    : Equal Bool (fok_qterm_eq q (FokQParameter eigen)) False
      → Equal
        (Option a)
        (fok_qobject_value a (fok_level_set a levels eigen slot) bound q)
        (fok_qobject_value a levels bound q) =
  match q {
    FokQBound i ↦ λh. Refl;
    FokQParameter key ↦ fok_qobject_parameter_update_fresh a levels bound eigen slot key
  }

fn fok_iff_refl (p : Omega) : FokForcingIff p p = FokMkForcingIff p p (λh. h) (λh. h)

fn fok_iff_sym (p : Omega) (q : Omega) (h : FokForcingIff p q) : FokForcingIff q p =
  FokMkForcingIff q p (fok_iff_backward p q h) (fok_iff_forward p q h)

fn fok_option_domain_iff
      (a : Type) (x : Option a) (y : Option a) (same : Equal (Option a) x y)
    : FokForcingIff (fok_domain_truth a x) (fok_domain_truth a y) =
  J
    (λy2 _. FokForcingIff (fok_domain_truth a x) (fok_domain_truth a y2))
    (fok_iff_refl (fok_domain_truth a x))
    same

fn fok_option_atom_iff
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (x : Option (fok_sort_a sigma c))
      (y : Option (fok_sort_a sigma c))
      (same : Equal (Option (fok_sort_a sigma c)) x y)
    : FokForcingIff (fok_atom_truth sigma c rho x) (fok_atom_truth sigma c rho y) =
  J
    (λy2 _. FokForcingIff (fok_atom_truth sigma c rho x) (fok_atom_truth sigma c rho y2))
    (fok_iff_refl (fok_atom_truth sigma c rho x))
    same

-- === D2b: forcing invariance under a fresh level extension ===
fn fok_conjunction_prop (p : Omega) (q : Omega) : Omega = ‖ FokConjunction p q ‖

fn fok_or_prop (p : Omega) (q : Omega) : Omega = ‖ Or p q ‖

theorem fok_trunc_conjunction_map
      (p : Omega)
      (q : Omega)
      (p2 : Omega)
      (q2 : Omega)
      (fp : p → p2)
      (fq : q → q2)
      (h : fok_conjunction_prop p q)
    : fok_conjunction_prop p2 q2 =
  elim_trunc
    (fok_conjunction_prop p2 q2)
    (λpair.
      match pair {
        FokConjoin hp hq ↦ trunc_intro (FokConjoin p2 q2 (fp hp) (fq hq))
      })
    h

theorem fok_trunc_or_map
      (p : Omega)
      (q : Omega)
      (p2 : Omega)
      (q2 : Omega)
      (fp : p → p2)
      (fq : q → q2)
      (h : fok_or_prop p q)
    : fok_or_prop p2 q2 =
  elim_trunc
    (fok_or_prop p2 q2)
    (λchoice.
      match choice {
        Inl hp ↦ trunc_intro (Inl p2 q2 (fp hp));
        Inr hq ↦ trunc_intro (Inr p2 q2 (fq hq))
      })
    h

fn fok_iff_conjunction
      (p : Omega)
      (q : Omega)
      (p2 : Omega)
      (q2 : Omega)
      (hp : FokForcingIff p p2)
      (hq : FokForcingIff q q2)
    : FokForcingIff (fok_conjunction_prop p q) (fok_conjunction_prop p2 q2) =
  FokMkForcingIff
    (fok_conjunction_prop p q)
    (fok_conjunction_prop p2 q2)
    (fok_trunc_conjunction_map p q p2 q2 (fok_iff_forward p p2 hp) (fok_iff_forward q q2 hq))
    (fok_trunc_conjunction_map p2 q2 p q (fok_iff_backward p p2 hp) (fok_iff_backward q q2 hq))

fn fok_iff_or
      (p : Omega)
      (q : Omega)
      (p2 : Omega)
      (q2 : Omega)
      (hp : FokForcingIff p p2)
      (hq : FokForcingIff q q2)
    : FokForcingIff (fok_or_prop p q) (fok_or_prop p2 q2) =
  FokMkForcingIff
    (fok_or_prop p q)
    (fok_or_prop p2 q2)
    (fok_trunc_or_map p q p2 q2 (fok_iff_forward p p2 hp) (fok_iff_forward q q2 hq))
    (fok_trunc_or_map p2 q2 p q (fok_iff_backward p p2 hp) (fok_iff_backward q q2 hq))

fn fok_iff_imp
      (p : Omega)
      (q : Omega)
      (p2 : Omega)
      (q2 : Omega)
      (hp : FokForcingIff p p2)
      (hq : FokForcingIff q q2)
    : FokForcingIff (p → q) (p2 → q2) =
  FokMkForcingIff
    (p → q)
    (p2 → q2)
    (λf. λx. fok_iff_forward q q2 hq (f (fok_iff_backward p p2 hp x)))
    (λf. λx. fok_iff_backward q q2 hq (f (fok_iff_forward p p2 hp x)))

fn fok_iff_pi
      (a : Type)
      (p : a → Omega)
      (q : a → Omega)
      (pointwise : (x : a) → FokForcingIff (p x) (q x))
    : FokForcingIff ((x : a) → p x) ((x : a) → q x) =
  FokMkForcingIff
    ((x : a) → p x)
    ((x : a) → q x)
    (λf. λx. fok_iff_forward (p x) (q x) (pointwise x) (f x))
    (λf. λx. fok_iff_backward (p x) (q x) (pointwise x) (f x))

fn fok_target_forces_update_fresh_iff
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (eigen : Nat)
      (slot : FokLevelSlot (fok_sort_a sigma c))
      (form : FokForm)
    : Equal Bool (fok_form_mentions_parameter form (FokQParameter eigen)) False
      → FokForcingIff
        (fok_target_forces sigma c rho levels bound form)
        (fok_target_forces
          sigma
          c
          rho
          (fok_level_set (fok_sort_a sigma c) levels eigen slot)
          bound
          form) =
  match form {
    FokBottom ↦ λh. fok_iff_refl Bottom;
    FokAccess w v ↦ λh. fok_iff_refl Top;
    FokDomainA w x ↦
      λh.
        fok_iff_sym
          (fok_domain_truth
            (fok_sort_a sigma c)
            (fok_qobject_value
              (fok_sort_a sigma c)
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              bound
              x))
          (fok_domain_truth
            (fok_sort_a sigma c)
            (fok_qobject_value (fok_sort_a sigma c) levels bound x))
          (fok_option_domain_iff
            (fok_sort_a sigma c)
            (fok_qobject_value
              (fok_sort_a sigma c)
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              bound
              x)
            (fok_qobject_value (fok_sort_a sigma c) levels bound x)
            (fok_qobject_value_update_fresh
              (fok_sort_a sigma c)
              levels
              bound
              eigen
              slot
              x
              (fok_or_right_false
                (fok_qterm_eq w (FokQParameter eigen))
                (fok_qterm_eq x (FokQParameter eigen))
                h)));
    FokForcingP w x ↦
      λh.
        fok_iff_sym
          (fok_atom_truth
            sigma
            c
            rho
            (fok_qobject_value
              (fok_sort_a sigma c)
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              bound
              x))
          (fok_atom_truth sigma c rho (fok_qobject_value (fok_sort_a sigma c) levels bound x))
          (fok_option_atom_iff
            sigma
            c
            rho
            (fok_qobject_value
              (fok_sort_a sigma c)
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              bound
              x)
            (fok_qobject_value (fok_sort_a sigma c) levels bound x)
            (fok_qobject_value_update_fresh
              (fok_sort_a sigma c)
              levels
              bound
              eigen
              slot
              x
              (fok_or_right_false
                (fok_qterm_eq w (FokQParameter eigen))
                (fok_qterm_eq x (FokQParameter eigen))
                h)));
    FokAnd p q ↦
      λh.
        fok_iff_conjunction
          (fok_target_forces sigma c rho levels bound p)
          (fok_target_forces sigma c rho levels bound q)
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            bound
            p)
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            bound
            q)
          (fok_target_forces_update_fresh_iff
            sigma
            c
            rho
            levels
            bound
            eigen
            slot
            p
            (fok_or_left_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h))
          (fok_target_forces_update_fresh_iff
            sigma
            c
            rho
            levels
            bound
            eigen
            slot
            q
            (fok_or_right_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h));
    FokOr p q ↦
      λh.
        fok_iff_or
          (fok_target_forces sigma c rho levels bound p)
          (fok_target_forces sigma c rho levels bound q)
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            bound
            p)
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            bound
            q)
          (fok_target_forces_update_fresh_iff
            sigma
            c
            rho
            levels
            bound
            eigen
            slot
            p
            (fok_or_left_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h))
          (fok_target_forces_update_fresh_iff
            sigma
            c
            rho
            levels
            bound
            eigen
            slot
            q
            (fok_or_right_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h));
    FokImp p q ↦
      λh.
        fok_iff_imp
          (fok_target_forces sigma c rho levels bound p)
          (fok_target_forces sigma c rho levels bound q)
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            bound
            p)
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            bound
            q)
          (fok_target_forces_update_fresh_iff
            sigma
            c
            rho
            levels
            bound
            eigen
            slot
            p
            (fok_or_left_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h))
          (fok_target_forces_update_fresh_iff
            sigma
            c
            rho
            levels
            bound
            eigen
            slot
            q
            (fok_or_right_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h));
    FokForallWorld body ↦
      fok_target_forces_update_fresh_iff
        sigma
        c
        rho
        levels
        (fok_bound_push (fok_sort_a sigma c) (FokLevelWorld (fok_sort_a sigma c)) bound)
        eigen
        slot
        body;
    FokForallObj body ↦
      λh.
        fok_iff_pi
          (fok_sort_a sigma c)
          (λx.
            fok_target_forces
              sigma
              c
              rho
              levels
              (fok_bound_push
                (fok_sort_a sigma c)
                (FokLevelObject (fok_sort_a sigma c) x)
                bound)
              body)
          (λx.
            fok_target_forces
              sigma
              c
              rho
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              (fok_bound_push
                (fok_sort_a sigma c)
                (FokLevelObject (fok_sort_a sigma c) x)
                bound)
              body)
          (λx.
            fok_target_forces_update_fresh_iff
              sigma
              c
              rho
              levels
              (fok_bound_push
                (fok_sort_a sigma c)
                (FokLevelObject (fok_sort_a sigma c) x)
                bound)
              eigen
              slot
              body
              h)
  }

-- === D2b: semantic substitution at a bound target variable ===
-- `prefix` is the binder telescope crossed while substitution descends into a
-- formula. Its index is exactly the substitution depth.
data FokBoundPrefix (a : Type) : Nat → Type 1 where {
  FokBoundPrefixNil : FokBoundPrefix a Zero;
  FokBoundPrefixCons :
    (n : Nat) → FokLevelSlot a → FokBoundPrefix a n → FokBoundPrefix a (Suc n)
}

fn fok_bound_prefix_apply
      (a : Type) (n : Nat) (prefix : FokBoundPrefix a n) (base : FokBoundContext a)
    : FokBoundContext a =
  match prefix {
    FokBoundPrefixNil ↦ base;
    FokBoundPrefixCons m head rest ↦ FokBoundCons a head (fok_bound_prefix_apply a m rest base)
  }

theorem fok_qobject_bound_subst_prefix_nil
      (a : Type)
      (levels : FokLevelContext a)
      (base : FokBoundContext a)
      (eigen : Nat)
      (slot : FokLevelSlot a)
      (i : Nat)
    : Equal
        (Option a)
        (fok_qobject_value
          a
          (fok_level_set a levels eigen slot)
          base
          (fok_subst_qterm_at (FokQBound i) Zero (FokQParameter eigen)))
        (fok_qobject_value a levels (FokBoundCons a slot base) (FokQBound i)) =
  match i {
    Zero ↦
      fok_cong
        (FokLevelSlot a)
        (Option a)
        (fok_level_lookup a (fok_level_set a levels eigen slot) eigen)
        slot
        (fok_slot_object a)
        (fok_level_lookup_set_same a levels eigen slot);
    Suc j ↦ Refl
  }

fn fok_under_head_left_qterm
      (eigen : Nat) (k : Nat) (eq_answer : Bool) (lt_answer : Bool)
    : FokQTerm =
  match eq_answer {
    True ↦ FokQParameter eigen;
    False ↦
      match lt_answer {
        True ↦ FokQBound (Suc k);
        False ↦ FokQBound (Suc (Suc k))
      }
  }

fn fok_under_head_right_qterm
      (eigen : Nat) (k : Nat) (eq_answer : Bool) (lt_answer : Bool)
    : FokQTerm =
  match eq_answer {
    True ↦ FokQParameter eigen;
    False ↦
      match lt_answer {
        True ↦ FokQBound k;
        False ↦ FokQBound (Suc k)
      }
  }

theorem fok_qobject_subst_under_bound_head_suc_answers
      (a : Type)
      (levels : FokLevelContext a)
      (rest : FokBoundContext a)
      (head : FokLevelSlot a)
      (eigen : Nat)
      (k : Nat)
      (eq_answer : Bool)
      (lt_answer : Bool)
    : Equal
        (Option a)
        (fok_qobject_value
          a
          levels
          (FokBoundCons a head rest)
          (fok_under_head_left_qterm eigen k eq_answer lt_answer))
        (fok_qobject_value
          a
          levels
          rest
          (fok_under_head_right_qterm eigen k eq_answer lt_answer)) =
  match eq_answer {
    True ↦ Refl;
    False ↦
      match lt_answer {
        True ↦ Refl;
        False ↦ Refl
      }
  }

theorem fok_qobject_subst_under_bound_head_zero
      (a : Type)
      (levels : FokLevelContext a)
      (rest : FokBoundContext a)
      (head : FokLevelSlot a)
      (eigen : Nat)
      (m : Nat)
    : Equal
        (Option a)
        (fok_qobject_value
          a
          levels
          (FokBoundCons a head rest)
          (fok_subst_qterm_at (FokQBound (Suc Zero)) (Suc m) (FokQParameter eigen)))
        (fok_qobject_value
          a
          levels
          rest
          (fok_subst_qterm_at (FokQBound Zero) m (FokQParameter eigen))) =
  match m {
    Zero ↦ Refl;
    Suc d ↦ Refl
  }

theorem fok_qobject_subst_under_bound_head_suc
      (a : Type)
      (levels : FokLevelContext a)
      (rest : FokBoundContext a)
      (head : FokLevelSlot a)
      (eigen : Nat)
      (m : Nat)
      (k : Nat)
    : Equal
        (Option a)
        (fok_qobject_value
          a
          levels
          (FokBoundCons a head rest)
          (fok_subst_qterm_at (FokQBound (Suc (Suc k))) (Suc m) (FokQParameter eigen)))
        (fok_qobject_value
          a
          levels
          rest
          (fok_subst_qterm_at (FokQBound (Suc k)) m (FokQParameter eigen))) =
  fok_qobject_subst_under_bound_head_suc_answers
    a
    levels
    rest
    head
    eigen
    k
    (fok_nat_eq (Suc k) m)
    (fok_nat_lt m (Suc k))

theorem fok_qobject_subst_under_bound_head
      (a : Type)
      (levels : FokLevelContext a)
      (rest : FokBoundContext a)
      (head : FokLevelSlot a)
      (eigen : Nat)
      (m : Nat)
      (j : Nat)
    : Equal
        (Option a)
        (fok_qobject_value
          a
          levels
          (FokBoundCons a head rest)
          (fok_subst_qterm_at (FokQBound (Suc j)) (Suc m) (FokQParameter eigen)))
        (fok_qobject_value
          a
          levels
          rest
          (fok_subst_qterm_at (FokQBound j) m (FokQParameter eigen))) =
  match j {
    Zero ↦ fok_qobject_subst_under_bound_head_zero a levels rest head eigen m;
    Suc k ↦ fok_qobject_subst_under_bound_head_suc a levels rest head eigen m k
  }

theorem fok_qobject_bound_subst_prefix
      (a : Type)
      (levels : FokLevelContext a)
      (base : FokBoundContext a)
      (eigen : Nat)
      (slot : FokLevelSlot a)
      (n : Nat)
      (prefix : FokBoundPrefix a n)
      (i : Nat)
    : Equal
        (Option a)
        (fok_qobject_value
          a
          (fok_level_set a levels eigen slot)
          (fok_bound_prefix_apply a n prefix base)
          (fok_subst_qterm_at (FokQBound i) n (FokQParameter eigen)))
        (fok_qobject_value
          a
          levels
          (fok_bound_prefix_apply a n prefix (FokBoundCons a slot base))
          (FokQBound i)) =
  match prefix {
    FokBoundPrefixNil ↦ fok_qobject_bound_subst_prefix_nil a levels base eigen slot i;
    FokBoundPrefixCons m head rest ↦
      match i {
        Zero ↦ Refl;
        Suc j ↦
          fok_eq_trans
            (Option a)
            (fok_qobject_value
              a
              (fok_level_set a levels eigen slot)
              (FokBoundCons a head (fok_bound_prefix_apply a m rest base))
              (fok_subst_qterm_at (FokQBound (Suc j)) (Suc m) (FokQParameter eigen)))
            (fok_qobject_value
              a
              (fok_level_set a levels eigen slot)
              (fok_bound_prefix_apply a m rest base)
              (fok_subst_qterm_at (FokQBound j) m (FokQParameter eigen)))
            (fok_qobject_value
              a
              levels
              (fok_bound_prefix_apply a m rest (FokBoundCons a slot base))
              (FokQBound j))
            (fok_qobject_subst_under_bound_head
              a
              (fok_level_set a levels eigen slot)
              (fok_bound_prefix_apply a m rest base)
              head
              eigen
              m
              j)
            (fok_qobject_bound_subst_prefix a levels base eigen slot m rest j)
      }
  }

theorem fok_qobject_subst_prefix
      (a : Type)
      (levels : FokLevelContext a)
      (base : FokBoundContext a)
      (eigen : Nat)
      (slot : FokLevelSlot a)
      (n : Nat)
      (prefix : FokBoundPrefix a n)
      (q : FokQTerm)
    : Equal Bool (fok_qterm_eq q (FokQParameter eigen)) False
      → Equal
        (Option a)
        (fok_qobject_value
          a
          (fok_level_set a levels eigen slot)
          (fok_bound_prefix_apply a n prefix base)
          (fok_subst_qterm_at q n (FokQParameter eigen)))
        (fok_qobject_value
          a
          levels
          (fok_bound_prefix_apply a n prefix (FokBoundCons a slot base))
          q) =
  match q {
    FokQBound i ↦ λh. fok_qobject_bound_subst_prefix a levels base eigen slot n prefix i;
    FokQParameter key ↦
      fok_qobject_parameter_update_fresh
        a
        levels
        (fok_bound_prefix_apply a n prefix base)
        eigen
        slot
        key
  }

fn fok_target_subst_prefix_iff
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (base : FokBoundContext (fok_sort_a sigma c))
      (eigen : Nat)
      (slot : FokLevelSlot (fok_sort_a sigma c))
      (n : Nat)
      (prefix : FokBoundPrefix (fok_sort_a sigma c) n)
      (form : FokForm)
    : Equal Bool (fok_form_mentions_parameter form (FokQParameter eigen)) False
      → FokForcingIff
        (fok_target_forces
          sigma
          c
          rho
          (fok_level_set (fok_sort_a sigma c) levels eigen slot)
          (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
          (fok_subst_form_at form n (FokQParameter eigen)))
        (fok_target_forces
          sigma
          c
          rho
          levels
          (fok_bound_prefix_apply
            (fok_sort_a sigma c)
            n
            prefix
            (FokBoundCons (fok_sort_a sigma c) slot base))
          form) =
  match form {
    FokBottom ↦ λh. fok_iff_refl Bottom;
    FokAccess w v ↦ λh. fok_iff_refl Top;
    FokDomainA w x ↦
      λh.
        fok_option_domain_iff
          (fok_sort_a sigma c)
          (fok_qobject_value
            (fok_sort_a sigma c)
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_qterm_at x n (FokQParameter eigen)))
          (fok_qobject_value
            (fok_sort_a sigma c)
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            x)
          (fok_qobject_subst_prefix
            (fok_sort_a sigma c)
            levels
            base
            eigen
            slot
            n
            prefix
            x
            (fok_or_right_false
              (fok_qterm_eq w (FokQParameter eigen))
              (fok_qterm_eq x (FokQParameter eigen))
              h));
    FokForcingP w x ↦
      λh.
        fok_option_atom_iff
          sigma
          c
          rho
          (fok_qobject_value
            (fok_sort_a sigma c)
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_qterm_at x n (FokQParameter eigen)))
          (fok_qobject_value
            (fok_sort_a sigma c)
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            x)
          (fok_qobject_subst_prefix
            (fok_sort_a sigma c)
            levels
            base
            eigen
            slot
            n
            prefix
            x
            (fok_or_right_false
              (fok_qterm_eq w (FokQParameter eigen))
              (fok_qterm_eq x (FokQParameter eigen))
              h));
    FokAnd p q ↦
      λh.
        fok_iff_conjunction
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_form_at p n (FokQParameter eigen)))
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_form_at q n (FokQParameter eigen)))
          (fok_target_forces
            sigma
            c
            rho
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            p)
          (fok_target_forces
            sigma
            c
            rho
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            q)
          (fok_target_subst_prefix_iff
            sigma
            c
            rho
            levels
            base
            eigen
            slot
            n
            prefix
            p
            (fok_or_left_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h))
          (fok_target_subst_prefix_iff
            sigma
            c
            rho
            levels
            base
            eigen
            slot
            n
            prefix
            q
            (fok_or_right_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h));
    FokOr p q ↦
      λh.
        fok_iff_or
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_form_at p n (FokQParameter eigen)))
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_form_at q n (FokQParameter eigen)))
          (fok_target_forces
            sigma
            c
            rho
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            p)
          (fok_target_forces
            sigma
            c
            rho
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            q)
          (fok_target_subst_prefix_iff
            sigma
            c
            rho
            levels
            base
            eigen
            slot
            n
            prefix
            p
            (fok_or_left_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h))
          (fok_target_subst_prefix_iff
            sigma
            c
            rho
            levels
            base
            eigen
            slot
            n
            prefix
            q
            (fok_or_right_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h));
    FokImp p q ↦
      λh.
        fok_iff_imp
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_form_at p n (FokQParameter eigen)))
          (fok_target_forces
            sigma
            c
            rho
            (fok_level_set (fok_sort_a sigma c) levels eigen slot)
            (fok_bound_prefix_apply (fok_sort_a sigma c) n prefix base)
            (fok_subst_form_at q n (FokQParameter eigen)))
          (fok_target_forces
            sigma
            c
            rho
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            p)
          (fok_target_forces
            sigma
            c
            rho
            levels
            (fok_bound_prefix_apply
              (fok_sort_a sigma c)
              n
              prefix
              (FokBoundCons (fok_sort_a sigma c) slot base))
            q)
          (fok_target_subst_prefix_iff
            sigma
            c
            rho
            levels
            base
            eigen
            slot
            n
            prefix
            p
            (fok_or_left_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h))
          (fok_target_subst_prefix_iff
            sigma
            c
            rho
            levels
            base
            eigen
            slot
            n
            prefix
            q
            (fok_or_right_false
              (fok_form_mentions_parameter p (FokQParameter eigen))
              (fok_form_mentions_parameter q (FokQParameter eigen))
              h));
    FokForallWorld body ↦
      fok_target_subst_prefix_iff
        sigma
        c
        rho
        levels
        base
        eigen
        slot
        (Suc n)
        (FokBoundPrefixCons (fok_sort_a sigma c) n (FokLevelWorld (fok_sort_a sigma c)) prefix)
        body;
    FokForallObj body ↦
      λh.
        fok_iff_pi
          (fok_sort_a sigma c)
          (λx.
            fok_target_forces
              sigma
              c
              rho
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              (fok_bound_prefix_apply
                (fok_sort_a sigma c)
                (Suc n)
                (FokBoundPrefixCons
                  (fok_sort_a sigma c)
                  n
                  (FokLevelObject (fok_sort_a sigma c) x)
                  prefix)
                base)
              (fok_subst_form_at body (Suc n) (FokQParameter eigen)))
          (λx.
            fok_target_forces
              sigma
              c
              rho
              levels
              (fok_bound_prefix_apply
                (fok_sort_a sigma c)
                (Suc n)
                (FokBoundPrefixCons
                  (fok_sort_a sigma c)
                  n
                  (FokLevelObject (fok_sort_a sigma c) x)
                  prefix)
                (FokBoundCons (fok_sort_a sigma c) slot base))
              body)
          (λx.
            fok_target_subst_prefix_iff
              sigma
              c
              rho
              levels
              base
              eigen
              slot
              (Suc n)
              (FokBoundPrefixCons
                (fok_sort_a sigma c)
                n
                (FokLevelObject (fok_sort_a sigma c) x)
                prefix)
              body
              h)
  }

theorem fok_target_subst0_forward
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (eigen : Nat)
      (slot : FokLevelSlot (fok_sort_a sigma c))
      (form : FokForm)
      (fresh : Equal Bool (fok_form_mentions_parameter form (FokQParameter eigen)) False)
    : fok_target_forces sigma c rho
        (fok_level_set (fok_sort_a sigma c) levels eigen slot)
        bound
        (fok_subst0_form form (FokQParameter eigen))
      → fok_target_forces sigma c rho levels
        (FokBoundCons (fok_sort_a sigma c) slot bound)
        form =
  fok_iff_forward
    (fok_target_forces
      sigma
      c
      rho
      (fok_level_set (fok_sort_a sigma c) levels eigen slot)
      bound
      (fok_subst0_form form (FokQParameter eigen)))
    (fok_target_forces sigma c rho levels (FokBoundCons (fok_sort_a sigma c) slot bound) form)
    (fok_target_subst_prefix_iff
      sigma
      c
      rho
      levels
      bound
      eigen
      slot
      Zero
      (FokBoundPrefixNil (fok_sort_a sigma c))
      form
      fresh)

-- === D2b: target-calculus soundness ===
fn fok_gamma_forced
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
    : Omega =
  (left : Nat)
    → (goal : FokForm)
    → Equal
    (Option FokForm)
    (fok_nth_form gamma left)
    (Some FokForm goal)
    → fok_target_forces sigma c rho levels bound goal

theorem fok_target_forces_transport
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (from : FokForm)
      (to : FokForm)
      (same : Equal FokForm from to)
    : fok_target_forces sigma c rho levels bound from
      → fok_target_forces sigma c rho levels bound to =
  λh. J (λto2 _. fok_target_forces sigma c rho levels bound to2) h same

theorem fok_gamma_forced_empty
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_gamma_forced sigma c rho levels bound (Nil FokForm) =
  λleft. λgoal. λh. absurd (fok_none_is_not_some goal h)

theorem fok_gamma_forced_append_one
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (form : FokForm)
    : fok_gamma_forced sigma c rho levels bound gamma
      → fok_target_forces sigma c rho levels bound form
      → fok_gamma_forced sigma c rho levels bound (fok_list_form_append_one gamma form) =
  match gamma {
    Nil ↦
      λforced.
        λhform.
          λleft.
            match left {
              Zero ↦
                λgoal.
                  λh.
                    fok_target_forces_transport
                      sigma
                      c
                      rho
                      levels
                      bound
                      form
                      goal
                      (fok_some_form_injective form goal h)
                      hform;
              Suc j ↦ λgoal. λh. absurd (fok_none_is_not_some goal h)
            };
    Cons head tail ↦
      λforced.
        λhform.
          λleft.
            match left {
              Zero ↦ λgoal. λh. forced Zero goal h;
              Suc j ↦
                fok_gamma_forced_append_one
                  sigma
                  c
                  rho
                  levels
                  bound
                  tail
                  form
                  (λtail_left. λgoal. λh. forced (Suc tail_left) goal h)
                  hform
                  j
            }
  }

theorem fok_gamma_selected_fresh
      (gamma : List FokForm) (eigen : Nat)
    : Equal Bool (fok_list_form_any_mentions gamma (FokQParameter eigen)) False
      → (left : Nat)
      → (goal : FokForm)
      → Equal (Option FokForm) (fok_nth_form gamma left) (Some FokForm goal)
      → Equal Bool (fok_form_mentions_parameter goal (FokQParameter eigen)) False =
  match gamma {
    Nil ↦ λfresh. λleft. λgoal. λh. absurd (fok_none_is_not_some goal h);
    Cons head tail ↦
      λfresh.
        λleft.
          match left {
            Zero ↦
              λgoal.
                λh.
                  fok_eq_trans
                    Bool
                    (fok_form_mentions_parameter goal (FokQParameter eigen))
                    (fok_form_mentions_parameter head (FokQParameter eigen))
                    False
                    (fok_eq_sym
                      Bool
                      (fok_form_mentions_parameter head (FokQParameter eigen))
                      (fok_form_mentions_parameter goal (FokQParameter eigen))
                      (fok_cong
                        FokForm
                        Bool
                        head
                        goal
                        (λx. fok_form_mentions_parameter x (FokQParameter eigen))
                        (fok_some_form_injective head goal h)))
                    (fok_or_left_false
                      (fok_form_mentions_parameter head (FokQParameter eigen))
                      (fok_list_form_any_mentions tail (FokQParameter eigen))
                      fresh);
            Suc j ↦
              fok_gamma_selected_fresh
                tail
                eigen
                (fok_or_right_false
                  (fok_form_mentions_parameter head (FokQParameter eigen))
                  (fok_list_form_any_mentions tail (FokQParameter eigen))
                  fresh)
                j
          }
  }

theorem fok_gamma_forced_update_fresh
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (eigen : Nat)
      (slot : FokLevelSlot (fok_sort_a sigma c))
      (fresh : Equal Bool (fok_list_form_any_mentions gamma (FokQParameter eigen)) False)
    : fok_gamma_forced sigma c rho levels bound gamma
      → fok_gamma_forced sigma c rho
        (fok_level_set (fok_sort_a sigma c) levels eigen slot)
        bound gamma =
  λforced.
    λleft.
      λgoal.
        λh.
          fok_iff_forward
            (fok_target_forces sigma c rho levels bound goal)
            (fok_target_forces
              sigma
              c
              rho
              (fok_level_set (fok_sort_a sigma c) levels eigen slot)
              bound
              goal)
            (fok_target_forces_update_fresh_iff
              sigma
              c
              rho
              levels
              bound
              eigen
              slot
              goal
              (fok_gamma_selected_fresh gamma eigen fresh left goal h))
            (forced left goal h)

theorem fok_singleton_form_fresh
      (form : FokForm) (eigen : Nat)
    : Equal Bool
        (fok_list_form_any_mentions (Cons FokForm form (Nil FokForm)) (FokQParameter eigen))
        False
      → Equal Bool (fok_form_mentions_parameter form (FokQParameter eigen)) False =
  fok_or_left_false (fok_form_mentions_parameter form (FokQParameter eigen)) False

theorem fok_form_fresh_transport
      (from : FokForm)
      (to : FokForm)
      (eigen : Nat)
      (same : Equal FokForm from to)
      (fresh : Equal Bool (fok_form_mentions_parameter from (FokQParameter eigen)) False)
    : Equal Bool (fok_form_mentions_parameter to (FokQParameter eigen)) False =
  fok_eq_trans
    Bool
    (fok_form_mentions_parameter to (FokQParameter eigen))
    (fok_form_mentions_parameter from (FokQParameter eigen))
    False
    (fok_eq_sym
      Bool
      (fok_form_mentions_parameter from (FokQParameter eigen))
      (fok_form_mentions_parameter to (FokQParameter eigen))
      (fok_cong
        FokForm
        Bool
        from
        to
        (λx. fok_form_mentions_parameter x (FokQParameter eigen))
        same))
    fresh

-- Replace one selected element of a singleton and recover the new singleton.
theorem fok_set_nth_singleton
      (goal : FokForm) (selected : FokForm) (right : Nat) (replacement : FokForm)
    : Equal
        (Option FokForm)
        (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
        (Some FokForm selected)
      → Equal
        (List FokForm)
        (fok_list_form_set_nth (Cons FokForm goal (Nil FokForm)) right replacement)
        (Cons FokForm replacement (Nil FokForm)) =
  match right {
    Zero ↦ λh. Refl;
    Suc j ↦ λh. absurd (fok_none_is_not_some selected h)
  }

theorem fok_delta_set_to_singleton
      (delta : List FokForm)
      (goal : FokForm)
      (selected : FokForm)
      (right : Nat)
      (replacement : FokForm)
      (delta_to : Equal (List FokForm) delta (Cons FokForm goal (Nil FokForm)))
      (at_right : Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm selected))
    : Equal
        (List FokForm)
        (fok_list_form_set_nth delta right replacement)
        (Cons FokForm replacement (Nil FokForm)) =
  fok_eq_trans
    (List FokForm)
    (fok_list_form_set_nth delta right replacement)
    (fok_list_form_set_nth (Cons FokForm goal (Nil FokForm)) right replacement)
    (Cons FokForm replacement (Nil FokForm))
    (fok_cong
      (List FokForm)
      (List FokForm)
      delta
      (Cons FokForm goal (Nil FokForm))
      (λxs. fok_list_form_set_nth xs right replacement)
      delta_to)
    (fok_set_nth_singleton
      goal
      selected
      right
      replacement
      (fok_eq_trans
        (Option FokForm)
        (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
        (fok_nth_form delta right)
        (Some FokForm selected)
        (fok_eq_sym
          (Option FokForm)
          (fok_nth_form delta right)
          (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
          (fok_cong
            (List FokForm)
            (Option FokForm)
            delta
            (Cons FokForm goal (Nil FokForm))
            (λxs. fok_nth_form xs right)
            delta_to))
        at_right))

fn fok_target_soundness_motive
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (sequent : FokSequent)
    : Omega =
  match sequent {
    FokMkSequent gamma delta ↦
      (goal : FokForm)
        → Equal
        (List FokForm)
        delta
        (Cons FokForm goal (Nil FokForm))
        → fok_gamma_forced
        sigma
        c
        rho
        levels
        bound
        gamma
        → fok_target_forces
        sigma
        c
        rho
        levels
        bound
        goal
  }

theorem fok_target_soundness_init_case
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (delta : List FokForm)
      (left : Nat)
      (right : Nat)
      (g : FokForm)
      (d : FokForm)
      (h_g : Equal (Option FokForm) (fok_nth_form gamma left) (Some FokForm g))
      (h_d : Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm d))
      (h_eq : Equal Bool (fok_form_eq g d) True)
    : fok_target_soundness_motive sigma c rho levels bound (FokMkSequent gamma delta) =
  λgoal.
    λdelta_to.
      λforced.
        fok_target_forces_transport
          sigma
          c
          rho
          levels
          bound
          g
          goal
          (fok_eq_trans
            FokForm
            g
            d
            goal
            (fok_form_eq_sound g d h_eq)
            (fok_eq_sym
              FokForm
              goal
              d
              (fok_nth_singleton_some
                goal
                d
                right
                (fok_eq_trans
                  (Option FokForm)
                  (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                  (fok_nth_form delta right)
                  (Some FokForm d)
                  (fok_eq_sym
                    (Option FokForm)
                    (fok_nth_form delta right)
                    (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                    (fok_cong
                      (List FokForm)
                      (Option FokForm)
                      delta
                      (Cons FokForm goal (Nil FokForm))
                      (λxs. fok_nth_form xs right)
                      delta_to))
                  h_d))))
          (forced left g h_g)

theorem fok_target_soundness_imp_case
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (p : FokForm)
      (q : FokForm)
      (h_d : Equal (Option FokForm) (fok_nth_form delta right) (Some FokForm (FokImp p q)))
      (child_sound : fok_target_soundness_motive
        sigma
        c
        rho
        levels
        bound
        (FokMkSequent (fok_list_form_append_one gamma p) (fok_list_form_set_nth delta right q)))
    : fok_target_soundness_motive sigma c rho levels bound (FokMkSequent gamma delta) =
  λgoal.
    λdelta_to.
      λforced.
        fok_target_forces_transport
          sigma
          c
          rho
          levels
          bound
          (FokImp p q)
          goal
          (fok_eq_sym
            FokForm
            goal
            (FokImp p q)
            (fok_nth_singleton_some
              goal
              (FokImp p q)
              right
              (fok_eq_trans
                (Option FokForm)
                (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                (fok_nth_form delta right)
                (Some FokForm (FokImp p q))
                (fok_eq_sym
                  (Option FokForm)
                  (fok_nth_form delta right)
                  (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                  (fok_cong
                    (List FokForm)
                    (Option FokForm)
                    delta
                    (Cons FokForm goal (Nil FokForm))
                    (λxs. fok_nth_form xs right)
                    delta_to))
                h_d)))
          (λhp.
            child_sound
              q
              (fok_delta_set_to_singleton delta goal (FokImp p q) right q delta_to h_d)
              (fok_gamma_forced_append_one sigma c rho levels bound gamma p forced hp))

theorem fok_target_soundness_forall_world_case
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (body : FokForm)
      (h_d : Equal
        (Option FokForm)
        (fok_nth_form delta right)
        (Some FokForm (FokForallWorld body)))
      (h_fresh : Equal
        Bool
        (fok_sequent_mentions_parameter (FokMkSequent gamma delta) (FokQParameter eigen))
        False)
      (child_sound : fok_target_soundness_motive
        sigma
        c
        rho
        (fok_level_set (fok_sort_a sigma c) levels eigen (FokLevelWorld (fok_sort_a sigma c)))
        bound
        (FokMkSequent
          gamma
          (fok_list_form_set_nth delta right (fok_subst0_form body (FokQParameter eigen)))))
    : fok_target_soundness_motive sigma c rho levels bound (FokMkSequent gamma delta) =
  λgoal.
    λdelta_to.
      λforced.
        fok_target_forces_transport
          sigma
          c
          rho
          levels
          bound
          (FokForallWorld body)
          goal
          (fok_eq_sym
            FokForm
            goal
            (FokForallWorld body)
            (fok_nth_singleton_some
              goal
              (FokForallWorld body)
              right
              (fok_eq_trans
                (Option FokForm)
                (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                (fok_nth_form delta right)
                (Some FokForm (FokForallWorld body))
                (fok_eq_sym
                  (Option FokForm)
                  (fok_nth_form delta right)
                  (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                  (fok_cong
                    (List FokForm)
                    (Option FokForm)
                    delta
                    (Cons FokForm goal (Nil FokForm))
                    (λxs. fok_nth_form xs right)
                    delta_to))
                h_d)))
          (fok_target_subst0_forward
            sigma
            c
            rho
            levels
            bound
            eigen
            (FokLevelWorld (fok_sort_a sigma c))
            body
            (fok_gamma_selected_fresh
              delta
              eigen
              (fok_or_right_false
                (fok_list_form_any_mentions gamma (FokQParameter eigen))
                (fok_list_form_any_mentions delta (FokQParameter eigen))
                h_fresh)
              right
              (FokForallWorld body)
              h_d)
            (child_sound
              (fok_subst0_form body (FokQParameter eigen))
              (fok_delta_set_to_singleton
                delta
                goal
                (FokForallWorld body)
                right
                (fok_subst0_form body (FokQParameter eigen))
                delta_to
                h_d)
              (fok_gamma_forced_update_fresh
                sigma
                c
                rho
                levels
                bound
                gamma
                eigen
                (FokLevelWorld (fok_sort_a sigma c))
                (fok_or_left_false
                  (fok_list_form_any_mentions gamma (FokQParameter eigen))
                  (fok_list_form_any_mentions delta (FokQParameter eigen))
                  h_fresh)
                forced)))

theorem fok_target_soundness_forall_obj_case
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (delta : List FokForm)
      (right : Nat)
      (eigen : Nat)
      (body : FokForm)
      (h_d : Equal
        (Option FokForm)
        (fok_nth_form delta right)
        (Some FokForm (FokForallObj body)))
      (h_fresh : Equal
        Bool
        (fok_sequent_mentions_parameter (FokMkSequent gamma delta) (FokQParameter eigen))
        False)
      (child_sound : (x : fok_sort_a sigma c)
        → fok_target_soundness_motive
        sigma
        c
        rho
        (fok_level_set
          (fok_sort_a sigma c)
          levels
          eigen
          (FokLevelObject (fok_sort_a sigma c) x))
        bound
        (FokMkSequent
          gamma
          (fok_list_form_set_nth delta right (fok_subst0_form body (FokQParameter eigen)))))
    : fok_target_soundness_motive sigma c rho levels bound (FokMkSequent gamma delta) =
  λgoal.
    λdelta_to.
      λforced.
        fok_target_forces_transport
          sigma
          c
          rho
          levels
          bound
          (FokForallObj body)
          goal
          (fok_eq_sym
            FokForm
            goal
            (FokForallObj body)
            (fok_nth_singleton_some
              goal
              (FokForallObj body)
              right
              (fok_eq_trans
                (Option FokForm)
                (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                (fok_nth_form delta right)
                (Some FokForm (FokForallObj body))
                (fok_eq_sym
                  (Option FokForm)
                  (fok_nth_form delta right)
                  (fok_nth_form (Cons FokForm goal (Nil FokForm)) right)
                  (fok_cong
                    (List FokForm)
                    (Option FokForm)
                    delta
                    (Cons FokForm goal (Nil FokForm))
                    (λxs. fok_nth_form xs right)
                    delta_to))
                h_d)))
          (λx.
            fok_target_subst0_forward
              sigma
              c
              rho
              levels
              bound
              eigen
              (FokLevelObject (fok_sort_a sigma c) x)
              body
              (fok_gamma_selected_fresh
                delta
                eigen
                (fok_or_right_false
                  (fok_list_form_any_mentions gamma (FokQParameter eigen))
                  (fok_list_form_any_mentions delta (FokQParameter eigen))
                  h_fresh)
                right
                (FokForallObj body)
                h_d)
              (child_sound
                x
                (fok_subst0_form body (FokQParameter eigen))
                (fok_delta_set_to_singleton
                  delta
                  goal
                  (FokForallObj body)
                  right
                  (fok_subst0_form body (FokQParameter eigen))
                  delta_to
                  h_d)
                (fok_gamma_forced_update_fresh
                  sigma
                  c
                  rho
                  levels
                  bound
                  gamma
                  eigen
                  (FokLevelObject (fok_sort_a sigma c) x)
                  (fok_or_left_false
                    (fok_list_form_any_mentions gamma (FokQParameter eigen))
                    (fok_list_form_any_mentions delta (FokQParameter eigen))
                    h_fresh)
                  forced)))

-- The target slice is sound in the canonical level model. Each constructor arm
-- is a constructor-local helper, so only its result crosses the record-index
-- equality generated by dependent elimination.
theorem fok_target_soundness_at
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (sequent : FokSequent)
      (derivation : FokDerivation sequent)
    : fok_target_soundness_motive sigma c rho levels bound sequent =
  match derivation {
    FokDerivInit gamma delta left right g d h_g h_d h_eq ↦
      fok_target_soundness_init_case
        sigma
        c
        rho
        levels
        bound
        gamma
        delta
        left
        right
        g
        d
        h_g
        h_d
        h_eq;
    FokDerivImpRight gamma delta right p q h_d child ↦
      fok_target_soundness_imp_case
        sigma
        c
        rho
        levels
        bound
        gamma
        delta
        right
        p
        q
        h_d
        (fok_target_soundness_at
          sigma
          c
          rho
          levels
          bound
          (FokMkSequent
            (fok_list_form_append_one gamma p)
            (fok_list_form_set_nth delta right q))
          child);
    FokDerivForallWorldRight gamma delta right eigen body h_d h_fresh child ↦
      fok_target_soundness_forall_world_case
        sigma
        c
        rho
        levels
        bound
        gamma
        delta
        right
        eigen
        body
        h_d
        h_fresh
        (fok_target_soundness_at
          sigma
          c
          rho
          (fok_level_set (fok_sort_a sigma c) levels eigen (FokLevelWorld (fok_sort_a sigma c)))
          bound
          (FokMkSequent
            gamma
            (fok_list_form_set_nth delta right (fok_subst0_form body (FokQParameter eigen))))
          child);
    FokDerivForallObjRight gamma delta right eigen body h_d h_fresh child ↦
      fok_target_soundness_forall_obj_case
        sigma
        c
        rho
        levels
        bound
        gamma
        delta
        right
        eigen
        body
        h_d
        h_fresh
        (λx.
          fok_target_soundness_at
            sigma
            c
            rho
            (fok_level_set
              (fok_sort_a sigma c)
              levels
              eigen
              (FokLevelObject (fok_sort_a sigma c) x))
            bound
            (FokMkSequent
              gamma
              (fok_list_form_set_nth delta right (fok_subst0_form body (FokQParameter eigen))))
            child)
  }

theorem fok_target_soundness
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (gamma : List FokForm)
      (goal : FokForm)
      (derivation : FokDerivation (FokMkSequent gamma (Cons FokForm goal (Nil FokForm))))
    : fok_gamma_forced sigma c rho levels bound gamma
      → fok_target_forces sigma c rho levels bound goal =
  fok_target_soundness_at
    sigma
    c
    rho
    levels
    bound
    (FokMkSequent gamma (Cons FokForm goal (Nil FokForm)))
    derivation
    goal
    Refl

-- === D2b: embedding correspondence ===
fn fok_list_nat_length (xs : List Nat) : Nat =
  match xs {
    Nil ↦ Zero;
    Cons x rest ↦ Suc (fok_list_nat_length rest)
  }

theorem fok_nth_nat_default_map_suc_nil
    : (i : Nat)
      → Equal Bool (fok_nat_lt i (fok_list_nat_length (Nil Nat))) True
      → Equal Nat
        (fok_nth_nat_default (fok_map_suc (Nil Nat)) i)
        (Suc (fok_nth_nat_default (Nil Nat) i)) =
  λi.
    match i {
      Zero ↦ λin_range. absurd in_range;
      Suc j ↦ λin_range. absurd in_range
    }

theorem fok_nth_nat_default_map_suc_cons_zero
      (x : Nat) (rest : List Nat)
    : Equal Bool (fok_nat_lt Zero (fok_list_nat_length (Cons Nat x rest))) True
      → Equal Nat
        (fok_nth_nat_default (fok_map_suc (Cons Nat x rest)) Zero)
        (Suc (fok_nth_nat_default (Cons Nat x rest) Zero)) =
  λin_range. Refl

theorem fok_nth_nat_default_map_suc_cons_suc
      (x : Nat) (rest : List Nat) (j : Nat)
    : Equal Bool (fok_nat_lt (Suc j) (fok_list_nat_length (Cons Nat x rest))) True
      → Equal Nat
        (fok_nth_nat_default (fok_map_suc (Cons Nat x rest)) (Suc j))
        (Suc (fok_nth_nat_default (Cons Nat x rest) (Suc j))) =
  fok_nth_nat_default_map_suc rest j

theorem fok_nth_nat_default_map_suc_cons
      (x : Nat) (rest : List Nat)
    : (i : Nat)
      → Equal Bool (fok_nat_lt i (fok_list_nat_length (Cons Nat x rest))) True
      → Equal Nat
        (fok_nth_nat_default (fok_map_suc (Cons Nat x rest)) i)
        (Suc (fok_nth_nat_default (Cons Nat x rest) i)) =
  λi.
    match i {
      Zero ↦ fok_nth_nat_default_map_suc_cons_zero x rest;
      Suc j ↦ fok_nth_nat_default_map_suc_cons_suc x rest j
    }

theorem fok_nth_nat_default_map_suc
      (xs : List Nat)
    : (i : Nat)
      → Equal Bool (fok_nat_lt i (fok_list_nat_length xs)) True
      → Equal Nat (fok_nth_nat_default (fok_map_suc xs) i) (Suc (fok_nth_nat_default xs i)) =
  match xs {
    Nil ↦ fok_nth_nat_default_map_suc_nil;
    Cons x rest ↦ fok_nth_nat_default_map_suc_cons x rest
  }

theorem fok_map_suc_length
      (xs : List Nat)
    : Equal Nat (fok_list_nat_length (fok_map_suc xs)) (fok_list_nat_length xs) =
  match xs {
    Nil ↦ Proved;
    Cons x rest ↦
      fok_cong
        Nat
        Nat
        (fok_list_nat_length (fok_map_suc rest))
        (fok_list_nat_length rest)
        Suc
        (fok_map_suc_length rest)
  }

theorem fok_fin_to_nat_lt
      (n : Nat) (i : FokFin n)
    : Equal Bool (fok_nat_lt (fok_fin_to_nat n i) n) True =
  match i {
    FokFinZero m ↦ Proved;
    FokFinSuc m j ↦ fok_fin_to_nat_lt m j
  }

theorem fok_indices_fin_in_range
      (n : Nat)
      (indices : List Nat)
      (length_is_n : Equal Nat (fok_list_nat_length indices) n)
      (i : FokFin n)
    : Equal Bool (fok_nat_lt (fok_fin_to_nat n i) (fok_list_nat_length indices)) True =
  fok_eq_trans
    Bool
    (fok_nat_lt (fok_fin_to_nat n i) (fok_list_nat_length indices))
    (fok_nat_lt (fok_fin_to_nat n i) n)
    True
    (fok_cong
      Nat
      Bool
      (fok_list_nat_length indices)
      n
      (λsize. fok_nat_lt (fok_fin_to_nat n i) size)
      length_is_n)
    (fok_fin_to_nat_lt n i)

fn fok_iff_trans
      (p : Omega) (q : Omega) (r : Omega) (pq : FokForcingIff p q) (qr : FokForcingIff q r)
    : FokForcingIff p r =
  FokMkForcingIff
    p
    r
    (λhp. fok_iff_forward q r qr (fok_iff_forward p q pq hp))
    (λhr. fok_iff_backward p q pq (fok_iff_backward q r qr hr))

theorem fok_qobject_bound_push_index
      (a : Type)
      (levels : FokLevelContext a)
      (bound : FokBoundContext a)
      (slot : FokLevelSlot a)
      (from : Nat)
      (to : Nat)
      (same : Equal Nat from (Suc to))
    : Equal
        (Option a)
        (fok_qobject_value a levels (FokBoundCons a slot bound) (FokQBound from))
        (fok_qobject_value a levels bound (FokQBound to)) =
  fok_cong
    Nat
    (Option a)
    from
    (Suc to)
    (λindex. fok_qobject_value a levels (FokBoundCons a slot bound) (FokQBound index))
    same

fn fok_embedding_env_relation
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (indices : List Nat)
      (bound : FokBoundContext (fok_sort_a sigma c))
      (xs : FokObjectEnv sigma c n)
    : Omega =
  (i : FokFin n)
    → Equal
    (Option (fok_sort_a sigma c))
    (fok_qobject_value
      (fok_sort_a sigma c)
      levels
      bound
      (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat n i))))
    (Some (fok_sort_a sigma c) (fok_object_env_lookup sigma c n xs i))

theorem fok_fin_zero_elim (target : Omega) (i : FokFin Zero) : target = match i {}

theorem fok_embedding_env_root
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (levels : FokLevelContext (fok_sort_a sigma c))
    : fok_embedding_env_relation sigma c levels Zero
        (Nil Nat)
        (fok_bound_empty (fok_sort_a sigma c))
        (FokObjectEnvNil sigma c) =
  λi.
    fok_fin_zero_elim
      (Equal
        (Option (fok_sort_a sigma c))
        (fok_qobject_value
          (fok_sort_a sigma c)
          levels
          (fok_bound_empty (fok_sort_a sigma c))
          (FokQBound (fok_nth_nat_default (Nil Nat) (fok_fin_to_nat Zero i))))
        (Some
          (fok_sort_a sigma c)
          (fok_object_env_lookup sigma c Zero (FokObjectEnvNil sigma c) i)))
      i

theorem fok_embedding_env_world
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (indices : List Nat)
      (length_is_n : Equal Nat (fok_list_nat_length indices) n)
      (bound : FokBoundContext (fok_sort_a sigma c))
      (xs : FokObjectEnv sigma c n)
      (relation : fok_embedding_env_relation sigma c levels n indices bound xs)
    : fok_embedding_env_relation sigma c levels n
        (fok_map_suc indices)
        (FokBoundCons (fok_sort_a sigma c) (FokLevelWorld (fok_sort_a sigma c)) bound)
        xs =
  λi.
    fok_eq_trans
      (Option (fok_sort_a sigma c))
      (fok_qobject_value
        (fok_sort_a sigma c)
        levels
        (FokBoundCons (fok_sort_a sigma c) (FokLevelWorld (fok_sort_a sigma c)) bound)
        (FokQBound (fok_nth_nat_default (fok_map_suc indices) (fok_fin_to_nat n i))))
      (fok_qobject_value
        (fok_sort_a sigma c)
        levels
        bound
        (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat n i))))
      (Some (fok_sort_a sigma c) (fok_object_env_lookup sigma c n xs i))
      (fok_qobject_bound_push_index
        (fok_sort_a sigma c)
        levels
        bound
        (FokLevelWorld (fok_sort_a sigma c))
        (fok_nth_nat_default (fok_map_suc indices) (fok_fin_to_nat n i))
        (fok_nth_nat_default indices (fok_fin_to_nat n i))
        (fok_nth_nat_default_map_suc
          indices
          (fok_fin_to_nat n i)
          (fok_indices_fin_in_range n indices length_is_n i)))
      (relation i)

theorem fok_embedding_env_object_index
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (indices : List Nat)
      (length_is_n : Equal Nat (fok_list_nat_length indices) n)
      (bound : FokBoundContext (fok_sort_a sigma c))
      (x : fok_sort_a sigma c)
      (i : FokFin (Suc n))
    : (xs : FokObjectEnv sigma c n)
      → fok_embedding_env_relation sigma c levels n indices bound xs
      → Equal
        (Option (fok_sort_a sigma c))
        (fok_qobject_value
          (fok_sort_a sigma c)
          levels
          (FokBoundCons (fok_sort_a sigma c) (FokLevelObject (fok_sort_a sigma c) x) bound)
          (FokQBound
            (fok_nth_nat_default
              (Cons Nat Zero (fok_map_suc indices))
              (fok_fin_to_nat (Suc n) i))))
        (Some
          (fok_sort_a sigma c)
          (fok_object_env_lookup sigma c (Suc n) (FokObjectEnvCons sigma c n x xs) i)) =
  match i {
    FokFinZero m ↦ λxs. λrelation. Refl;
    FokFinSuc m j ↦
      λxs.
        λrelation.
          fok_eq_trans
            (Option (fok_sort_a sigma c))
            (fok_qobject_value
              (fok_sort_a sigma c)
              levels
              (FokBoundCons (fok_sort_a sigma c) (FokLevelObject (fok_sort_a sigma c) x) bound)
              (FokQBound (fok_nth_nat_default (fok_map_suc indices) (fok_fin_to_nat m j))))
            (fok_qobject_value
              (fok_sort_a sigma c)
              levels
              bound
              (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat m j))))
            (Some (fok_sort_a sigma c) (fok_object_env_lookup sigma c m xs j))
            (fok_qobject_bound_push_index
              (fok_sort_a sigma c)
              levels
              bound
              (FokLevelObject (fok_sort_a sigma c) x)
              (fok_nth_nat_default (fok_map_suc indices) (fok_fin_to_nat m j))
              (fok_nth_nat_default indices (fok_fin_to_nat m j))
              (fok_nth_nat_default_map_suc
                indices
                (fok_fin_to_nat m j)
                (fok_indices_fin_in_range m indices length_is_n j)))
            (relation j)
  }

theorem fok_embedding_env_object
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (indices : List Nat)
      (length_is_n : Equal Nat (fok_list_nat_length indices) n)
      (bound : FokBoundContext (fok_sort_a sigma c))
      (xs : FokObjectEnv sigma c n)
      (x : fok_sort_a sigma c)
      (relation : fok_embedding_env_relation sigma c levels n indices bound xs)
    : fok_embedding_env_relation sigma c levels
        (Suc n)
        (Cons Nat Zero (fok_map_suc indices))
        (FokBoundCons (fok_sort_a sigma c) (FokLevelObject (fok_sort_a sigma c) x) bound)
        (FokObjectEnvCons sigma c n x xs) =
  λi. fok_embedding_env_object_index sigma c levels n indices length_is_n bound x i xs relation

-- The five embedded frame axioms hold in the canonical one-world model.
theorem fok_target_conjoin
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
      (p : FokForm)
      (q : FokForm)
      (hp : fok_target_forces sigma c rho levels bound p)
      (hq : fok_target_forces sigma c rho levels bound q)
    : fok_target_forces sigma c rho levels bound (FokAnd p q) =
  trunc_intro
    (FokConjoin
      (fok_target_forces sigma c rho levels bound p)
      (fok_target_forces sigma c rho levels bound q)
      hp
      hq)

theorem fok_target_preorder_reflexive
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_target_forces sigma c rho levels bound fok_preorder_reflexive =
  Proved

theorem fok_target_preorder_transitive
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_target_forces sigma c rho levels bound fok_preorder_transitive =
  λh. Proved

theorem fok_target_domain_growth_a
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_target_forces sigma c rho levels bound fok_domain_growth_a =
  λx. λh. Proved

theorem fok_target_atom_domain_p
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_target_forces sigma c rho levels bound fok_atom_domain_p =
  λx. λh. Proved

theorem fok_target_atom_persistence_p
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_target_forces sigma c rho levels bound fok_atom_persistence_p =
  λx.
    λh.
      elim_trunc
        (fok_pred_p sigma c rho x)
        (λpair.
          match pair {
            FokConjoin access atom ↦ atom
          })
        h

theorem fok_target_k_sigma
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_target_forces sigma c rho levels bound fok_k_sigma =
  fok_target_conjoin
    sigma
    c
    rho
    levels
    bound
    (FokAnd (FokAnd fok_preorder_reflexive fok_preorder_transitive) fok_domain_growth_a)
    (FokAnd fok_atom_domain_p fok_atom_persistence_p)
    (fok_target_conjoin
      sigma
      c
      rho
      levels
      bound
      (FokAnd fok_preorder_reflexive fok_preorder_transitive)
      fok_domain_growth_a
      (fok_target_conjoin
        sigma
        c
        rho
        levels
        bound
        fok_preorder_reflexive
        fok_preorder_transitive
        (fok_target_preorder_reflexive sigma c rho levels bound)
        (fok_target_preorder_transitive sigma c rho levels bound))
      (fok_target_domain_growth_a sigma c rho levels bound))
    (fok_target_conjoin
      sigma
      c
      rho
      levels
      bound
      fok_atom_domain_p
      fok_atom_persistence_p
      (fok_target_atom_domain_p sigma c rho levels bound)
      (fok_target_atom_persistence_p sigma c rho levels bound))

-- The source object environment and the target bound-variable projection stay
-- synchronized while the forcing translation introduces world/object binders.
theorem fok_map_suc_length_to
      (indices : List Nat) (n : Nat) (length_is_n : Equal Nat (fok_list_nat_length indices) n)
    : Equal Nat (fok_list_nat_length (fok_map_suc indices)) n =
  fok_eq_trans
    Nat
    (fok_list_nat_length (fok_map_suc indices))
    (fok_list_nat_length indices)
    n
    (fok_map_suc_length indices)
    length_is_n

theorem fok_object_indices_length_to
      (indices : List Nat) (n : Nat) (length_is_n : Equal Nat (fok_list_nat_length indices) n)
    : Equal Nat
        (fok_list_nat_length (Cons Nat Zero (fok_map_suc (fok_map_suc indices))))
        (Suc n) =
  fok_cong
    Nat
    Nat
    (fok_list_nat_length (fok_map_suc (fok_map_suc indices)))
    n
    Suc
    (fok_map_suc_length_to
      (fok_map_suc indices)
      n
      (fok_map_suc_length_to indices n length_is_n))

-- Directional correspondence stays proposition-valued during structural
-- recursion. The proof-relevant equivalence record is assembled afterward.
theorem fok_embedding_formula_forward
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (form : FokScopedIForm sigma n)
    : (world : Nat)
      → (indices : List Nat)
      → Equal Nat (fok_list_nat_length indices) n
      → (bound : FokBoundContext (fok_sort_a sigma c))
      → (xs : FokObjectEnv sigma c n)
      → fok_embedding_env_relation sigma c levels n indices bound xs
      → fok_target_forces sigma c rho levels bound
        (fok_w_forces world indices (fok_erase_n sigma n form))
      → fok_denote_at sigma c rho n form xs =
  match form {
    FokScopedBottom m ↦ λworld. λindices. λlength_is_n. λbound. λxs. λrelation. λh. h;
    FokScopedAtom m i ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  fok_iff_forward
                    (fok_atom_truth
                      sigma
                      c
                      rho
                      (fok_qobject_value
                        (fok_sort_a sigma c)
                        levels
                        bound
                        (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat n i)))))
                    (fok_pred_p sigma c rho (fok_object_env_lookup sigma c n xs i))
                    (fok_option_atom_iff
                      sigma
                      c
                      rho
                      (fok_qobject_value
                        (fok_sort_a sigma c)
                        levels
                        bound
                        (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat n i))))
                      (Some (fok_sort_a sigma c) (fok_object_env_lookup sigma c n xs i))
                      (relation i));
    FokScopedOr m p q ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  λh.
                    elim_trunc
                      (fok_denote_at sigma c rho n (FokScopedOr sigma n p q) xs)
                      (λchoice.
                        match choice {
                          Inl hp ↦
                            trunc_intro
                              (Inl
                                (fok_denote_at sigma c rho n p xs)
                                (fok_denote_at sigma c rho n q xs)
                                (fok_embedding_formula_forward
                                  sigma
                                  c
                                  rho
                                  levels
                                  n
                                  p
                                  world
                                  indices
                                  length_is_n
                                  bound
                                  xs
                                  relation
                                  hp));
                          Inr hq ↦
                            trunc_intro
                              (Inr
                                (fok_denote_at sigma c rho n p xs)
                                (fok_denote_at sigma c rho n q xs)
                                (fok_embedding_formula_forward
                                  sigma
                                  c
                                  rho
                                  levels
                                  n
                                  q
                                  world
                                  indices
                                  length_is_n
                                  bound
                                  xs
                                  relation
                                  hq))
                        })
                      h;
    FokScopedImp m p q ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  λtarget_imp.
                    λsource_assumption.
                      fok_embedding_formula_forward
                        sigma
                        c
                        rho
                        levels
                        n
                        q
                        Zero
                        (fok_map_suc indices)
                        (fok_map_suc_length_to indices n length_is_n)
                        (FokBoundCons
                          (fok_sort_a sigma c)
                          (FokLevelWorld (fok_sort_a sigma c))
                          bound)
                        xs
                        (fok_embedding_env_world
                          sigma
                          c
                          levels
                          n
                          indices
                          length_is_n
                          bound
                          xs
                          relation)
                        (target_imp
                          Proved
                          (fok_embedding_formula_backward
                            sigma
                            c
                            rho
                            levels
                            n
                            p
                            Zero
                            (fok_map_suc indices)
                            (fok_map_suc_length_to indices n length_is_n)
                            (FokBoundCons
                              (fok_sort_a sigma c)
                              (FokLevelWorld (fok_sort_a sigma c))
                              bound)
                            xs
                            (fok_embedding_env_world
                              sigma
                              c
                              levels
                              n
                              indices
                              length_is_n
                              bound
                              xs
                              relation)
                            source_assumption));
    FokScopedForall m body ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  λtarget_all.
                    λx.
                      fok_embedding_formula_forward
                        sigma
                        c
                        rho
                        levels
                        (Suc n)
                        body
                        (Suc Zero)
                        (Cons Nat Zero (fok_map_suc (fok_map_suc indices)))
                        (fok_object_indices_length_to indices n length_is_n)
                        (FokBoundCons
                          (fok_sort_a sigma c)
                          (FokLevelObject (fok_sort_a sigma c) x)
                          (FokBoundCons
                            (fok_sort_a sigma c)
                            (FokLevelWorld (fok_sort_a sigma c))
                            bound))
                        (FokObjectEnvCons sigma c n x xs)
                        (fok_embedding_env_object
                          sigma
                          c
                          levels
                          n
                          (fok_map_suc indices)
                          (fok_map_suc_length_to indices n length_is_n)
                          (FokBoundCons
                            (fok_sort_a sigma c)
                            (FokLevelWorld (fok_sort_a sigma c))
                            bound)
                          xs
                          x
                          (fok_embedding_env_world
                            sigma
                            c
                            levels
                            n
                            indices
                            length_is_n
                            bound
                            xs
                            relation))
                        (target_all Proved x Proved)
  }

theorem fok_embedding_formula_backward
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (form : FokScopedIForm sigma n)
    : (world : Nat)
      → (indices : List Nat)
      → Equal Nat (fok_list_nat_length indices) n
      → (bound : FokBoundContext (fok_sort_a sigma c))
      → (xs : FokObjectEnv sigma c n)
      → fok_embedding_env_relation sigma c levels n indices bound xs
      → fok_denote_at sigma c rho n form xs
      → fok_target_forces sigma c rho levels bound
        (fok_w_forces world indices (fok_erase_n sigma n form)) =
  match form {
    FokScopedBottom m ↦ λworld. λindices. λlength_is_n. λbound. λxs. λrelation. λh. h;
    FokScopedAtom m i ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  fok_iff_backward
                    (fok_atom_truth
                      sigma
                      c
                      rho
                      (fok_qobject_value
                        (fok_sort_a sigma c)
                        levels
                        bound
                        (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat n i)))))
                    (fok_pred_p sigma c rho (fok_object_env_lookup sigma c n xs i))
                    (fok_option_atom_iff
                      sigma
                      c
                      rho
                      (fok_qobject_value
                        (fok_sort_a sigma c)
                        levels
                        bound
                        (FokQBound (fok_nth_nat_default indices (fok_fin_to_nat n i))))
                      (Some (fok_sort_a sigma c) (fok_object_env_lookup sigma c n xs i))
                      (relation i));
    FokScopedOr m p q ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  λh.
                    elim_trunc
                      (fok_target_forces
                        sigma
                        c
                        rho
                        levels
                        bound
                        (fok_w_forces
                          world
                          indices
                          (fok_erase_n sigma n (FokScopedOr sigma n p q))))
                      (λchoice.
                        match choice {
                          Inl hp ↦
                            trunc_intro
                              (Inl
                                (fok_target_forces
                                  sigma
                                  c
                                  rho
                                  levels
                                  bound
                                  (fok_w_forces world indices (fok_erase_n sigma n p)))
                                (fok_target_forces
                                  sigma
                                  c
                                  rho
                                  levels
                                  bound
                                  (fok_w_forces world indices (fok_erase_n sigma n q)))
                                (fok_embedding_formula_backward
                                  sigma
                                  c
                                  rho
                                  levels
                                  n
                                  p
                                  world
                                  indices
                                  length_is_n
                                  bound
                                  xs
                                  relation
                                  hp));
                          Inr hq ↦
                            trunc_intro
                              (Inr
                                (fok_target_forces
                                  sigma
                                  c
                                  rho
                                  levels
                                  bound
                                  (fok_w_forces world indices (fok_erase_n sigma n p)))
                                (fok_target_forces
                                  sigma
                                  c
                                  rho
                                  levels
                                  bound
                                  (fok_w_forces world indices (fok_erase_n sigma n q)))
                                (fok_embedding_formula_backward
                                  sigma
                                  c
                                  rho
                                  levels
                                  n
                                  q
                                  world
                                  indices
                                  length_is_n
                                  bound
                                  xs
                                  relation
                                  hq))
                        })
                      h;
    FokScopedImp m p q ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  λsource_imp.
                    λaccess.
                      λtarget_assumption.
                        fok_embedding_formula_backward
                          sigma
                          c
                          rho
                          levels
                          n
                          q
                          Zero
                          (fok_map_suc indices)
                          (fok_map_suc_length_to indices n length_is_n)
                          (FokBoundCons
                            (fok_sort_a sigma c)
                            (FokLevelWorld (fok_sort_a sigma c))
                            bound)
                          xs
                          (fok_embedding_env_world
                            sigma
                            c
                            levels
                            n
                            indices
                            length_is_n
                            bound
                            xs
                            relation)
                          (source_imp
                            (fok_embedding_formula_forward
                              sigma
                              c
                              rho
                              levels
                              n
                              p
                              Zero
                              (fok_map_suc indices)
                              (fok_map_suc_length_to indices n length_is_n)
                              (FokBoundCons
                                (fok_sort_a sigma c)
                                (FokLevelWorld (fok_sort_a sigma c))
                                bound)
                              xs
                              (fok_embedding_env_world
                                sigma
                                c
                                levels
                                n
                                indices
                                length_is_n
                                bound
                                xs
                                relation)
                              target_assumption));
    FokScopedForall m body ↦
      λworld.
        λindices.
          λlength_is_n.
            λbound.
              λxs.
                λrelation.
                  λsource_all.
                    λaccess.
                      λx.
                        λdomain.
                          fok_embedding_formula_backward
                            sigma
                            c
                            rho
                            levels
                            (Suc n)
                            body
                            (Suc Zero)
                            (Cons Nat Zero (fok_map_suc (fok_map_suc indices)))
                            (fok_object_indices_length_to indices n length_is_n)
                            (FokBoundCons
                              (fok_sort_a sigma c)
                              (FokLevelObject (fok_sort_a sigma c) x)
                              (FokBoundCons
                                (fok_sort_a sigma c)
                                (FokLevelWorld (fok_sort_a sigma c))
                                bound))
                            (FokObjectEnvCons sigma c n x xs)
                            (fok_embedding_env_object
                              sigma
                              c
                              levels
                              n
                              (fok_map_suc indices)
                              (fok_map_suc_length_to indices n length_is_n)
                              (FokBoundCons
                                (fok_sort_a sigma c)
                                (FokLevelWorld (fok_sort_a sigma c))
                                bound)
                              xs
                              x
                              (fok_embedding_env_world
                                sigma
                                c
                                levels
                                n
                                indices
                                length_is_n
                                bound
                                xs
                                relation))
                            (source_all x)
  }

fn fok_embedding_formula_iff
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (n : Nat)
      (form : FokScopedIForm sigma n)
      (world : Nat)
      (indices : List Nat)
      (length_is_n : Equal Nat (fok_list_nat_length indices) n)
      (bound : FokBoundContext (fok_sort_a sigma c))
      (xs : FokObjectEnv sigma c n)
      (relation : fok_embedding_env_relation sigma c levels n indices bound xs)
    : FokForcingIff
        (fok_target_forces
          sigma
          c
          rho
          levels
          bound
          (fok_w_forces world indices (fok_erase_n sigma n form)))
        (fok_denote_at sigma c rho n form xs) =
  FokMkForcingIff
    (fok_target_forces
      sigma
      c
      rho
      levels
      bound
      (fok_w_forces world indices (fok_erase_n sigma n form)))
    (fok_denote_at sigma c rho n form xs)
    (fok_embedding_formula_forward
      sigma
      c
      rho
      levels
      n
      form
      world
      indices
      length_is_n
      bound
      xs
      relation)
    (fok_embedding_formula_backward
      sigma
      c
      rho
      levels
      n
      form
      world
      indices
      length_is_n
      bound
      xs
      relation)

-- At source depth zero the environment correspondence is vacuous for every
-- target bound context, including the world binder introduced by `fok_embed`.
theorem fok_embedding_env_closed
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (levels : FokLevelContext (fok_sort_a sigma c))
      (bound : FokBoundContext (fok_sort_a sigma c))
    : fok_embedding_env_relation sigma c levels Zero (Nil Nat) bound (FokObjectEnvNil sigma c) =
  λi.
    fok_fin_zero_elim
      (Equal
        (Option (fok_sort_a sigma c))
        (fok_qobject_value
          (fok_sort_a sigma c)
          levels
          bound
          (FokQBound (fok_nth_nat_default (Nil Nat) (fok_fin_to_nat Zero i))))
        (Some
          (fok_sort_a sigma c)
          (fok_object_env_lookup sigma c Zero (FokObjectEnvNil sigma c) i)))
      i

-- Every inhabitant of classical validity is consumed. Target-calculus
-- soundness first interprets the embedded sequent in the canonical model;
-- validity of the five frame axioms exposes the translated formula, and the
-- structural correspondence sends it to the intrinsic source denotation.
theorem fok_embedding_adequacy
      (sigma : FokSignature)
      (c : FokCarriers sigma)
      (rho : FokAtomEnv sigma c)
      (f : FokScopedIForm sigma Zero)
    : fok_embedding_adequacy_statement sigma c rho f =
  λvalid.
    elim_trunc
      (fok_denote sigma c rho f)
      (λderivation.
        fok_embedding_formula_forward
          sigma
          c
          rho
          (fok_level_empty (fok_sort_a sigma c))
          Zero
          f
          Zero
          (Nil Nat)
          Proved
          (FokBoundCons
            (fok_sort_a sigma c)
            (FokLevelWorld (fok_sort_a sigma c))
            (fok_bound_empty (fok_sort_a sigma c)))
          (FokObjectEnvNil sigma c)
          (fok_embedding_env_closed
            sigma
            c
            (fok_level_empty (fok_sort_a sigma c))
            (FokBoundCons
              (fok_sort_a sigma c)
              (FokLevelWorld (fok_sort_a sigma c))
              (fok_bound_empty (fok_sort_a sigma c))))
          (fok_target_soundness
            sigma
            c
            rho
            (fok_level_empty (fok_sort_a sigma c))
            (fok_bound_empty (fok_sort_a sigma c))
            (Nil FokForm)
            (fok_scoped_embed sigma f)
            derivation
            (fok_gamma_forced_empty
              sigma
              c
              rho
              (fok_level_empty (fok_sort_a sigma c))
              (fok_bound_empty (fok_sort_a sigma c)))
            (fok_target_k_sigma
              sigma
              c
              rho
              (fok_level_empty (fok_sort_a sigma c))
              (fok_bound_empty (fok_sort_a sigma c)))))
      valid
