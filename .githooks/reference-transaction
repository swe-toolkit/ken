#!/bin/sh
# Refuse any update or deletion of a held ref.
#
# Held refs carry parked work that the operator has ordered kept exactly where
# it is (COORDINATION §12a). A branch -f, reset, rebase, push into, or delete
# of one of them aborts here. Creating a held ref that does not exist is
# allowed. An owner the operator has authorized to move one sets
# KEN_HELD_REF_OVERRIDE to that full ref name for that one command.

[ "$1" = "prepared" ] || exit 0

HELD="refs/heads/wp/RT-BRACKET-PRODUCER-AUTHENTICITY
refs/heads/wp/KERNEL-NORMALIZE-ORIGIN-TRACE
refs/heads/wp/RT-BRACKET-SETTLEMENT-PLANE"

ZERO=0000000000000000000000000000000000000000
packed="$(git rev-parse --git-common-dir)/packed-refs"

status=0
while read -r old new ref; do
    printf '%s\n' "$HELD" | grep -qxF "$ref" || continue
    [ "${KEN_HELD_REF_OVERRIDE:-}" = "$ref" ] && continue
    current=$(git rev-parse -q --verify "$ref" 2>/dev/null) || continue
    [ "$new" = "$current" ] && continue
    # pack-refs deletes the loose file after packing the same value: the ref
    # does not move. A real delete also clears the packed entry, refused here.
    if [ "$new" = "$ZERO" ] && [ "$old" != "$ZERO" ] &&
        grep -qxF "$old $ref" "$packed" 2>/dev/null; then
        continue
    fi
    echo "Refused by .githooks/reference-transaction: $ref is a held ref" \
        "(at $current) and must not be moved or deleted (COORDINATION §12a)." >&2
    status=1
done
exit $status
