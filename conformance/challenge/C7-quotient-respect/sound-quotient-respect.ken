-- C7 intended sound arm; this is not a valid post-P0 quotient input.
-- It omits `e : IsEquiv DPair denoteEq`; see the C7 README.
--
-- The K2 kernel form is `A / R / e` with `Term::Quot`/`QuotElim`;
-- the frontend has no quotient production and `/` is integer division.
-- Decimal-as-quotient is the intended fix to C1's non-canonical carrier.

data DPair = MkDPair Int Int

-- denoteEq: two pairs denote the same value. Ω-valued (a proposition), the
-- relation we quotient by. (Witness-exact form as in C1's decimalEq; the full
-- relation is the landed decimal value-equality.)
fn denoteEq (x : DPair) (y : DPair) : Prop =
  match x { MkDPair cx ex ↦
    match y { MkDPair cy ey ↦
      Equal Bool (and_bool (eq_int (add_int ex 1) ey) (eq_int cx (mul_int cy 10))) True } }

-- Intended quotient carrier; this file omits the required `e` and does not
-- form a quotient under the post-P0 rule.
const Decimal : Type = DPair / denoteEq

-- Intended law: isZeroPair respects denotational equality. This sketch has
-- no checked proof and is not a current C7 conformance result.
fn isZeroPair (p : DPair) : Bool =
  match p { MkDPair c e ↦ eq_int c 0 }

-- Intended respect obligation: (x y : DPair) -> denoteEq x y ->
--   Equal Bool (isZeroPair x) (isZeroPair y). The Axiom below is a placeholder,
-- not a discharged proof or a trust-free pass.
fn isZeroRespect (x : DPair) (y : DPair) (h : denoteEq x y)
  : Equal Bool (isZeroPair x) (isZeroPair y) = Axiom

-- Lift to the quotient: elim_/ motive method respect scrut.
fn isZeroDecimal (d : Decimal) : Bool =
  elim_/ (λ _ . Bool) isZeroPair isZeroRespect d

-- Current status: no C7 respect verdict. As written, the missing e prevents
-- quotient formation; the Axiom placeholder does not establish respect.
-- Repair the relation and supply checked e before treating this as a test.
