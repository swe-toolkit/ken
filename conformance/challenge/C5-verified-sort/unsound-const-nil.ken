-- C5 UNSOUND/STUB arm — `const Nil` claiming the verified-sort subset-Σ.
-- Derived's count-equality Perm must remain open and never be proved for a
-- nonempty input; Pair output is deferred until W5.
import Core.Logic.Conjunction (And)

import Data.Collections.Derived (Perm, is_sorted, eq_from_ord)

-- `sortBad` discards its input and returns Nil, but claims the SAME W1
-- subset-Σ result type as the real sort. Its checked Pair is the W5 target.
-- `is_sorted a leq (Nil a)` holds vacuously (the empty list is sorted), so an
-- is_sorted-only obligation would pass. `Perm a (eq_from_ord a leq) (Nil a) xs`
-- is false for nonempty xs; that is the load-bearing conjunct.
fn sortBad
      (a : Type) (leq : a → a → Bool) (xs : List a)
    : {ys : List a | And (is_sorted a leq ys) (Perm a (eq_from_ord a leq) ys xs)} =
  Nil a
